{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elastomeri-italia-frontend",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "assets": {
    "html_handling": "drop-trailing-slash"
  },
  "services": [
    {
      "binding": "API",
      "service": "elastomeri-italia-api"
    }
  ],
  "routes": [
    {
      "pattern": "poliureasystem.it",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
