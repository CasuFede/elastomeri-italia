---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
---

<SiteLayout
    title="Soluzioni per Amministratori, Imprese e Progettisti | Poliurea System"
    description="Impermeabilizzazioni continue per condomìni, tetti industriali e grandi superfici. Diagnosi preliminare, computi metrici e relazioni per delibere assembleari."
    activePath="/imprese"
>
    <PageIntro
        eyebrow="B2B & CONDOMÌNI"
        title="Documentazione certa,"
        highlight="zero contenziosi."
        text="Per amministratori di condominio, imprese e progettisti la conformità e la certezza dei tempi contano quanto il risultato finale. Offriamo rilievi strumentali, computi estimativi trasparenti e pose certificate senza demolizioni né fermi cantiere."
    />

    <!-- PROTOCOLLO OPERATIVO B2B & DOSSIER TECNICO -->
    <section class="business-intro wrap my-12 grid gap-8 lg:grid-cols-2 items-center">
        <!-- Colonna Sinistra: Statement B2B & Pillar Operativi -->
        <div class="business-statement rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:p-10 shadow-2xl relative overflow-hidden transition-colors duration-300 hover:border-zinc-700">
            <p class="eyebrow inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-sky-400 mb-4">PROTOCOLLO OPERATIVO B2B</p>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">Dal rilievo diagnostico<br />al <span class="text-sky-400">fascicolo per l’assemblea.</span></h2>
            <p class="text-zinc-300 text-sm sm:text-base leading-relaxed mb-6">Per chi gestisce immobili o firma progetti, la precisione documentale è fondamentale. Non ci limitiamo a un preventivo generico: forniamo diagnosi termo-igrometrica del supporto, stratigrafia esecutiva e schede prestazionali a norma per delibere assembleari e computi metrici estimativi.</p>
            
            <div class="space-y-3 pt-4 border-t border-zinc-800/80">
                <div class="flex items-center gap-3 text-xs sm:text-sm text-zinc-300 font-medium">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-400 text-xs font-bold">✓</span>
                    <span>Relazione tecnica e fascicolo fotografico preliminare entro 48h</span>
                </div>
                <div class="flex items-center gap-3 text-xs sm:text-sm text-zinc-300 font-medium">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-400 text-xs font-bold">✓</span>
                    <span>Capitolato prestazionale certificato ETAG 005 - W3 (durata 25 anni)</span>
                </div>
                <div class="flex items-center gap-3 text-xs sm:text-sm text-zinc-300 font-medium">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-400 text-xs font-bold">✓</span>
                    <span>Posa continua a caldo senza fiamme libere: zero costi e macerie di demolizione</span>
                </div>
            </div>
        </div>

        <!-- Colonna Destra: Micro-Dashboard Documentale / Technical Dossier Preview -->
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5 sm:p-7 shadow-2xl relative overflow-hidden flex flex-col gap-4">
            <!-- Glow d'atmosfera azzurro -->
            <div class="absolute -right-10 -top-10 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top bar stile software tecnico / finestra documento -->
            <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
                <div class="flex items-center gap-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                    <span class="ml-2 font-mono text-[11px] text-zinc-400 font-semibold tracking-wider">DOSSIER_TECNICO_2026.PDF</span>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> CONFORME
                </span>
            </div>

            <!-- Box 1: Diagnosi Strumentale del Supporto -->
            <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/80 p-3.5 sm:p-4 text-left">
                <div class="flex items-center justify-between mb-2">
                    <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">01 / Diagnosi Igrometrica Supporto</span>
                    <span class="font-mono text-xs font-bold text-sky-400">14% Umidità</span>
                </div>
                <div class="w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden mb-2">
                    <div class="bg-sky-400 h-full rounded-full w-[28%]"></div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-zinc-400">
                    <span>Soglia massima ammissibile: 20%</span>
                    <strong class="text-emerald-400 font-mono text-[10px]">✓ IDONEO A CICLO CALDO</strong>
                </div>
            </div>

            <!-- Box 2: Vantaggio Operativo di Cantiere -->
            <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/80 p-3.5 sm:p-4 text-left">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">02 / Strategia di Cantiere</span>
                    <span class="font-mono text-xs font-bold text-white">Poliurea Pura 2.2 mm</span>
                </div>
                <div class="flex flex-wrap items-center gap-2 mt-2">
                    <span class="rounded-md border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 font-mono text-[11px] font-bold text-emerald-400">
                        Demolizione pavimento: ZERO
                    </span>
                    <span class="rounded-md border border-sky-500/30 bg-sky-500/10 px-2.5 py-1 font-mono text-[11px] font-bold text-sky-400">
                        Risparmio: ~45 €/m²
                    </span>
                </div>
            </div>

            <!-- Box 3: Allegati Pronti per Delibera Assembleare -->
            <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-3.5 sm:p-4 flex items-center justify-between gap-3 text-left">
                <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-500/20 text-sky-400 font-mono text-xs font-bold">
                        PDF
                    </div>
                    <div>
                        <strong class="block text-xs font-bold text-white">Relazione per Assemblea Condominiale</strong>
                        <span class="block text-[11px] text-zinc-400">Computo metrico estimativo & Cronoprogramma</span>
                    </div>
                </div>
                <span class="font-mono text-xs font-bold text-sky-400 shrink-0">Pronto ↗</span>
            </div>
        </div>
    </section>

    <!-- AUDIENCE TARGET CARDS -->
    <section class="business-audience py-16 bg-zinc-950 border-y border-zinc-800">
        <div class="wrap">
            <div class="section-heading mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <p class="eyebrow text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">A CHI CI RIVOLGIAMO</p>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight">Collaboriamo con<br /><span class="text-sky-400">chi si prende cura degli edifici.</span></h2>
                </div>
                <p class="text-zinc-300 text-sm sm:text-base max-w-xl">Ogni interlocutore ha priorità specifiche: forniamo risposte mirate per azzerare contenziosi, velocizzare i cantieri e garantire la massima conformità tecnica.</p>
            </div>
            <div class="audience-cards grid gap-6 md:grid-cols-3">
                <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/40 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1 transition-all duration-300">
                    <span class="text-xs font-mono font-bold text-sky-400 border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 rounded-md inline-block mb-4">01</span>
                    <h3 class="text-lg font-bold text-white mb-2">Amministratori di condominio</h3>
                    <p class="text-sm text-zinc-300 leading-relaxed">Documentazione chiara per delibere assembleari approvate senza contestazioni: fascicolo fotografico dell'infiltrazione, diagnosi igrometrica e computo trasparente a costi bloccati.</p>
                </article>
                <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/40 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1 transition-all duration-300">
                    <span class="text-xs font-mono font-bold text-sky-400 border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 rounded-md inline-block mb-4">02</span>
                    <h3 class="text-lg font-bold text-white mb-2">Imprese e property manager</h3>
                    <p class="text-sm text-zinc-300 leading-relaxed">Azzeramento fermi cantiere: polimerizzazione in pochi secondi, calpestabilità immediata in 60 minuti e capacità applicativa fino a 1.000 m² al giorno senza intralciare le attività.</p>
                </article>
                <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/40 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1 transition-all duration-300">
                    <span class="text-xs font-mono font-bold text-sky-400 border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 rounded-md inline-block mb-4">03</span>
                    <h3 class="text-lg font-bold text-white mb-2">Tecnici e progettisti</h3>
                    <p class="text-sm text-zinc-300 leading-relaxed">Supporto qualificato per la stesura del capitolato speciale d'appalto: schede prestazionali ETAG 005 - W3, dettagli esecutivi di raccordo CAD e collaudo idraulico documentato.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- CHECKLIST: COME PREPARARE IL PRIMO CONFRONTO -->
    <section class="business-checklist wrap my-16 rounded-3xl border border-zinc-800 bg-zinc-900 p-8 sm:p-12 shadow-2xl transition-colors duration-300 hover:border-zinc-700">
        <p class="eyebrow text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">COME PREPARARE IL PRIMO CONFRONTO</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight mb-8">Le informazioni utili<br /><span class="text-sky-400">per iniziare subito bene.</span></h2>
        <div class="checklist-grid grid gap-4 sm:grid-cols-2">
            <p class="flex items-center gap-3 rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-4 text-sm font-medium text-zinc-300 shadow-inner transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900/90"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-bold shrink-0">✓</span> Indirizzo, tipologia e destinazione d'uso dell’immobile</p>
            <p class="flex items-center gap-3 rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-4 text-sm font-medium text-zinc-300 shadow-inner transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900/90"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-bold shrink-0">✓</span> Superficie stimata e punti critici (soglie, scarichi, giunti)</p>
            <p class="flex items-center gap-3 rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-4 text-sm font-medium text-zinc-300 shadow-inner transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900/90"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-bold shrink-0">✓</span> Cronistoria delle infiltrazioni ed eventuali interventi precedenti</p>
            <p class="flex items-center gap-3 rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-4 text-sm font-medium text-zinc-300 shadow-inner transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900/90"><span class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-bold shrink-0">✓</span> Foto del problema o planimetrie orientative</p>
        </div>
    </section>

    <!-- CALL TO ACTION FINALE -->
    <CallToAction 
        eyebrow="PARTNER TECNICO QUALIFICATO"
        title="Hai un cantiere o un condominio da risolvere?" 
        text="Richiedi una consulenza tecnica specialistica o una perizia per l'assemblea. Forniamo sopralluogo diagnostico in loco, computo metrico e relazione preliminare entro 48 ore." 
        buttonText="Richiedi Consulenza Tecnica B2B"
    />
</SiteLayout>
