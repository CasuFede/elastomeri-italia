---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';

interface Lavoro {
    id: number;
    titolo: string;
    descrizione: string;
    localita: string;
    immagine_url: string;
    data_creazione?: string;
}

let lavori: Lavoro[] = [];
try {
    const api = (env as unknown as { API?: { fetch: (req: Request) => Promise<Response> } })?.API;
    const reqUrl = new URL('/api/lavori', Astro.url.origin).toString();
    const res =
        api && typeof api.fetch === 'function'
            ? await api.fetch(new Request(reqUrl, { method: 'GET' }))
            : await fetch(reqUrl);
    if (res.ok) {
        const body = (await res.json()) as { dati?: Lavoro[] };
        if (Array.isArray(body?.dati)) {
            lavori = body.dati;
        }
    }
} catch {
    lavori = [];
}
---

<SiteLayout
    title="Lavori e Cantieri a Genova e Liguria | Poliurea System"
    description="Galleria dei lavori e cantieri di impermeabilizzazione in poliurea pura realizzati a Genova e in Liguria su terrazzi, coperture e fondazioni."
    activePath="/lavori"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Lavori', path: '/lavori' }]}
>
    <PageIntro
        eyebrow="LAVORI E INTERVENTI"
        title="Ogni intervento"
        highlight="parte da un’esigenza."
        text="Una selezione di interventi realizzati a Genova, in Liguria e nel Nord Italia: superfici trattate, problemi risolti e soluzioni adottate."
    />

    {lavori.length > 0 ? (
        <section id="works-gallery" class="works-gallery wrap my-12" aria-label="Lavori realizzati">
            <div id="works-grid" class="works-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {lavori.map((lavoro) => (
                    <article class="work-card rounded-2xl border-2 border-slate-600 bg-slate-800 overflow-hidden transition-colors duration-200 hover:border-sky-400 flex flex-col">
                        <img
                            src={lavoro.immagine_url}
                            alt={`Lavoro realizzato da Poliurea System: ${lavoro.titolo}${lavoro.localita ? ` (${lavoro.localita})` : ''}`}
                            loading="lazy"
                            width="600"
                            height="450"
                            class="w-full aspect-[4/3] object-cover bg-slate-900"
                        />
                        <div class="work-card-content p-6 flex-1 flex flex-col">
                            {lavoro.localita && (
                                <p class="work-location text-xs font-extrabold uppercase tracking-wider text-sky-400 mb-2">
                                    {lavoro.localita}
                                </p>
                            )}
                            <h2 class="text-xl font-bold text-white mb-2">{lavoro.titolo}</h2>
                            {lavoro.descrizione && (
                                <p class="text-sm text-slate-200 leading-relaxed">{lavoro.descrizione}</p>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </section>
    ) : (
        <section id="gallery-empty" class="gallery-empty wrap my-12 grid gap-8 lg:grid-cols-[1fr_1.4fr] items-center rounded-3xl border-2 border-slate-600 bg-slate-800 p-8 sm:p-12 transition-colors duration-200 hover:border-sky-400">
            <div class="gallery-empty-art rounded-2xl border border-slate-600 bg-slate-900 p-8 flex items-center justify-center min-h-[220px]">
                <img src="/logo-poliurea-system.png" alt="Poliurea System - Galleria lavori in preparazione" class="max-w-[240px] w-full h-auto" width="240" height="41" />
            </div>
            <div class="gallery-empty-copy">
                <p class="eyebrow text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">GALLERIA IN PREPARAZIONE</p>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight mb-4">Qui racconteremo<br /><span class="text-sky-400">i lavori realizzati.</span></h2>
                <p class="text-slate-200 text-base leading-relaxed mb-6">Stiamo raccogliendo le fotografie e i dettagli dei progetti da condividere. Torna a trovarci per scoprire gli interventi, le superfici trattate e le soluzioni adottate.</p>
                <a class="text-link inline-flex items-center gap-2 text-sm font-bold text-sky-400 hover:text-white transition-colors" href="/contatti">Hai un progetto da raccontare? <span aria-hidden="true">→</span></a>
            </div>
        </section>
    )}

    <section class="gallery-guidelines py-14 bg-[#111827] border-y border-slate-700">
        <div class="wrap gallery-guidelines-inner grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border-2 border-slate-600 bg-slate-800 p-6 flex items-start gap-4 transition-colors duration-200 hover:border-sky-400"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white font-mono text-sm font-bold">01</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il contesto</strong><small class="text-slate-200 text-xs">Tipologia dell’edificio e area interessata</small></p></div>
            <div class="rounded-2xl border-2 border-slate-600 bg-slate-800 p-6 flex items-start gap-4 transition-colors duration-200 hover:border-sky-400"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white font-mono text-sm font-bold">02</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il problema</strong><small class="text-slate-200 text-xs">La situazione da cui è partito l’intervento</small></p></div>
            <div class="rounded-2xl border-2 border-slate-600 bg-slate-800 p-6 flex items-start gap-4 transition-colors duration-200 hover:border-sky-400"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white font-mono text-sm font-bold">03</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il percorso</strong><small class="text-slate-200 text-xs">Le fasi e le soluzioni effettivamente adottate</small></p></div>
        </div>
    </section>
    <CallToAction title="Hai un problema simile?" text="Raccontacelo: ogni valutazione comincia dalle caratteristiche del tuo edificio." />
</SiteLayout>
