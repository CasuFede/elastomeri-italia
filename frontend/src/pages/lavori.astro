---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
---

<SiteLayout
    title="Lavori e interventi | Poliurea System"
    description="Una galleria dedicata agli interventi di impermeabilizzazione, in preparazione con le immagini e le informazioni dei lavori."
    activePath="/lavori"
>
    <PageIntro
        eyebrow="LAVORI E INTERVENTI"
        title="Ogni intervento"
        highlight="parte da un’esigenza."
        text="Una selezione di interventi, superfici trattate e soluzioni adottate, con immagini e informazioni sui lavori realizzati."
    />
    <section id="gallery-empty" class="gallery-empty wrap my-12 grid gap-8 lg:grid-cols-[1fr_1.4fr] items-center rounded-3xl border border-zinc-800 bg-zinc-900 p-8 sm:p-12 shadow-2xl transition-colors duration-300 hover:border-zinc-700">
        <div class="gallery-empty-art rounded-2xl border border-zinc-800 bg-zinc-950 p-8 flex items-center justify-center min-h-[220px] relative overflow-hidden" aria-hidden="true">
            <div class="gallery-frame frame-back"></div>
            <div class="gallery-frame frame-front border border-sky-500/30 bg-sky-500/10 text-sky-400"><span>EI</span><small class="text-zinc-300">SPAZIO PER I TUOI<br />PROGETTI REALIZZATI</small></div>
            <span class="gallery-spark spark-one text-sky-400">✳</span><span class="gallery-spark spark-two text-sky-400">✳</span>
        </div>
        <div class="gallery-empty-copy">
            <p class="eyebrow text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">GALLERIA IN PREPARAZIONE</p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight mb-4">Qui racconteremo<br /><span class="text-sky-400">i lavori realizzati.</span></h2>
            <p class="text-zinc-400 text-base leading-relaxed mb-6">Stiamo raccogliendo le fotografie e i dettagli dei progetti da condividere. Torna a trovarci per scoprire gli interventi, le superfici trattate e le soluzioni adottate.</p>
            <a class="text-link inline-flex items-center gap-2 text-sm font-bold text-sky-400 hover:text-sky-300 transition-colors" href="/contatti">Hai un progetto da raccontare? <span aria-hidden="true">→</span></a>
        </div>
    </section>
    <section id="works-gallery" class="works-gallery wrap my-12 hidden" aria-label="Lavori realizzati">
        <div id="works-grid" class="works-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>
    <section class="gallery-guidelines py-14 bg-zinc-950 border-y border-zinc-800">
        <div class="wrap gallery-guidelines-inner grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-lg shadow-black/40 flex items-start gap-4 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-mono text-sm font-bold">01</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il contesto</strong><small class="text-zinc-400 text-xs">Tipologia dell’edificio e area interessata</small></p></div>
            <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-lg shadow-black/40 flex items-start gap-4 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-mono text-sm font-bold">02</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il problema</strong><small class="text-zinc-400 text-xs">La situazione da cui è partito l’intervento</small></p></div>
            <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-lg shadow-black/40 flex items-start gap-4 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-500/15 border border-sky-500/30 text-sky-400 font-mono text-sm font-bold">03</span><p class="text-sm"><strong class="block text-white font-bold mb-1">Il percorso</strong><small class="text-zinc-400 text-xs">Le fasi e le soluzioni effettivamente adottate</small></p></div>
        </div>
    </section>
    <CallToAction title="Hai un problema simile?" text="Raccontacelo: ogni valutazione comincia dalle caratteristiche del tuo edificio." />
    <script is:inline>
        const caricaGalleria = async () => {
            try {
                const risposta = await fetch('/api/lavori');
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const { dati } = await risposta.json();
                if (!Array.isArray(dati) || dati.length === 0) return;

                const griglia = document.getElementById('works-grid');
                for (const lavoro of dati) {
                    const scheda = document.createElement('article');
                    scheda.className = 'work-card group rounded-2xl border border-zinc-800 bg-zinc-900 overflow-hidden shadow-xl hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1 transition-colors duration-300';
                    const immagine = document.createElement('img');
                    immagine.src = lavoro.immagine_url;
                    immagine.alt = `Lavoro: ${lavoro.titolo}`;
                    immagine.loading = 'lazy';
                    immagine.width = 600;
                    immagine.height = 450;
                    immagine.className = 'w-full aspect-[4/3] object-cover bg-zinc-800';
                    immagine.onerror = () => {
                        immagine.onerror = null;
                        immagine.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 450' width='600' height='450' fill='%2318181b'%3E%3Crect width='600' height='450' fill='%2318181b'/%3E%3Crect x='20' y='20' width='560' height='410' rx='12' fill='%2309090b' stroke='%2327272a' stroke-width='1.5'/%3E%3Ccircle cx='300' cy='200' r='36' fill='%230284c7' fill-opacity='0.15' stroke='%2338bdf8' stroke-width='2'/%3E%3Cpath d='M285 200h30M300 185v30' stroke='%2338bdf8' stroke-width='2.5' stroke-linecap='round'/%3E%3Ctext x='300' y='270' fill='%23a1a1aa' font-family='system-ui, sans-serif' font-size='14' font-weight='600' text-anchor='middle'%3EIntervento Poliurea System%3C/text%3E%3C/svg%3E";
                    };
                    scheda.appendChild(immagine);

                    const contenuto = document.createElement('div');
                    contenuto.className = 'work-card-content p-6';
                    if (lavoro.localita) {
                        const localita = document.createElement('p');
                        localita.className = 'work-location text-xs font-bold uppercase tracking-wider text-sky-400 mb-2';
                        localita.textContent = lavoro.localita;
                        contenuto.appendChild(localita);
                    }
                    const titolo = document.createElement('h2');
                    titolo.className = 'text-xl font-bold text-white mb-2 group-hover:text-sky-400 transition-colors';
                    titolo.textContent = lavoro.titolo;
                    contenuto.appendChild(titolo);
                    if (lavoro.descrizione) {
                        const descrizione = document.createElement('p');
                        descrizione.className = 'text-sm text-zinc-400 line-clamp-3';
                        descrizione.textContent = lavoro.descrizione;
                        contenuto.appendChild(descrizione);
                    }
                    scheda.appendChild(contenuto);
                    griglia.appendChild(scheda);
                }

                document.getElementById('gallery-empty').hidden = true;
                document.getElementById('works-gallery').classList.remove('hidden');
            } catch (errore) {
                console.error('Impossibile caricare la galleria lavori:', errore);
            }
        };

        caricaGalleria();
    </script>
</SiteLayout>
