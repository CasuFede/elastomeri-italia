---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import {
    lavoriProgetti,
    type LavoroMediaFoto,
    type LavoroProgetto,
    type LavoroStratigrafiaStep,
    type LavoroVideo,
} from '../data/lavori';

interface LavoroApiMedia {
    id: number;
    url: string;
    alt?: string;
    didascalia?: string;
    ordine?: number;
}

interface LavoroApiVideo {
    id: number;
    url: string;
    poster_url?: string;
    titolo?: string;
    durata?: string;
    descrizione?: string;
    ordine?: number;
}

interface LavoroApi {
    id: number;
    titolo: string;
    categoria?: string;
    descrizione?: string;
    localita?: string;
    superficie_mq?: number;
    supporto?: string;
    ciclo_sistema?: string;
    armatura?: string;
    applicazione?: string;
    stratigrafia_descrizione?: string;
    stratigrafia_fasi?: LavoroStratigrafiaStep[];
    foto_prima?: LavoroApiMedia[];
    foto_dopo?: LavoroApiMedia[];
    video_dopo?: LavoroApiVideo[];
    immagine_url?: string;
    data_creazione?: string;
}

const CATEGORIE_VALIDE: LavoroProgetto['categoria'][] = [
    'Coperture industriali',
    'Terrazzi e lastrici',
    'Fondazioni e cantine',
    'Impermeabilizzazioni',
];

function normalizzaCategoria(val?: string): LavoroProgetto['categoria'] {
    if (val && CATEGORIE_VALIDE.includes(val as LavoroProgetto['categoria'])) {
        return val as LavoroProgetto['categoria'];
    }
    return 'Impermeabilizzazioni';
}

let lavoriApiMappati: LavoroProgetto[] = [];
try {
    const api = (env as unknown as { API?: { fetch: (req: Request) => Promise<Response> } })?.API;
    const reqUrl = new URL('/api/lavori', Astro.url.origin).toString();
    const res =
        api && typeof api.fetch === 'function'
            ? await api.fetch(new Request(reqUrl, { method: 'GET' }))
            : await fetch(reqUrl);
    if (res.ok) {
        const body = (await res.json()) as { dati?: LavoroApi[] };
        if (Array.isArray(body?.dati)) {
            lavoriApiMappati = body.dati.map((item): LavoroProgetto => {
                const fotoPrima: LavoroMediaFoto[] = (item.foto_prima ?? []).map((f, i) => ({
                    src: f.url,
                    alt: f.alt || `Stato iniziale ${i + 1}: ${item.titolo}`,
                    didascalia: f.didascalia || undefined,
                }));
                const fotoDopo: LavoroMediaFoto[] = (item.foto_dopo ?? []).map((f, i) => ({
                    src: f.url,
                    alt: f.alt || `Risultato finale ${i + 1}: ${item.titolo}`,
                    didascalia: f.didascalia || undefined,
                }));
                if (fotoPrima.length === 0 && fotoDopo.length === 0 && item.immagine_url) {
                    fotoDopo.push({
                        src: item.immagine_url,
                        alt: `Intervento realizzato da Poliurea System: ${item.titolo}`,
                        didascalia: item.descrizione || undefined,
                    });
                }
                const videoDopo: LavoroVideo[] = (item.video_dopo ?? []).map((v) => ({
                    src: v.url,
                    poster:
                        v.poster_url ||
                        fotoDopo[0]?.src ||
                        fotoPrima[0]?.src ||
                        '/images/hero-capannone-poliurea-bianca.webp',
                    titolo: v.titolo || 'Video del risultato',
                    durata: v.durata || undefined,
                    descrizione: v.descrizione || undefined,
                }));
                const fasi: LavoroStratigrafiaStep[] = Array.isArray(item.stratigrafia_fasi)
                    ? item.stratigrafia_fasi
                          .filter((s) => s && typeof s.titolo === 'string' && s.titolo.trim().length > 0)
                          .map((s, idx) => ({
                              fase: (s.fase || '').trim() || String(idx + 1).padStart(2, '0'),
                              titolo: s.titolo.trim(),
                              dettaglio: (s.dettaglio || '').trim(),
                          }))
                    : [];

                return {
                    id: `cantiere-${item.id}`,
                    categoria: normalizzaCategoria(item.categoria),
                    titolo: item.titolo,
                    localita: item.localita || 'Genova e Liguria',
                    superficieMq: Number(item.superficie_mq || 0),
                    supporto: item.supporto || '',
                    cicloSistema: item.ciclo_sistema || '',
                    armatura: item.armatura || '',
                    applicazione: item.applicazione || '',
                    riepilogo: item.descrizione || '',
                    stratigrafiaDescrizione: item.stratigrafia_descrizione || '',
                    stratigrafiaFasi: fasi,
                    fotoPrima,
                    fotoDopo,
                    videoDopo,
                };
            });
        }
    }
} catch {
    lavoriApiMappati = [];
}

// Tutti i lavori unificati: prima i cantieri pubblicati da Admin (più recenti), poi i cantieri di vetrina
const tuttiLavori: LavoroProgetto[] = [...lavoriApiMappati, ...lavoriProgetti];
const categorieDisponibili = Array.from(new Set(tuttiLavori.map((p) => p.categoria)));
---

<SiteLayout
    title="Lavori e Cantieri a Genova e Liguria | Poliurea System"
    description="Interventi reali di impermeabilizzazione a Genova e in Liguria: galleria fotografica Prima e Dopo, video del risultato finale, schede tecniche e stratigrafie."
    activePath="/lavori"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Lavori', path: '/lavori' }]}
>
    <PageIntro
        title="I nostri cantieri,"
        highlight="prima e dopo."
        text="Esplora gli interventi reali eseguiti sul campo. Clicca su un lavoro per aprire la galleria completa delle foto Prima e Dopo, i video del risultato finale e la scheda tecnica con la stratigrafia applicata."
    />

    <!-- BARRA FILTRI PER CATEGORIA (si attiva automaticamente quando sono presenti più categorie) -->
    {categorieDisponibili.length > 1 && (
        <section class="wrap mb-8" aria-label="Filtra gli interventi per categoria">
            <div class="work-filter-bar" data-work-filters>
                <button type="button" class="work-filter-btn is-active" data-work-filter="all">
                    Tutti gli interventi <span>{tuttiLavori.length}</span>
                </button>
                {categorieDisponibili.map((cat) => (
                    <button type="button" class="work-filter-btn" data-work-filter={cat}>
                        {cat} <span>{tuttiLavori.filter((p) => p.categoria === cat).length}</span>
                    </button>
                ))}
            </div>
        </section>
    )}

    <!-- GRIGLIA ADATTIVA DEI LAVORI (featured full-width con 1 lavoro, 2 o 3 colonne con più cantieri) -->
    <section id="works-showcase" class="wrap pb-24" aria-label="Elenco lavori documentati">
        {tuttiLavori.length === 0 ? (
            <div class="rounded-3xl border border-[#D2D2D7] bg-[#F5F5F7] p-10 text-center">
                <p class="text-base font-bold text-[#1D1D1F]">Nuovi cantieri in aggiornamento</p>
                <p class="mt-2 text-sm text-[#6E6E73]">A breve pubblicheremo nuove foto Prima e Dopo dei nostri interventi.</p>
            </div>
        ) : (
        <div class={`work-cards-grid ${tuttiLavori.length === 1 ? 'is-single-featured' : tuttiLavori.length === 2 ? 'is-two-col' : ''}`}>
            {tuttiLavori.map((lavoro, cardIndex) => {
                const coverPrima = lavoro.fotoPrima[0];
                const coverDopo = lavoro.fotoDopo[0];
                const totFoto = lavoro.fotoPrima.length + lavoro.fotoDopo.length;
                const totVideo = lavoro.videoDopo?.length ?? 0;
                const specsLine = [lavoro.supporto, lavoro.cicloSistema, lavoro.armatura]
                    .filter((s) => s && s.trim().length > 0)
                    .join(' · ');
                const loadingAttr = cardIndex < 3 ? 'eager' : 'lazy';

                return (
                    <article
                        id={lavoro.id}
                        class="work-compact-card"
                        data-work-card
                        data-work-category={lavoro.categoria}
                    >
                        <button
                            type="button"
                            class="work-compact-trigger"
                            data-open-project={lavoro.id}
                            aria-label={`Apri scheda completa, foto Prima e Dopo e video: ${lavoro.titolo}`}
                        >
                            <!-- Anteprima statica Prima / Dopo (oppure copertina singola se presente solo una fase) -->
                            {coverPrima && coverDopo ? (
                                <div class="work-compact-diptych">
                                    <div class="work-compact-half">
                                        <img
                                            src={coverPrima.src}
                                            alt={coverPrima.alt}
                                            width="480"
                                            height="360"
                                            loading={loadingAttr}
                                            decoding="async"
                                        />
                                        <span class="work-phase-pill work-phase-pill--before">PRIMA</span>
                                    </div>
                                    <div class="work-compact-half">
                                        <img
                                            src={coverDopo.src}
                                            alt={coverDopo.alt}
                                            width="480"
                                            height="360"
                                            loading={loadingAttr}
                                            decoding="async"
                                        />
                                        <span class="work-phase-pill work-phase-pill--after">DOPO</span>
                                    </div>
                                    {(totFoto > 0 || totVideo > 0) && (
                                        <span class="work-compact-media-count">
                                            {totFoto} foto{totVideo > 0 ? ` · ${totVideo} video` : ''}
                                        </span>
                                    )}
                                </div>
                            ) : (coverDopo || coverPrima) ? (
                                <div class="work-compact-single">
                                    <img
                                        src={(coverDopo || coverPrima)!.src}
                                        alt={(coverDopo || coverPrima)!.alt}
                                        width="640"
                                        height="400"
                                        loading={loadingAttr}
                                        decoding="async"
                                    />
                                    <span class={`work-phase-pill ${coverDopo ? 'work-phase-pill--after' : 'work-phase-pill--before'}`}>
                                        {coverDopo ? 'DOPO' : 'PRIMA'}
                                    </span>
                                    {(totFoto > 0 || totVideo > 0) && (
                                        <span class="work-compact-media-count">
                                            {totFoto} foto{totVideo > 0 ? ` · ${totVideo} video` : ''}
                                        </span>
                                    )}
                                </div>
                            ) : (
                                <div class="work-compact-single work-compact-single--empty">
                                    <span>Scheda tecnica cantiere</span>
                                </div>
                            )}

                            <!-- Informazioni essenziali compatte -->
                            <div class="work-compact-body">
                                <div class="work-compact-meta">
                                    <span class="work-case-category">{lavoro.categoria}</span>
                                    {lavoro.superficieMq > 0 && (
                                        <span class="work-compact-mq">{lavoro.superficieMq} mq</span>
                                    )}
                                </div>

                                <h2 class="work-compact-title">{lavoro.titolo}</h2>

                                {tuttiLavori.length === 1 && lavoro.riepilogo && (
                                    <p class="work-featured-summary">{lavoro.riepilogo}</p>
                                )}

                                {(specsLine || lavoro.riepilogo) && (
                                    <p class="work-compact-specs">
                                        {specsLine || lavoro.riepilogo}
                                    </p>
                                )}

                                <div class="work-compact-footer">
                                    {lavoro.localita && (
                                        <span class="work-case-location">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                                <circle cx="12" cy="10" r="3" />
                                            </svg>
                                            {lavoro.localita}
                                        </span>
                                    )}
                                    <span class="work-compact-cta">
                                        Apri dettagli e foto <span aria-hidden="true">→</span>
                                    </span>
                                </div>
                            </div>
                        </button>
                    </article>
                );
            })}
        </div>
        )}
    </section>

    <!-- MODALE SCHEDA COMPLETA LAVORO (Galleria Prima/Dopo + Video + Specifiche Tecniche) -->
    <div id="work-project-modal" class="work-detail-modal" role="dialog" aria-modal="true" aria-label="Dettaglio intervento" hidden>
        <div class="work-detail-dialog">
            {tuttiLavori.map((lavoro) => {
                const videoItems = lavoro.videoDopo ?? [];
                const allPhotos = [
                    ...lavoro.fotoPrima.map((f) => ({ ...f, fase: 'PRIMA' })),
                    ...lavoro.fotoDopo.map((f) => ({ ...f, fase: 'DOPO' })),
                ];
                const allPhotosJson = JSON.stringify(allPhotos);
                const mediaGroupsCount =
                    (lavoro.fotoPrima.length > 0 ? 1 : 0) +
                    (lavoro.fotoDopo.length > 0 ? 1 : 0) +
                    (videoItems.length > 0 ? 1 : 0);
                const hasKpis =
                    lavoro.superficieMq > 0 ||
                    Boolean(lavoro.supporto) ||
                    Boolean(lavoro.cicloSistema) ||
                    Boolean(lavoro.armatura);
                const hasStratigrafia =
                    Boolean(lavoro.stratigrafiaDescrizione) || lavoro.stratigrafiaFasi.length > 0;

                return (
                    <div
                        class="work-project-sheet"
                        data-project-sheet={lavoro.id}
                        data-gallery-items={allPhotosJson}
                        hidden
                    >
                        <!-- Intestazione fissa della modale -->
                        <div class="work-detail-header">
                            <div class="work-detail-header-info">
                                <div class="work-case-meta">
                                    <span class="work-case-category">{lavoro.categoria}</span>
                                    {lavoro.superficieMq > 0 && (
                                        <span class="work-compact-mq">{lavoro.superficieMq} mq</span>
                                    )}
                                    {lavoro.localita && (
                                        <span class="work-case-location">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                                <circle cx="12" cy="10" r="3" />
                                            </svg>
                                            {lavoro.localita}
                                        </span>
                                    )}
                                </div>
                                <h2 class="work-detail-title">{lavoro.titolo}</h2>
                            </div>
                            <button
                                type="button"
                                class="work-detail-close"
                                data-close-project
                                aria-label="Chiudi scheda lavoro"
                            >
                                Chiudi ✕
                            </button>
                        </div>

                        <!-- Corpo scorrevole della scheda lavoro -->
                        <div class="work-detail-body">
                            {lavoro.riepilogo && (
                                <p class="work-detail-summary">{lavoro.riepilogo}</p>
                            )}

                            <!-- Scheda Dati Chiave -->
                            {hasKpis && (
                                <div class="work-kpi-grid work-kpi-grid--modal">
                                    {lavoro.superficieMq > 0 && (
                                        <div class="work-kpi-card">
                                            <span class="work-kpi-label">Superficie trattata</span>
                                            <strong class="work-kpi-value">{lavoro.superficieMq} mq</strong>
                                        </div>
                                    )}
                                    {lavoro.supporto && (
                                        <div class="work-kpi-card">
                                            <span class="work-kpi-label">Supporto esistente</span>
                                            <strong class="work-kpi-value">{lavoro.supporto}</strong>
                                        </div>
                                    )}
                                    {lavoro.cicloSistema && (
                                        <div class="work-kpi-card">
                                            <span class="work-kpi-label">Ciclo e sistema</span>
                                            <strong class="work-kpi-value">{lavoro.cicloSistema}</strong>
                                        </div>
                                    )}
                                    {lavoro.armatura && (
                                        <div class="work-kpi-card">
                                            <span class="work-kpi-label">Armatura strutturale</span>
                                            <strong class="work-kpi-value">{lavoro.armatura}</strong>
                                        </div>
                                    )}
                                </div>
                            )}

                            <!-- Filtri rapidi Galleria (solo se ci sono almeno 2 gruppi media) -->
                            {mediaGroupsCount > 1 && (
                                <div class="work-media-tabs" data-media-tabs role="tablist" aria-label="Filtra foto e video del cantiere">
                                    <button type="button" class="work-media-tab is-active" data-media-filter="all" role="tab" aria-selected="true">
                                        Tutto <span>{allPhotos.length + videoItems.length}</span>
                                    </button>
                                    {lavoro.fotoPrima.length > 0 && (
                                        <button type="button" class="work-media-tab" data-media-filter="prima" role="tab" aria-selected="false">
                                            Foto Prima <span>{lavoro.fotoPrima.length}</span>
                                        </button>
                                    )}
                                    {lavoro.fotoDopo.length > 0 && (
                                        <button type="button" class="work-media-tab" data-media-filter="dopo" role="tab" aria-selected="false">
                                            Foto Dopo <span>{lavoro.fotoDopo.length}</span>
                                        </button>
                                    )}
                                    {videoItems.length > 0 && (
                                        <button type="button" class="work-media-tab" data-media-filter="video" role="tab" aria-selected="false">
                                            Video del Dopo <span>{videoItems.length}</span>
                                        </button>
                                    )}
                                </div>
                            )}

                            <!-- GALLERIA PRIMA -->
                            {lavoro.fotoPrima.length > 0 && (
                                <section class="work-gallery-section" data-media-section="prima">
                                    <div class="work-gallery-section-head">
                                        <div class="work-gallery-badge-group">
                                            <span class="work-phase-pill work-phase-pill--before">PRIMA</span>
                                            <h3>Stato iniziale e lavorazione</h3>
                                        </div>
                                        <span class="work-submedia-count">{lavoro.fotoPrima.length} foto · Clicca per ingrandire</span>
                                    </div>
                                    <div class="work-gallery-grid">
                                        {lavoro.fotoPrima.map((foto, idx) => (
                                            <button
                                                type="button"
                                                class="work-thumb-btn"
                                                data-open-gallery={lavoro.id}
                                                data-gallery-index={idx}
                                                aria-label={`Apri foto Prima ${idx + 1}: ${foto.didascalia || foto.alt}`}
                                            >
                                                <div class="work-thumb-media">
                                                    <img
                                                        src={foto.src}
                                                        alt={foto.alt}
                                                        width="480"
                                                        height="360"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                    <span class="work-thumb-overlay" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="11" cy="11" r="7" />
                                                            <path d="m21 21-4.3-4.3" />
                                                            <path d="M11 8v6M8 11h6" />
                                                        </svg>
                                                    </span>
                                                </div>
                                                {foto.didascalia && (
                                                    <span class="work-thumb-caption">{foto.didascalia}</span>
                                                )}
                                            </button>
                                        ))}
                                    </div>
                                </section>
                            )}

                            <!-- GALLERIA DOPO -->
                            {lavoro.fotoDopo.length > 0 && (
                                <section class="work-gallery-section" data-media-section="dopo">
                                    <div class="work-gallery-section-head">
                                        <div class="work-gallery-badge-group">
                                            <span class="work-phase-pill work-phase-pill--after">DOPO</span>
                                            <h3>Risultato finale impermeabilizzato</h3>
                                        </div>
                                        <span class="work-submedia-count">{lavoro.fotoDopo.length} foto · Clicca per ingrandire</span>
                                    </div>
                                    <div class="work-gallery-grid work-gallery-grid--after">
                                        {lavoro.fotoDopo.map((foto, idx) => (
                                            <button
                                                type="button"
                                                class="work-thumb-btn"
                                                data-open-gallery={lavoro.id}
                                                data-gallery-index={lavoro.fotoPrima.length + idx}
                                                aria-label={`Apri foto Dopo ${idx + 1}: ${foto.didascalia || foto.alt}`}
                                            >
                                                <div class="work-thumb-media">
                                                    <img
                                                        src={foto.src}
                                                        alt={foto.alt}
                                                        width="480"
                                                        height="360"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                    <span class="work-thumb-overlay" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="11" cy="11" r="7" />
                                                            <path d="m21 21-4.3-4.3" />
                                                            <path d="M11 8v6M8 11h6" />
                                                        </svg>
                                                    </span>
                                                </div>
                                                {foto.didascalia && (
                                                    <span class="work-thumb-caption">{foto.didascalia}</span>
                                                )}
                                            </button>
                                        ))}
                                    </div>
                                </section>
                            )}

                            <!-- VIDEO DEL DOPO (lazy on-demand) -->
                            {videoItems.length > 0 && (
                                <section class="work-gallery-section" data-media-section="video">
                                    <div class="work-gallery-section-head">
                                        <div class="work-gallery-badge-group">
                                            <span class="work-phase-pill work-phase-pill--video">VIDEO DOPO</span>
                                            <h3>Riprese del risultato completato</h3>
                                        </div>
                                        <span class="work-submedia-count">{videoItems.length} video · Riproduzione rapida</span>
                                    </div>
                                    <div class="work-videos-grid work-videos-grid--cols">
                                        {videoItems.map((vid) => (
                                            <button
                                                type="button"
                                                class="work-video-tile"
                                                data-open-video
                                                data-video-src={vid.src}
                                                data-video-poster={vid.poster}
                                                data-video-title={vid.titolo}
                                                data-video-desc={vid.descrizione || ''}
                                                aria-label={`Riproduci video: ${vid.titolo}`}
                                            >
                                                <div class="work-video-poster">
                                                    <img
                                                        src={vid.poster}
                                                        alt={`Copertina video: ${vid.titolo}`}
                                                        width="640"
                                                        height="360"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                    <span class="work-video-scrim" aria-hidden="true"></span>
                                                    <span class="work-video-play" aria-hidden="true">
                                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                                            <path d="M8 5.14v14l11-7-11-7Z" />
                                                        </svg>
                                                    </span>
                                                    {vid.durata && (
                                                        <span class="work-video-duration">{vid.durata}</span>
                                                    )}
                                                </div>
                                                <div class="work-video-info">
                                                    <strong>{vid.titolo}</strong>
                                                    {vid.descrizione && <span>{vid.descrizione}</span>}
                                                </div>
                                            </button>
                                        ))}
                                    </div>
                                </section>
                            )}

                            <!-- SCHEDA TECNICA E STRATIGRAFIA -->
                            {hasStratigrafia && (
                                <section class="work-stratigraphy-box work-stratigraphy-box--modal">
                                    <div class="work-stratigraphy-head">
                                        <span class="work-stratigraphy-kicker">SCHEDA TECNICA · STRATIGRAFIA APPLICATA</span>
                                        {lavoro.applicazione && (
                                            <span class="work-stratigraphy-method">{lavoro.applicazione}</span>
                                        )}
                                    </div>
                                    {lavoro.stratigrafiaDescrizione && (
                                        <p class="work-stratigraphy-lead">{lavoro.stratigrafiaDescrizione}</p>
                                    )}

                                    {lavoro.stratigrafiaFasi.length > 0 && (
                                        <ol class="work-layer-list work-layer-list--cols">
                                            {lavoro.stratigrafiaFasi.map((step) => (
                                                <li class="work-layer-item">
                                                    <span class="work-layer-num">{step.fase}</span>
                                                    <div class="work-layer-body">
                                                        <strong>{step.titolo}</strong>
                                                        {step.dettaglio && <p>{step.dettaglio}</p>}
                                                    </div>
                                                </li>
                                            ))}
                                        </ol>
                                    )}
                                </section>
                            )}
                        </div>
                    </div>
                );
            })}
        </div>
    </div>

    <!-- MODALE LIGHTBOX GALLERIA FOTOGRAFICA (z-index superiore alla scheda lavoro) -->
    <div id="work-gallery-modal" class="work-modal" role="dialog" aria-modal="true" aria-labelledby="work-gallery-title" hidden>
        <div class="work-modal-dialog work-modal-dialog--photo">
            <div class="work-modal-header">
                <div class="min-w-0">
                    <span id="work-gallery-counter" class="work-modal-kicker">FOTO 1 DI 1</span>
                    <h3 id="work-gallery-title" class="work-modal-title">Dettaglio cantiere</h3>
                </div>
                <button type="button" id="work-gallery-close" class="work-modal-close" aria-label="Chiudi galleria">Chiudi ✕</button>
            </div>
            <div id="work-gallery-stage" class="work-modal-stage">
                <button type="button" id="work-gallery-prev" class="work-modal-nav work-modal-nav--prev" aria-label="Foto precedente">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <img id="work-gallery-img" alt="Dettaglio fotografico intervento" class="work-modal-img" />
                <button type="button" id="work-gallery-next" class="work-modal-nav work-modal-nav--next" aria-label="Foto successiva">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                </button>
            </div>
            <p id="work-gallery-swipe-hint" class="work-modal-swipe-hint">Scorri a sinistra o destra per sfogliare le foto</p>
        </div>
    </div>

    <!-- MODALE LIGHTBOX VIDEO LAZY-LOADED (z-index superiore alla scheda lavoro) -->
    <div id="work-video-modal" class="work-modal" role="dialog" aria-modal="true" aria-labelledby="work-video-title" hidden>
        <div class="work-modal-dialog work-modal-dialog--video">
            <div class="work-modal-header">
                <div class="min-w-0">
                    <span class="work-modal-kicker">VIDEO DEL RISULTATO</span>
                    <h3 id="work-video-title" class="work-modal-title">Ripresa cantiere</h3>
                </div>
                <button type="button" id="work-video-close" class="work-modal-close" aria-label="Chiudi video">Chiudi ✕</button>
            </div>
            <div class="work-modal-video-wrap">
                <video
                    id="work-video-player"
                    class="work-modal-video"
                    controls
                    playsinline
                    preload="none"
                ></video>
            </div>
            <p id="work-video-desc" class="work-modal-desc" hidden></p>
        </div>
    </div>
</SiteLayout>

<script>
    interface GalleryPhotoItem {
        src: string;
        alt: string;
        didascalia?: string;
        fase?: string;
    }

    const syncBodyScroll = () => {
        const anyOpen =
            !document.getElementById('work-project-modal')?.hidden ||
            !document.getElementById('work-gallery-modal')?.hidden ||
            !document.getElementById('work-video-modal')?.hidden;
        document.body.style.overflow = anyOpen ? 'hidden' : '';
    };

    // 1. Filtri per categoria nella griglia principale (attivi se presenti più categorie)
    const filterBar = document.querySelector<HTMLElement>('[data-work-filters]');
    if (filterBar) {
        const filterBtns = Array.from(filterBar.querySelectorAll<HTMLButtonElement>('[data-work-filter]'));
        const workCards = Array.from(document.querySelectorAll<HTMLElement>('[data-work-card]'));

        filterBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const selected = btn.dataset.workFilter || 'all';
                filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
                workCards.forEach((card) => {
                    const cat = card.dataset.workCategory || '';
                    card.hidden = selected !== 'all' && cat !== selected;
                });
            });
        });
    }

    // 2. Modale Scheda Completa Lavoro (apertura al clic sulla card compatta)
    const projectModal = document.getElementById('work-project-modal') as HTMLElement | null;
    const projectSheets = Array.from(document.querySelectorAll<HTMLElement>('[data-project-sheet]'));
    let lastProjectTrigger: HTMLElement | null = null;

    const resetMediaTabs = (sheet: HTMLElement) => {
        const tabs = Array.from(sheet.querySelectorAll<HTMLButtonElement>('[data-media-filter]'));
        const sections = Array.from(sheet.querySelectorAll<HTMLElement>('[data-media-section]'));
        tabs.forEach((t) => {
            const isAll = t.dataset.mediaFilter === 'all';
            t.classList.toggle('is-active', isAll);
            t.setAttribute('aria-selected', isAll ? 'true' : 'false');
        });
        sections.forEach((s) => {
            s.hidden = false;
        });
    };

    const openProjectModal = (projectId: string, trigger?: HTMLElement | null) => {
        if (!projectModal) return;
        const targetSheet = projectSheets.find((s) => s.dataset.projectSheet === projectId);
        if (!targetSheet) return;

        lastProjectTrigger = trigger ?? null;

        projectSheets.forEach((sheet) => {
            const isTarget = sheet === targetSheet;
            sheet.hidden = !isTarget;
            if (isTarget) {
                resetMediaTabs(sheet);
                const body = sheet.querySelector<HTMLElement>('.work-detail-body');
                if (body) body.scrollTop = 0;
            }
        });

        projectModal.hidden = false;
        syncBodyScroll();

        const closeBtn = targetSheet.querySelector<HTMLButtonElement>('[data-close-project]');
        closeBtn?.focus();
    };

    const closeProjectModal = () => {
        if (!projectModal || projectModal.hidden) return;
        projectModal.hidden = true;
        projectSheets.forEach((s) => {
            s.hidden = true;
        });
        syncBodyScroll();
        if (window.location.hash) {
            history.replaceState(null, '', window.location.pathname + window.location.search);
        }
        lastProjectTrigger?.focus();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.dataset.openProject;
            if (id) openProjectModal(id, btn);
        });
    });

    projectModal?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === projectModal || target.closest('[data-close-project]')) {
            closeProjectModal();
        }
    });

    // Filtri interni (Tutto / Foto Prima / Foto Dopo / Video del Dopo) dentro ciascuna scheda
    projectSheets.forEach((sheet) => {
        const tabs = Array.from(sheet.querySelectorAll<HTMLButtonElement>('[data-media-filter]'));
        const sections = Array.from(sheet.querySelectorAll<HTMLElement>('[data-media-section]'));
        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const filter = tab.dataset.mediaFilter || 'all';
                tabs.forEach((t) => {
                    const active = t === tab;
                    t.classList.toggle('is-active', active);
                    t.setAttribute('aria-selected', active ? 'true' : 'false');
                });
                sections.forEach((sec) => {
                    const kind = sec.dataset.mediaSection || '';
                    sec.hidden = filter !== 'all' && kind !== filter;
                });
            });
        });
    });

    // Apertura automatica se l'URL contiene #id-progetto
    const initialHash = window.location.hash.replace(/^#/, '');
    if (initialHash && projectSheets.some((s) => s.dataset.projectSheet === initialHash)) {
        openProjectModal(initialHash);
    }

    // 3. Lightbox Galleria Fotografica (Prima + Dopo con frecce Avanti/Indietro)
    const galleryModal = document.getElementById('work-gallery-modal') as HTMLElement | null;
    const galleryImg = document.getElementById('work-gallery-img') as HTMLImageElement | null;
    const galleryTitle = document.getElementById('work-gallery-title') as HTMLElement | null;
    const galleryCounter = document.getElementById('work-gallery-counter') as HTMLElement | null;
    const galleryPrev = document.getElementById('work-gallery-prev') as HTMLButtonElement | null;
    const galleryNext = document.getElementById('work-gallery-next') as HTMLButtonElement | null;
    const galleryClose = document.getElementById('work-gallery-close') as HTMLButtonElement | null;

    let activeGallery: GalleryPhotoItem[] = [];
    let activeGalleryIdx = 0;
    let lastGalleryTrigger: HTMLElement | null = null;

    const renderGalleryItem = () => {
        const item = activeGallery[activeGalleryIdx];
        if (!item || !galleryImg || !galleryTitle || !galleryCounter) return;
        galleryImg.src = item.src;
        galleryImg.alt = item.alt || 'Dettaglio cantiere';
        galleryTitle.textContent = item.didascalia || item.alt || 'Dettaglio cantiere';
        const phasePrefix = item.fase ? `${item.fase} · ` : '';
        galleryCounter.textContent = `${phasePrefix}FOTO ${activeGalleryIdx + 1} DI ${activeGallery.length}`;
        const hasMultiple = activeGallery.length > 1;
        if (galleryPrev) galleryPrev.hidden = !hasMultiple;
        if (galleryNext) galleryNext.hidden = !hasMultiple;
    };

    const openGallery = (items: GalleryPhotoItem[], index: number, trigger: HTMLElement) => {
        if (!galleryModal || items.length === 0) return;
        activeGallery = items;
        activeGalleryIdx = Math.max(0, Math.min(items.length - 1, index));
        lastGalleryTrigger = trigger;
        renderGalleryItem();
        galleryModal.hidden = false;
        syncBodyScroll();
        galleryClose?.focus();
    };

    const closeGallery = () => {
        if (!galleryModal || galleryModal.hidden) return;
        galleryModal.hidden = true;
        if (galleryImg) galleryImg.removeAttribute('src');
        syncBodyScroll();
        lastGalleryTrigger?.focus();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-gallery]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const projectId = btn.dataset.openGallery;
            const sheet = projectSheets.find((s) => s.dataset.projectSheet === projectId);
            if (!sheet?.dataset.galleryItems) return;
            try {
                const items = JSON.parse(sheet.dataset.galleryItems) as GalleryPhotoItem[];
                const idx = Number(btn.dataset.galleryIndex || '0');
                openGallery(items, idx, btn);
            } catch {
                // ignore malformed dataset
            }
        });
    });

    galleryPrev?.addEventListener('click', () => {
        if (activeGallery.length < 2) return;
        activeGalleryIdx = (activeGalleryIdx - 1 + activeGallery.length) % activeGallery.length;
        renderGalleryItem();
    });

    galleryNext?.addEventListener('click', () => {
        if (activeGallery.length < 2) return;
        activeGalleryIdx = (activeGalleryIdx + 1) % activeGallery.length;
        renderGalleryItem();
    });

    galleryClose?.addEventListener('click', closeGallery);
    galleryModal?.addEventListener('click', (e) => {
        if (e.target === galleryModal) closeGallery();
    });

    // Swipe touch sinistra/destra nella galleria fotografica su telefono
    const galleryStage = document.getElementById('work-gallery-stage');
    let touchStartX = 0;
    let touchStartY = 0;
    galleryStage?.addEventListener(
        'touchstart',
        (e) => {
            if (e.touches.length !== 1) return;
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        },
        { passive: true }
    );
    galleryStage?.addEventListener(
        'touchend',
        (e) => {
            if (activeGallery.length < 2 || e.changedTouches.length !== 1) return;
            const dx = e.changedTouches[0].clientX - touchStartX;
            const dy = e.changedTouches[0].clientY - touchStartY;
            if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                if (dx < 0) galleryNext?.click();
                else galleryPrev?.click();
            }
        },
        { passive: true }
    );

    // 4. Lightbox Video Lazy-Loaded (carica il file MP4 solo al clic)
    const videoModal = document.getElementById('work-video-modal') as HTMLElement | null;
    const videoPlayer = document.getElementById('work-video-player') as HTMLVideoElement | null;
    const videoTitle = document.getElementById('work-video-title') as HTMLElement | null;
    const videoDesc = document.getElementById('work-video-desc') as HTMLElement | null;
    const videoClose = document.getElementById('work-video-close') as HTMLButtonElement | null;
    let lastVideoTrigger: HTMLElement | null = null;

    const openVideo = (btn: HTMLButtonElement) => {
        if (!videoModal || !videoPlayer || !videoTitle) return;
        const src = btn.dataset.videoSrc;
        if (!src) return;

        lastVideoTrigger = btn;
        videoTitle.textContent = btn.dataset.videoTitle || 'Video del risultato';

        const desc = (btn.dataset.videoDesc || '').trim();
        if (videoDesc) {
            videoDesc.textContent = desc;
            videoDesc.hidden = desc.length === 0;
        }

        if (btn.dataset.videoPoster) {
            videoPlayer.poster = btn.dataset.videoPoster;
        }
        videoPlayer.src = src;
        videoPlayer.load();

        videoModal.hidden = false;
        syncBodyScroll();
        videoClose?.focus();
        videoPlayer.play().catch(() => {});
    };

    const closeVideo = () => {
        if (!videoModal || videoModal.hidden) return;
        if (videoPlayer) {
            videoPlayer.pause();
            videoPlayer.removeAttribute('src');
            videoPlayer.load();
        }
        videoModal.hidden = true;
        syncBodyScroll();
        lastVideoTrigger?.focus();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-video]').forEach((btn) => {
        btn.addEventListener('click', () => openVideo(btn));
    });

    videoClose?.addEventListener('click', closeVideo);
    videoModal?.addEventListener('click', (e) => {
        if (e.target === videoModal) closeVideo();
    });

    // Gestione tastiera gerarchica (chiude sempre la modale in primo piano prima di quella sotto)
    document.addEventListener('keydown', (e) => {
        if (videoModal && !videoModal.hidden) {
            if (e.key === 'Escape') closeVideo();
            return;
        }
        if (galleryModal && !galleryModal.hidden) {
            if (e.key === 'Escape') closeGallery();
            else if (e.key === 'ArrowLeft') galleryPrev?.click();
            else if (e.key === 'ArrowRight') galleryNext?.click();
            return;
        }
        if (projectModal && !projectModal.hidden && e.key === 'Escape') {
            closeProjectModal();
        }
    });
</script>
