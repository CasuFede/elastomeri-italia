---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import MethodTimeline from '../components/MethodTimeline.astro';
import CallToAction from '../components/CallToAction.astro';
---

<SiteLayout
    title="Il metodo | Poliurea System"
    description="Un percorso chiaro per affrontare infiltrazioni e umidità: ascolto, valutazione e proposta dell’intervento."
    activePath="/metodo"
>
    <PageIntro
        eyebrow="IL NOSTRO APPROCCIO"
        title="Prima capire."
        highlight="Poi intervenire."
        text="Per affrontare un’infiltrazione serve risalire al contesto e ai punti coinvolti. Il percorso parte dalle informazioni, non da soluzioni preconfezionate."
    />

    <MethodTimeline />

    <section class="method-principle border-y border-zinc-800 bg-zinc-950 py-16 text-center">
        <div class="wrap principle-content max-w-2xl">
            <p class="eyebrow inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-sky-400">UN PRINCIPIO SEMPLICE</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-4xl">La soluzione giusta<br />inizia dalla <span class="text-sky-400">domanda giusta.</span></h2>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">Per questo raccogliamo prima le informazioni essenziali, poi valutiamo come proseguire.</p>
        </div>
    </section>
    <CallToAction title="Iniziamo dalla tua situazione." text="Compila il modulo: ci darai gli elementi per un primo confronto." />
</SiteLayout>
