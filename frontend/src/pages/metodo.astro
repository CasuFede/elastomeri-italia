---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import { metodiOperativi, confrontoMetodi } from '../data/metodi';
---

<SiteLayout
    title="I 3 Metodi di Applicazione: Manuale, a Spruzzo e a Freddo | Poliurea System"
    description="Come operiamo a Genova e in Liguria: applicazione manuale con fibra di vetro, poliurea a caldo a spruzzo bimixer e poliurea a freddo / poliaspartica."
    activePath="/metodo"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Metodo', path: '/metodo' }]}
>
    <PageIntro
        title="Tre metodi applicativi,"
        highlight="scegliamo quello giusto."
        text="Ogni cantiere ha metratura, supporto e accesso diversi. Operiamo con 3 modalità complementari per garantirti sempre una tenuta continua senza giunzioni."
    />

    <!-- NAVIGAZIONE RAPIDA -->
    <section class="wrap mb-10" aria-label="Collegamenti rapidi ai metodi applicativi">
        <div class="method-jump-bar">
            {metodiOperativi.map((m) => (
                <a class="method-jump-pill" href={`#${m.id}`}>
                    <span>{m.numero}</span>
                    {m.titoloBreve}
                </a>
            ))}
            <a class="method-jump-pill method-jump-pill--accent" href="#confronto">
                Confronto rapido →
            </a>
        </div>
    </section>

    <!-- 3 SCHEDE VISUALI (IMMAGINE + CONTENUTO ESSENZIALE) -->
    <section class="wrap pb-16 space-y-8" aria-label="Le tre modalità operative">
        {metodiOperativi.map((metodo, index) => (
            <article id={metodo.id} class={`method-visual-card ${index % 2 === 1 ? 'is-reversed' : ''}`}>
                <div class="method-visual-media">
                    <img
                        src={metodo.immagine}
                        alt={metodo.immagineAlt}
                        width="1280"
                        height="800"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                    />
                    <span class="method-visual-pill">
                        <strong>{metodo.numero}</strong>
                        <span>{metodo.tag}</span>
                    </span>
                </div>

                <div class="method-visual-body">
                    <div class="method-visual-top">
                        <span class="method-detail-badge">{metodo.badgeHome}</span>
                    </div>

                    <h2 class="method-visual-title">{metodo.titolo}</h2>
                    <p class="method-visual-desc">{metodo.descrizione}</p>

                    <!-- 3 Metriche Rapide -->
                    <dl class="method-metrics-row">
                        {metodo.metriche.map((metrica) => (
                            <div class="method-metric-box">
                                <dt>{metrica.etichetta}</dt>
                                <dd>{metrica.valore}</dd>
                            </div>
                        ))}
                    </dl>

                    <!-- 3 Punti Chiave sintetici -->
                    <ul class="method-check-list">
                        {metodo.puntiChiave.map((punto) => (
                            <li>
                                <span class="method-check-icon" aria-hidden="true">✓</span>
                                <span>{punto}</span>
                            </li>
                        ))}
                    </ul>

                    <!-- Ideale per -->
                    <div class="method-visual-footer">
                        <div class="method-chips">
                            {metodo.idealePer.map((uso) => (
                                <span class="method-chip">{uso}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </article>
        ))}
    </section>

    <!-- TABELLA COMPARATIVA SNELLE -->
    <section id="confronto" class="method-compare-section">
        <div class="wrap">
            <div class="ps-inner ps-center mb-10">
                <div class="ps-eyebrow">Confronto rapido</div>
                <h2 class="ps-h2">I 3 metodi <em>a colpo d’occhio.</em></h2>
            </div>

            <div class="method-table-wrap">
                <table class="method-compare-table">
                    <thead>
                        <tr>
                            <th scope="col">Parametro</th>
                            <th scope="col">
                                <span class="method-th-num">01</span> Manuale
                            </th>
                            <th scope="col" class="is-featured">
                                <span class="method-th-num">02</span> Spruzzo a Caldo
                            </th>
                            <th scope="col">
                                <span class="method-th-num">03</span> Poliurea a Freddo
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {confrontoMetodi.map((riga) => (
                            <tr>
                                <th scope="row">{riga.criterio}</th>
                                <td>{riga.manuale}</td>
                                <td class="is-featured">{riga.spruzzoCaldo}</td>
                                <td>{riga.poliureaFreddo}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <CallToAction
        eyebrow="CONSULENZA GRATUITA"
        title="Quale metodo è adatto al tuo edificio?"
        text="Valutiamo gratuitamente metratura, accesso e supporto per proporti la tecnologia più efficace."
        buttonText="Richiedi il Sopralluogo Gratuito"
    />
</SiteLayout>
