---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import MethodTimeline from '../components/MethodTimeline.astro';
import CallToAction from '../components/CallToAction.astro';
---

<SiteLayout
    title="Metodo Diagnostico Poliurea Liguria | Poliurea System"
    description="Protocollo in 3 fasi a Genova e in Liguria: diagnosi igrometrica, preparazione meccanica diamantata del supporto e posa continua di poliurea pura."
    activePath="/metodo"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Il metodo', path: '/metodo' }]}
>
    <PageIntro
        eyebrow="METODO DIAGNOSTICO CERTIFICATO"
        title="Prima capire l'origine."
        highlight="Poi eliminare il problema."
        text="Un'impermeabilizzazione fallisce se applicata su un supporto inadeguato o senza una diagnosi preliminare. Il nostro protocollo esclude interventi improvvisati: garantiamo adesione chimica, tenuta idraulica duratura e garanzia decennale."
    />

    <!-- TIMELINE DEL METODO IN 3 FASI -->
    <MethodTimeline />

    <!-- CONFRONTO: METODO TRADIZIONALE VS METODO POLIUREA SYSTEM -->
    <section class="method-comparison wrap my-16">
        <div class="mb-10 text-center sm:text-left">
            <p class="inline-block rounded-md border border-sky-500 bg-sky-950 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-sky-300">LA DIFFERENZA SOSTANZIALE</p>
            <h2 class="mt-3 text-2xl sm:text-4xl font-extrabold text-white tracking-tight">Perché i metodi tradizionali falliscono<br /><span class="text-sky-400">e perché il nostro metodo dura nel tempo.</span></h2>
            <p class="mt-3 text-sm sm:text-base text-slate-200 max-w-2xl">La differenza tra una riparazione provvisoria e una soluzione definitiva risiede nel rispetto rigoroso delle fasi preparatorie e chimiche.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Box Tradizionale -->
            <div class="rounded-2xl border-2 border-red-500 bg-slate-800 p-6 sm:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-600 text-white font-bold text-sm">✕</span>
                    <h3 class="text-xl font-bold text-white">Interventi Edili Tradizionali</h3>
                </div>
                <ul class="space-y-4 text-sm text-slate-200">
                    <li class="flex items-start gap-3">
                        <span class="text-red-400 font-bold mt-0.5">✕</span>
                        <div><strong class="text-white block mb-0.5">Demolizioni invasive e costose:</strong> rimozione di piastrelle e massetto con macerie, polvere e rumori per settimane.</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-red-400 font-bold mt-0.5">✕</span>
                        <div><strong class="text-white block mb-0.5">Saldature e sormonti a fiamma:</strong> le guaine bituminose hanno giunzioni vulnerabili che si scollano dopo 5-7 inverni.</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-red-400 font-bold mt-0.5">✕</span>
                        <div><strong class="text-white block mb-0.5">Nessun controllo dell'umidità interna:</strong> l'acqua intrappolata nel massetto evapora creando bolle e distacchi della guaina.</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-red-400 font-bold mt-0.5">✕</span>
                        <div><strong class="text-white block mb-0.5">Fermo cantiere prolungato:</strong> settimane di inagibilità delle superfici con disagi per residenti e attività.</div>
                    </li>
                </ul>
            </div>

            <!-- Box Metodo Poliurea System -->
            <div class="rounded-2xl border-2 border-sky-500 bg-slate-800 p-6 sm:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-600 text-white font-bold text-sm">✓</span>
                    <h3 class="text-xl font-bold text-white">Il Nostro Metodo Diagnostico</h3>
                </div>
                <ul class="space-y-4 text-sm text-slate-200">
                    <li class="flex items-start gap-3">
                        <span class="text-emerald-400 font-bold mt-0.5">✓</span>
                        <div><strong class="text-white block mb-0.5">Zero demolizioni:</strong> applichiamo la membrana sopra le piastrelle o la guaina esistente, azzerando macerie e costi di smaltimento.</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-emerald-400 font-bold mt-0.5">✓</span>
                        <div><strong class="text-white block mb-0.5">Membrana continua al 100% monolitica:</strong> nessun giunto, nessuna saldatura e totale assenza di fiamme libere in opera.</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-emerald-400 font-bold mt-0.5">✓</span>
                        <div><strong class="text-white block mb-0.5">Rilievi termo-igrometrici certificati:</strong> misuriamo l'umidità del supporto e applichiamo primer ad adesione chimica (&gt; 2.5 MPa).</div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-emerald-400 font-bold mt-0.5">✓</span>
                        <div><strong class="text-white block mb-0.5">Pedonabile in 60 minuti:</strong> cantiere concluso in 1-2 giorni lavorativi e superfici immediatamente riutilizzabili.</div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- PRINCIPIO GUIDA -->
    <section class="method-principle border-y border-slate-700 bg-[#111827] py-16 text-center">
        <div class="wrap principle-content max-w-2xl mx-auto">
            <p class="eyebrow inline-block rounded-md border border-sky-500 bg-sky-950 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-sky-300">UN PRINCIPIO IRRINUNCIABILE</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-4xl">La soluzione definitiva<br />inizia dalla <span class="text-sky-400">diagnosi corretta.</span></h2>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-200">Non formuliamo preventivi sommari a distanza: ogni intervento comincia dall'analisi strumentale delle superfici per garantire tenuta assoluta e garanzia decennale.</p>
        </div>
    </section>

    <!-- CALL TO ACTION FINALE -->
    <CallToAction 
        eyebrow="METODO COLLAUDATO & GARANTITO"
        title="Affida il tuo edificio a un protocollo certo." 
        text="Non rischiare con interventi provvisori che raddoppiano i costi nel tempo. Prenota oggi stesso il tuo sopralluogo diagnostico in loco senza impegno." 
        buttonText="Richiedi il Sopralluogo Gratuito"
    />
</SiteLayout>
