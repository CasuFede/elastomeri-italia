---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import { metodiOperativi, confrontoMetodi } from '../data/metodi';
---

<SiteLayout
    title="I 3 Metodi di Applicazione: Manuale, a Spruzzo e a Freddo | Poliurea System"
    description="Come operiamo a Genova e in Liguria: applicazione manuale con fibra di vetro, poliurea a caldo a spruzzo con bimixer (70°C, 200 bar) e poliurea a freddo / poliaspartica."
    activePath="/metodo"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Metodo', path: '/metodo' }]}
>
    <PageIntro
        eyebrow="LE NOSTRE 3 MODALITÀ OPERATIVE"
        title="Tre metodi applicativi."
        highlight="La tecnica giusta per ogni cantiere."
        text="Non forziamo mai un’unica soluzione su tutti gli edifici. In base a superficie, supporto esistente, accesso logistico e tempi richiesti scegliamo tra applicazione manuale, poliurea a caldo a spruzzo e poliurea a freddo."
    />

    <!-- NAVIGAZIONE RAPIDA TRA I 3 METODI E TABELLA COMPARATIVA -->
    <section class="wrap mb-10" aria-label="Collegamenti rapidi ai metodi applicativi">
        <div class="method-jump-bar">
            {metodiOperativi.map((m) => (
                <a class="method-jump-pill" href={`#${m.id}`}>
                    <span>{m.numero}</span>
                    {m.titolo}
                </a>
            ))}
            <a class="method-jump-pill method-jump-pill--accent" href="#confronto">
                Tabella comparativa →
            </a>
        </div>
    </section>

    <!-- SCHEDE DETTAGLIATE DEI 3 METODI OPERATIVI -->
    <section class="wrap pb-16 space-y-10" aria-label="Dettaglio delle tre modalità applicative">
        {metodiOperativi.map((metodo) => (
            <article id={metodo.id} class="method-detail-card">
                <header class="method-detail-head">
                    <div class="method-detail-meta">
                        <span class="method-detail-num">{metodo.numero}</span>
                        <span class="method-detail-tag">{metodo.tag}</span>
                        <span class="method-detail-badge">{metodo.badgeHome}</span>
                    </div>
                    <h2 class="method-detail-title">{metodo.titolo}</h2>
                    <p class="method-detail-sub">{metodo.sottotitolo}</p>
                </header>

                <div class="method-detail-grid">
                    <!-- Colonna Sinistra: Spiegazione, Campi d'impiego, Vantaggi, Fasi -->
                    <div class="method-detail-main">
                        <p class="method-detail-desc">{metodo.descrizione}</p>

                        <div class="method-detail-block">
                            <h3>Dove la impieghiamo</h3>
                            <div class="method-chips">
                                {metodo.idealePer.map((uso) => (
                                    <span class="method-chip">{uso}</span>
                                ))}
                            </div>
                        </div>

                        <div class="method-detail-block">
                            <h3>Vantaggi principali</h3>
                            <ul class="method-check-list">
                                {metodo.vantaggi.map((v) => (
                                    <li>
                                        <span class="method-check-icon" aria-hidden="true">✓</span>
                                        <span>{v}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <div class="method-detail-block">
                            <h3>Fasi operative di posa</h3>
                            <ol class="method-phases-list">
                                {metodo.fasiPosa.map((fase, idx) => (
                                    <li>
                                        <span class="method-phase-num">{String(idx + 1).padStart(2, '0')}</span>
                                        <span>{fase}</span>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    </div>

                    <!-- Colonna Destra: Scheda Parametri Tecnici + CTA -->
                    <aside class="method-specs-box" aria-label={`Parametri tecnici ${metodo.titolo}`}>
                        <span class="method-specs-kicker">PARAMETRI TECNICI DI RIFERIMENTO</span>
                        <dl class="method-specs-list">
                            {metodo.parametri.map((param) => (
                                <div class="method-spec-row">
                                    <dt>{param.etichetta}</dt>
                                    <dd>{param.valore}</dd>
                                </div>
                            ))}
                        </dl>
                        <a class="ps-pill-btn ps-pill-btn--solid w-full mt-6" href="/preventivo">
                            Valuta questo metodo per il tuo edificio <span aria-hidden="true">↗</span>
                        </a>
                    </aside>
                </div>
            </article>
        ))}
    </section>

    <!-- TABELLA COMPARATIVA DEI 3 METODI -->
    <section id="confronto" class="method-compare-section">
        <div class="wrap">
            <div class="ps-inner ps-center mb-12">
                <div class="ps-eyebrow">Confronto diretto</div>
                <h2 class="ps-h2">Quale sistema scegliamo<br /><em>per il tuo intervento?</em></h2>
                <p class="ps-sub">
                    Tutte e tre le modalità garantiscono una membrana continua senza giunzioni. Qui vedi a colpo d’occhio le differenze operative tra posa manuale, poliurea a caldo a spruzzo e poliurea a freddo.
                </p>
            </div>

            <div class="method-table-wrap">
                <table class="method-compare-table">
                    <thead>
                        <tr>
                            <th scope="col">Parametro</th>
                            <th scope="col">
                                <span class="method-th-num">01</span> Applicazione Manuale
                            </th>
                            <th scope="col" class="is-featured">
                                <span class="method-th-num">02</span> Poliurea a Caldo a Spruzzo
                            </th>
                            <th scope="col">
                                <span class="method-th-num">03</span> Poliurea a Freddo
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {confrontoMetodi.map((riga) => (
                            <tr>
                                <th scope="row">{riga.criterio}</th>
                                <td>{riga.manuale}</td>
                                <td class="is-featured">{riga.spruzzoCaldo}</td>
                                <td>{riga.poliureaFreddo}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- CALL TO ACTION FINALE -->
    <CallToAction
        eyebrow="CONSULENZA TECNICA SU MISURA"
        title="Non sai quale dei 3 metodi è più adatto al tuo edificio?"
        text="Verifichiamo gratuitamente metratura, accesso e tipo di supporto in loco per indicarti la tecnologia più conveniente e duratura tra manuale, spruzzo a caldo e poliurea a freddo."
        buttonText="Richiedi il Sopralluogo Gratuito"
    />
</SiteLayout>
