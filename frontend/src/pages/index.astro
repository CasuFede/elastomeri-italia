---
import '../styles/global.css';
// frontend/src/pages/index.astro
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Elastomeri Italia - Richiedi Preventivo</title>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4 font-sans">

    <div class="bg-white p-8 rounded-xl shadow-lg max-w-lg w-full border-t-4 border-blue-600">
        <h1 class="text-2xl font-bold text-gray-800 mb-2">Richiedi un Preventivo</h1>
        <p class="text-gray-500 mb-6 text-sm">Compila il modulo sottostante per essere ricontattato da un nostro tecnico specializzato in impermeabilizzazioni.</p>

        <form id="form-preventivo" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nome e Cognome *</label>
                <input type="text" name="nome" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                    <input type="email" name="email" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Telefono *</label>
                    <input type="tel" name="telefono" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Tipo di Intervento *</label>
                <select name="servizio" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                    <option value="" disabled selected>Seleziona un servizio...</option>
                    <option value="Tetti e Coperture">Tetti e Coperture</option>
                    <option value="Terrazzi e Balconi">Terrazzi e Balconi</option>
                    <option value="Fondazioni e Muri">Fondazioni e Muri controterra</option>
                    <option value="Altro">Altro (specificare nel messaggio)</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Dettagli del problema</label>
                <textarea name="messaggio" rows="3" class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition shadow-md mt-4">
                Invia Richiesta
            </button>
        </form>

        <!-- Messaggio di conferma -->
        <div id="success-msg" class="hidden mt-4 p-4 bg-green-100 text-green-800 rounded-lg text-center font-medium border border-green-200">
            Richiesta inviata con successo! Ti contatteremo a breve.
        </div>
    </div>

    <script is:inline>
        const form = document.querySelector('#form-preventivo');
        const successMsg = document.querySelector('#success-msg');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Cambia lo stato del bottone
            const btn = form.querySelector('button');
            const originalText = btn.textContent;
            btn.textContent = "Invio in corso...";
            btn.disabled = true;
            btn.classList.add('opacity-70');

            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch('/api/preventivo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });

                if (response.ok) {
                    form.reset();
                    form.classList.add('hidden');
                    successMsg.classList.remove('hidden');
                } else {
                    alert("Si è verificato un errore, riprova più tardi.");
                }
            } catch (error) {
                console.error('Errore:', error);
                alert("Impossibile connettersi al server.");
            } finally {
                // Ripristina il bottone in caso di errore
                btn.textContent = originalText;
                btn.disabled = false;
                btn.classList.remove('opacity-70');
            }
        });
    </script>
</body>
</html>