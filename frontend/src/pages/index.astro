---
import SiteLayout from '../layouts/SiteLayout.astro';
import CallToAction from '../components/CallToAction.astro';
---

<SiteLayout
    title="Impermeabilizzazioni in Poliurea a Spruzzo Senza Demolizioni | Poliurea System"
    description="Soluzioni definitive per infiltrazioni su terrazzi, tetti e fondazioni con membrana continua in pura poliurea a caldo. Calpestabile in 60 minuti, zero demolizioni. Richiedi un sopralluogo gratuito."
>
    <!-- HERO SECTION -->
    <section class="home-hero relative overflow-hidden">
        <!-- Immagine di sfondo a tutto schermo -->
        <img
            src="/images/cantiere-poliurea-hero.webp"
            alt="Cantiere applicazione poliurea a spruzzo"
            width="1376"
            height="768"
            loading="eager"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-[75%_center] sm:object-center z-0"
        />

        <!-- Overlay con gradiente: scuro a tutto campo su mobile, sfumato su desktop -->
        <div class="absolute inset-0 bg-gradient-to-b sm:bg-gradient-to-r from-zinc-950 via-zinc-950/85 to-zinc-950/40 sm:to-transparent z-0 pointer-events-none"></div>

        <!-- Blocco testi e bottoni posizionato sopra lo sfondo fotografico -->
        <div class="wrap relative z-10 py-12 sm:py-20 lg:py-28">
            <div class="hero-copy max-w-2xl">
                <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-semibold tracking-wider text-sky-400 mb-4 backdrop-blur-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
                    IMPERMEABILIZZAZIONE A SPRUZZO SENZA DEMOLIZIONI
                </div>
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] mb-5">
                    L’acqua trova la strada.<br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-sky-200">Noi la soluzione definitiva.</span>
                </h1>
                <p class="hero-description text-base sm:text-lg text-zinc-200 leading-relaxed max-w-xl mb-7 font-normal">
                    Basta infiltrazioni, continue riparazioni provvisorie e costose demolizioni di piastrelle. Applichiamo una membrana continua in pura poliurea a caldo: monolitica, elastica al 400% e calpestabile già dopo 60 minuti.
                </p>
                <div class="hero-actions flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
                    <a 
                        class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-sm sm:text-base px-6 py-3.5 shadow-lg shadow-sky-500/25 transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                        href="/preventivo"
                    >
                        Richiedi un sopralluogo gratuito <span aria-hidden="true" class="text-base font-bold">↗</span>
                    </a>
                    <a 
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700/80 bg-zinc-900/80 hover:bg-zinc-800 hover:border-zinc-600 text-zinc-200 hover:text-white font-semibold text-sm px-5 py-3.5 transition-all duration-200 backdrop-blur-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400"
                        href="/metodo"
                    >
                        Scopri il nostro metodo <span aria-hidden="true" class="text-zinc-400">→</span>
                    </a>
                </div>
                <div class="hero-note mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-zinc-300">
                    <span class="inline-flex items-center gap-1.5">
                        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold">✓</span>
                        Sopralluogo diagnostico senza impegno
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold">✓</span>
                        Risposta entro 24 ore
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold">✓</span>
                        Preventivo chiaro e trasparente
                    </span>
                </div>
            </div>
        </div>

        <div class="hero-bottom wrap relative z-10 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs font-mono font-bold tracking-widest text-zinc-400 py-6 border-t border-zinc-800/80">
            <span>DALLE FONDAZIONI</span><i class="h-1 w-1 rounded-full bg-zinc-700 hidden sm:inline-block"></i><span>ALLE COPERTURE</span><i class="h-1 w-1 rounded-full bg-zinc-700 hidden sm:inline-block"></i><span>FINO AI DETTAGLI</span>
        </div>
    </section>

    <!-- TRUST BAR: 4 QUANTITATIVE METRICS -->
    <section class="trust-bar bg-zinc-950 border-b border-zinc-800/80 py-8 sm:py-10">
        <div class="wrap">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                <div class="flex flex-col p-4 sm:p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/60 transition-colors duration-200 hover:border-zinc-700">
                    <div class="text-2xl sm:text-3xl font-extrabold text-sky-400 tracking-tight">0 Demolizioni</div>
                    <div class="mt-1 text-xs sm:text-sm font-semibold text-white">Nessuna rimozione piastrelle</div>
                    <p class="mt-1 text-xs text-zinc-400 leading-normal">Zero macerie, nessun costo di discarica o polvere.</p>
                </div>
                <div class="flex flex-col p-4 sm:p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/60 transition-colors duration-200 hover:border-zinc-700">
                    <div class="text-2xl sm:text-3xl font-extrabold text-sky-400 tracking-tight">60 Minuti</div>
                    <div class="mt-1 text-xs sm:text-sm font-semibold text-white">Pedonabile all'istante</div>
                    <p class="mt-1 text-xs text-zinc-400 leading-normal">Asciugatura rapida: cantiere fruibile in giornata.</p>
                </div>
                <div class="flex flex-col p-4 sm:p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/60 transition-colors duration-200 hover:border-zinc-700">
                    <div class="text-2xl sm:text-3xl font-extrabold text-sky-400 tracking-tight">0 Giunzioni</div>
                    <div class="mt-1 text-xs sm:text-sm font-semibold text-white">Membrana continua 100%</div>
                    <p class="mt-1 text-xs text-zinc-400 leading-normal">Monolitica senza sormonti o saldature a fiamma.</p>
                </div>
                <div class="flex flex-col p-4 sm:p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/60 transition-colors duration-200 hover:border-zinc-700">
                    <div class="text-2xl sm:text-3xl font-extrabold text-sky-400 tracking-tight">&gt; 400%</div>
                    <div class="mt-1 text-xs sm:text-sm font-semibold text-white">Allungamento elastico</div>
                    <p class="mt-1 text-xs text-zinc-400 leading-normal">Assorbe movimenti strutturali ed escursioni termiche.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- DOVE POSSIAMO INTERVENIRE -->
    <section class="section-block wrap py-16 sm:py-20">
        <div class="section-heading mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <p class="eyebrow inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-sky-400 mb-3">DOVE RISOLVIAMO IL PROBLEMA</p>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">Danni da infiltrazione?<br /><span class="text-sky-400">Ecco dove interveniamo alla radice.</span></h2>
            </div>
            <p class="text-base text-zinc-300 leading-relaxed max-w-md">Umidità, guaine fessurate e ristagni d'acqua: interveniamo con cicli specifici per ogni tipo di supporto, senza demolire l'esistente.</p>
        </div>
        <div class="service-grid">
            <a class="service-card rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/60 transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1.5 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400" href="/fondazioni#terrazzi">
                <span class="card-index text-xs font-extrabold uppercase tracking-wider text-sky-400">01 / TERRAZZI E BALCONI</span>
                <span class="service-icon mt-4 grid h-11 w-11 place-items-center rounded-xl border border-sky-500/25 bg-sky-500/10 text-xl text-sky-400" aria-hidden="true">▱</span>
                <h3 class="mt-4 text-lg font-bold text-white">Terrazzi e lastrici solari</h3>
                <p class="text-sm leading-relaxed text-zinc-300">Stop immediato alle infiltrazioni ai piani sottostanti senza smantellare il pavimento esistente. Impermeabilizzazione continua resistente a ristagni e calpestio frequente.</p>
                <span class="card-link mt-auto pt-4 text-xs font-bold text-sky-400">Approfondisci terrazzi <b aria-hidden="true">↗</b></span>
            </a>
            <a class="service-card rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/60 transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1.5 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400" href="/fondazioni#coperture">
                <span class="card-index text-xs font-extrabold uppercase tracking-wider text-sky-400">02 / TETTI E COPERTURE</span>
                <span class="service-icon mt-4 grid h-11 w-11 place-items-center rounded-xl border border-sky-500/25 bg-sky-500/10 text-xl text-sky-400" aria-hidden="true">⌂</span>
                <h3 class="mt-4 text-lg font-bold text-white">Tetti e coperture industriali</h3>
                <p class="text-sm leading-relaxed text-zinc-300">Scudo protettivo continuo per coperture piane, guaine ammalorate, lamiere grecate e canali di gronda. Sigillatura ermetica di lucernari e corpi passanti.</p>
                <span class="card-link mt-auto pt-4 text-xs font-bold text-sky-400">Approfondisci coperture <b aria-hidden="true">↗</b></span>
            </a>
            <a class="service-card rounded-2xl border border-zinc-800 bg-zinc-900 p-7 shadow-lg shadow-black/60 transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/80 hover:-translate-y-1.5 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400" href="/fondazioni#fondazioni">
                <span class="card-index text-xs font-extrabold uppercase tracking-wider text-sky-400">03 / STRUTTURE INTERRATE</span>
                <span class="service-icon mt-4 grid h-11 w-11 place-items-center rounded-xl border border-sky-500/25 bg-sky-500/10 text-xl text-sky-400" aria-hidden="true">⌂</span>
                <h3 class="mt-4 text-lg font-bold text-white">Fondazioni, corselli e cantine</h3>
                <p class="text-sm leading-relaxed text-zinc-300">Barriera totale contro infiltrazioni da spinta idrostatica, umidità di risalita e fessurazioni su pareti controterra, fosse ascensore e vasche di contenimento.</p>
                <span class="card-link mt-auto pt-4 text-xs font-bold text-sky-400">Approfondisci fondazioni <b aria-hidden="true">↗</b></span>
            </a>
        </div>
    </section>

    <!-- METODO DIAGNOSTICO -->
    <section class="method-preview py-16 sm:py-20 bg-zinc-950 border-y border-zinc-800">
        <div class="wrap method-preview-grid">
            <div class="method-illustration" aria-hidden="true">
                <div class="method-ring ring-a"></div><div class="method-ring ring-b"></div>
                <div class="method-core"><span>EI</span><small>ANALISI<br />E INTERVENTO</small></div>
                <span class="method-node node-a">01</span><span class="method-node node-b">02</span><span class="method-node node-c">03</span>
            </div>
            <div class="method-copy">
                <p class="eyebrow inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-sky-400 mb-3">METODO DIAGNOSTICO CERTIFICATO</p>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight mb-4">Prima capire.<br /><span class="text-sky-400">Poi intervenire.</span></h2>
                <p class="text-base text-zinc-300 leading-relaxed mb-6">Un'impermeabilizzazione fallisce se applicata senza diagnosi su un supporto inadeguato. Il nostro protocollo esclude interventi alla cieca: garantiamo adesione chimica e tenuta idraulica duratura nel tempo.</p>
                <a class="text-link inline-flex items-center gap-2 text-sm font-bold text-sky-400 hover:text-sky-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded-md" href="/metodo">Scopri le fasi del metodo <span aria-hidden="true">→</span></a>
            </div>
            <div class="method-steps flex flex-col gap-4">
                <div class="flex items-start gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4 shadow-md transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-sky-500/30 bg-sky-500/10 font-mono text-xs font-bold text-sky-400">01</span>
                    <div>
                        <strong class="block text-sm font-bold text-white mb-0.5">Analisi Diagnostica Strumentale</strong>
                        <small class="text-xs text-zinc-300 leading-relaxed block">Rilevamento termografico e igrometrico per mappare con precisione l'origine esatta dell'acqua e l'umidità del sottofondo.</small>
                    </div>
                </div>
                <div class="flex items-start gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4 shadow-md transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-sky-500/30 bg-sky-500/10 font-mono text-xs font-bold text-sky-400">02</span>
                    <div>
                        <strong class="block text-sm font-bold text-white mb-0.5">Trattamento Meccanico del Supporto</strong>
                        <small class="text-xs text-zinc-300 leading-relaxed block">Levigatura diamantata, ripristino giunti e applicazione del primer epossidico per una forza di adesione strutturale (&gt; 2.5 MPa).</small>
                    </div>
                </div>
                <div class="flex items-start gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4 shadow-md transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800/80">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-sky-500/30 bg-sky-500/10 font-mono text-xs font-bold text-sky-400">03</span>
                    <div>
                        <strong class="block text-sm font-bold text-white mb-0.5">Spruzzatura Continua & Collaudo</strong>
                        <small class="text-xs text-zinc-300 leading-relaxed block">Nebulizzazione a caldo (70°C, 200 bar) della membrana continua in pura poliurea e successivo collaudo idraulico certificato.</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BENTO GRID: BENEFICI DELLA POLIUREA -->
    <section class="polyurea-section py-16 sm:py-20 bg-black">
        <div class="wrap">
            <div class="mb-10 text-center sm:text-left">
                <p class="inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider text-sky-400">TECNOLOGIA AD ALTE PRESTAZIONI</p>
                <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Perché la poliurea pura<br /><span class="text-sky-400">supera le guaine tradizionali.</span></h2>
                <p class="mt-3 max-w-xl text-base leading-relaxed text-zinc-300">Niente saldature a fiamma, zero giunti che si scollano dopo pochi inverni. Una corazza elastica a spruzzo che diventa un tutt'uno con l'edificio.</p>
            </div>
            
            <div class="bento-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
                <!-- Card 1: Hero Anchor (Tenuta continua) -->
                <article class="col-span-1 md:col-span-2 lg:col-span-2 lg:row-span-2 group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/95 p-7 sm:p-9 shadow-2xl transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/90 hover:-translate-y-1">
                    <div class="relative z-10">
                        <div class="flex items-center justify-between gap-4 mb-6">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-sky-500/30 bg-sky-500/10 text-sky-400 shadow-lg shadow-sky-500/10 group-hover:scale-105 transition-transform duration-300">
                                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    <path d="m9 12 2 2 4-4"/>
                                </svg>
                            </div>
                            <span class="rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-sky-400">TENUTA TOTALE MONOLITICA</span>
                        </div>
                        <h3 class="text-2xl font-bold tracking-tight text-white sm:text-3xl mb-3">Impermeabilità continua senza giunzioni</h3>
                        <p class="text-sm sm:text-base leading-relaxed text-zinc-300">La membrana a spruzzo crea uno scudo continuo e monolitico che elimina alla radice il 100% dei punti deboli tipici delle guaine prefabbricate (saldature, sormonti e risvolti a fiamma).</p>
                    </div>
                    <div class="relative z-10 mt-8 pt-6 border-t border-zinc-800/80 grid grid-cols-2 gap-3">
                        <div class="rounded-xl border border-zinc-800 bg-zinc-950/80 p-3 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900">
                            <span class="block text-[11px] font-mono font-bold uppercase text-sky-400">Affidabilità</span>
                            <span class="text-xs sm:text-sm font-semibold text-white">Zero fessurazioni</span>
                        </div>
                        <div class="rounded-xl border border-zinc-800 bg-zinc-950/80 p-3 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-900">
                            <span class="block text-[11px] font-mono font-bold uppercase text-sky-400">Durabilità</span>
                            <span class="text-xs sm:text-sm font-semibold text-white">Senza rifacimenti continui</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: Azzeramento fermi cantiere (Wide) -->
                <article class="col-span-1 md:col-span-1 lg:col-span-2 group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/95 p-6 sm:p-7 shadow-xl transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/90 hover:-translate-y-1">
                    <div class="flex items-center justify-between gap-4 mb-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-sky-500/30 bg-sky-500/10 text-sky-400 group-hover:scale-105 transition-transform duration-300">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                        </div>
                        <span class="rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-sky-400">TEMPI RECORD</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white mb-2">Pedonabile in 60 minuti</h3>
                        <p class="text-sm leading-relaxed text-zinc-300">Reazione chimica in pochi secondi: le superfici tornano immediatamente calpestabili e fruibili in giornata, azzerando fermi cantiere e lunghi disagi.</p>
                    </div>
                </article>

                <!-- Card 3: Elasticità (Compact) -->
                <article class="col-span-1 md:col-span-1 lg:col-span-1 group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/95 p-6 sm:p-7 shadow-xl transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/90 hover:-translate-y-1">
                    <div class="flex items-center justify-between gap-4 mb-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-sky-500/30 bg-sky-500/10 text-sky-400 group-hover:scale-105 transition-transform duration-300">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m5 9-3 3 3 3"/>
                                <path d="m19 9 3 3-3 3"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                        <span class="rounded-md border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-sky-400">CRACK-BRIDGING</span>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white mb-2">Resistenza a crepe e dilatazioni</h3>
                        <p class="text-xs sm:text-sm leading-relaxed text-zinc-300">Crack-bridging dinamico superiore al 400%: asseconda i movimenti strutturali dell'edificio senza lacerarsi.</p>
                    </div>
                </article>

                <!-- Card 4: Adattabilità geometrica (Compact) -->
                <article class="col-span-1 md:col-span-1 lg:col-span-1 group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/95 p-6 sm:p-7 shadow-xl transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-800/90 hover:-translate-y-1">
                    <div class="flex items-center justify-between gap-4 mb-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-sky-500/30 bg-sky-500/10 text-sky-400 group-hover:scale-105 transition-transform duration-300">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                        </div>
                        <span class="rounded-md border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-sky-400">GEOMETRIE</span>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white mb-2">Sigillatura forme complesse</h3>
                        <p class="text-xs sm:text-sm leading-relaxed text-zinc-300">Adesione continua su scarichi, pozzetti, lucernari, tubature e risvolti verticali senza giunzioni a rischio.</p>
                    </div>
                </article>

                <!-- Card 5: Resistenza UV e Ristagni (Wide) -->
