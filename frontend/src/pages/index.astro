    <section id="faq" class="home-band home-band--alt faq-section" data-band="faq">
        <div class="wrap ps-editorial-body">
            <div class="ps-inner--narrow">
                <div class="ps-faq-head">
                    <div class="ps-eyebrow">Domande frequenti</div>
                    <h2 class="ps-h2">Tutto quello che c’è da sapere<br /><em>prima di richiedere il sopralluogo.</em></h2>
                </div>
                <div class="ps-faq">
                    <details>
                        <summary>È davvero possibile impermeabilizzare senza demolire le piastrelle o la vecchia guaina? <i aria-hidden="true"></i></summary>
                        <p>Sì. Se il pavimento esistente (gres, klinker, cemento) o la vecchia guaina sono ben ancorati, non serve demolire. Eseguiamo una levigatura diamantata superficiale, applichiamo un primer epossidico ad altissima adesione e spruzziamo la poliurea in soli 2–3 mm: zero macerie, niente polvere e risparmio immediato.</p>
                    </details>
                    <details>
                        <summary>Quanto dura nel tempo un’impermeabilizzazione in poliurea pura a spruzzo? <i aria-hidden="true"></i></summary>
                        <p>A differenza delle guaine prefabbricate che si fessurano sui sormonti a causa degli sbalzi termici, la poliurea a spruzzo crea una membrana monolitica priva di giunzioni. Mantiene la sua elasticità (&gt;400%) inalterata per decenni, resiste ai raggi UV grazie al topcoat alifatico e sopporta ristagni d’acqua persistenti senza degradarsi.</p>
                    </details>
                    <details>
                        <summary>In quanto tempo viene completato il cantiere e quando posso calpestare la superficie? <i aria-hidden="true"></i></summary>
                        <p>Il materiale polimerizza in pochi secondi ed è perfettamente calpestabile dopo appena 60 minuti. Un terrazzo residenziale medio viene preparato, primerizzato e impermeabilizzato in 1–2 giorni lavorativi, azzerando i lunghi e invasivi cantieri dell’edilizia tradizionale.</p>
                    </details>
                    <details>
                        <summary>Cosa succede dopo che ho inviato il modulo di contatto? <i aria-hidden="true"></i></summary>
                        <p>Un nostro tecnico esamina i dati e le foto ricevute e ti ricontatta entro 24 ore. Concordiamo un sopralluogo diagnostico in loco, 100% gratuito e senza impegno, durante il quale verifichiamo pendenze, supporti e umidità per formulare un preventivo chiaro e trasparente.</p>
                    </details>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        (() => {
            // Avvio affidabile del video Hero su iOS Safari e Android (senza mai mostrare il tasto Play nativo)
            const heroVideo = document.getElementById('hero-bg-video');
            if (heroVideo instanceof HTMLVideoElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                heroVideo.muted = true;
                heroVideo.defaultMuted = true;
                heroVideo.playsInline = true;
                heroVideo.setAttribute('playsinline', '');
                heroVideo.setAttribute('webkit-playsinline', '');

                const revealVideo = () => {
                    heroVideo.classList.remove('opacity-0');
                    heroVideo.classList.add('opacity-100');
                };

                heroVideo.addEventListener('playing', revealVideo, { once: true });
                heroVideo.addEventListener('timeupdate', () => {
                    if (heroVideo.currentTime > 0 && !heroVideo.paused) revealVideo();
                });

                const tryPlay = () => {
                    if (!heroVideo.paused && heroVideo.currentTime > 0) {
                        revealVideo();
                        return;
                    }
                    const playPromise = heroVideo.play();
                    if (playPromise && typeof playPromise.then === 'function') {
                        playPromise.then(() => {
                            if (heroVideo.currentTime > 0 || !heroVideo.paused) revealVideo();
                        }).catch(() => {
                            // In Risparmio Energetico iOS resta visibile la foto pulita sottostante senza alcun simbolo Play
                        });
                    }
                };

                if (heroVideo.readyState >= 2) {
                    tryPlay();
                } else {
                    heroVideo.addEventListener('loadeddata', tryPlay, { once: true });
                    heroVideo.addEventListener('canplay', tryPlay, { once: true });
                    tryPlay();
                }

                const onFirstInteraction = () => {
                    tryPlay();
                    window.removeEventListener('touchstart', onFirstInteraction);
                    window.removeEventListener('pointerdown', onFirstInteraction);
                    window.removeEventListener('click', onFirstInteraction);
                };
                window.addEventListener('touchstart', onFirstInteraction, { passive: true, once: true });
                window.addEventListener('pointerdown', onFirstInteraction, { passive: true, once: true });
                window.addEventListener('click', onFirstInteraction, { passive: true, once: true });
                document.addEventListener('visibilitychange', () => {
                    if (!document.hidden) tryPlay();
                });
            }

            const syncHeaderOffset = () => {
                const header = document.querySelector('.site-header');
                if (header) {
                    document.documentElement.style.setProperty(
                        '--site-header-height',
                        `${Math.round(header.getBoundingClientRect().height)}px`
                    );
                }
            };
            syncHeaderOffset();
            window.addEventListener('resize', syncHeaderOffset, { passive: true });

            // Carosello orizzontale vantaggi poliurea (frecce, pallini, trascinamento mouse, scorrimento automatico pausabile)
            const track = document.getElementById('polyurea-track');
            const stage = document.getElementById('polyurea-stage');
            const prevBtn = document.getElementById('polyurea-prev');
            const nextBtn = document.getElementById('polyurea-next');
            const dots = Array.from(document.querySelectorAll('#polyurea-dots .ps-carousel-dot'));
            if (track && stage) {
                const cards = Array.from(track.querySelectorAll('.ps-card'));
                const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                let autoTimer = null;
                let userPaused = false;
                let inView = false;

                const getStep = () => {
                    const first = cards[0];
                    if (!first) return 350;
                    const styles = window.getComputedStyle(track);
                    const gap = parseFloat(styles.columnGap || styles.gap || '20') || 20;
                    return first.getBoundingClientRect().width + gap;
                };

                const syncCarouselUI = () => {
                    const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
                    const sl = track.scrollLeft;
                    stage.classList.toggle('is-at-start', sl <= 8);
                    stage.classList.toggle('is-at-end', sl >= maxScroll - 8);

                    if (!dots.length || !cards.length) return;
                    const step = getStep();
                    let activeIdx = Math.round(sl / step);
                    if (sl >= maxScroll - 8) activeIdx = cards.length - 1;
                    activeIdx = Math.max(0, Math.min(cards.length - 1, activeIdx));
                    dots.forEach((dot, idx) => {
                        const isActive = idx === activeIdx;
                        dot.classList.toggle('is-active', isActive);
                        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    });
                };

                const scrollByCards = (dir) => {
                    const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
                    const step = getStep();
                    if (dir > 0) {
                        if (track.scrollLeft >= maxScroll - 12) {
                            track.scrollTo({ left: 0, behavior: 'smooth' });
                        } else {
                            track.scrollTo({ left: Math.min(maxScroll, track.scrollLeft + step), behavior: 'smooth' });
                        }
                    } else {
                        if (track.scrollLeft <= 12) {
                            track.scrollTo({ left: maxScroll, behavior: 'smooth' });
                        } else {
                            track.scrollTo({ left: Math.max(0, track.scrollLeft - step), behavior: 'smooth' });
                        }
                    }
                };

                const stopAuto = () => {
                    if (autoTimer) {
                        window.clearInterval(autoTimer);
                        autoTimer = null;
                    }
                };

                const startAuto = () => {
                    stopAuto();
                    if (reducedMotion || userPaused || !inView) return;
                    autoTimer = window.setInterval(() => {
                        if (!userPaused && inView && !document.hidden) {
                            scrollByCards(1);
                        }
                    }, 4200);
                };

                let resumeTimeout = null;
                const pauseTemporarily = (ms = 8000) => {
                    userPaused = true;
                    stopAuto();
                    if (resumeTimeout) window.clearTimeout(resumeTimeout);
                    resumeTimeout = window.setTimeout(() => {
                        userPaused = false;
                        startAuto();
                    }, ms);
                };

                prevBtn?.addEventListener('click', () => {
                    pauseTemporarily();
                    scrollByCards(-1);
                });
                nextBtn?.addEventListener('click', () => {
                    pauseTemporarily();
                    scrollByCards(1);
                });

                dots.forEach((dot, idx) => {
                    dot.addEventListener('click', () => {
                        pauseTemporarily();
                        const target = cards[idx];
                        if (target) {
                            track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: 'smooth' });
                        }
                    });
                });

                track.addEventListener('keydown', (e) => {
                    if (e.key === 'ArrowRight') {
                        e.preventDefault();
                        pauseTemporarily();
                        scrollByCards(1);
                    } else if (e.key === 'ArrowLeft') {
                        e.preventDefault();
                        pauseTemporarily();
                        scrollByCards(-1);
                    }
                });

                // Trascinamento fluido con mouse su desktop (lascia nativo il touch su mobile)
                let isDragging = false;
                let dragStartX = 0;
                let dragStartScroll = 0;
                track.addEventListener('pointerdown', (e) => {
                    if (e.pointerType !== 'mouse' || e.button !== 0) return;
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartScroll = track.scrollLeft;
                    track.classList.add('is-dragging');
                    track.setPointerCapture(e.pointerId);
                    pauseTemporarily(9000);
                });
                track.addEventListener('pointermove', (e) => {
                    if (!isDragging) return;
                    track.scrollLeft = dragStartScroll - (e.clientX - dragStartX);
                });
                const endDrag = () => {
                    if (!isDragging) return;
                    isDragging = false;
                    track.classList.remove('is-dragging');
                };
                track.addEventListener('pointerup', endDrag);
                track.addEventListener('pointercancel', endDrag);

                track.addEventListener('mouseenter', () => {
                    userPaused = true;
                    stopAuto();
                });
                track.addEventListener('mouseleave', () => {
                    userPaused = false;
                    startAuto();
                });
                track.addEventListener('touchstart', () => pauseTemporarily(9000), { passive: true });
                track.addEventListener('scroll', () => window.requestAnimationFrame(syncCarouselUI), { passive: true });
                window.addEventListener('resize', syncCarouselUI, { passive: true });

                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver(
                        (entries) => {
                            inView = Boolean(entries[0]?.isIntersecting);
                            if (inView) startAuto();
                            else stopAuto();
                        },
                        { threshold: 0.25 }
                    );
                    io.observe(stage);
                } else {
                    inView = true;
                    startAuto();
                }

                syncCarouselUI();
            }
        })();
    </script>
</SiteLayout>
