---
import SiteLayout from '../layouts/SiteLayout.astro';
import CallToAction from '../components/CallToAction.astro';

const faqStructuredData = [
    {
        '@type': 'FAQPage',
        mainEntity: [
            {
                '@type': 'Question',
                name: 'È davvero possibile impermeabilizzare senza demolire le piastrelle o la vecchia guaina?',
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: 'Sì. Se il pavimento esistente (gres, klinker, cemento) o la vecchia guaina sono ben ancorati, non serve demolire. Eseguiamo una levigatura diamantata superficiale, applichiamo un primer epossidico ad altissima adesione e spruzziamo la poliurea in soli 2–3 mm: zero macerie, niente polvere e risparmio immediato.',
                },
            },
            {
                '@type': 'Question',
                name: "Quanto dura nel tempo un'impermeabilizzazione in poliurea pura a spruzzo?",
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: "A differenza delle guaine prefabbricate che si fessurano sui sormonti a causa degli sbalzi termici, la poliurea a spruzzo crea una membrana monolitica priva di giunzioni. Mantiene la sua elasticità (>400%) inalterata per decenni, resiste ai raggi UV grazie al topcoat alifatico e sopporta ristagni d'acqua persistenti senza degradarsi.",
                },
            },
            {
                '@type': 'Question',
                name: 'In quanto tempo viene completato il cantiere e quando posso calpestare la superficie?',
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: "Il materiale polimerizza in pochi secondi ed è perfettamente calpestabile dopo appena 60 minuti. Un terrazzo residenziale medio viene preparato, primerizzato e impermeabilizzato in 1–2 giorni lavorativi, azzerando i lunghi e invasivi cantieri dell'edilizia tradizionale.",
                },
            },
            {
                '@type': 'Question',
                name: 'Cosa succede dopo che ho inviato il modulo di contatto?',
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: 'Un nostro tecnico esamina i dati e le foto ricevute e ti ricontatta entro 24 ore. Concordiamo un sopralluogo diagnostico in loco, 100% gratuito e senza impegno, durante il quale verifichiamo pendenze, supporti e umidità per formulare un preventivo chiaro e trasparente.',
                },
            },
        ],
    },
];
---

<SiteLayout
    title="Poliurea System | Impermeabilizzazioni Genova e Liguria"
    description="Impermeabilizzazioni in poliurea a spruzzo a Genova e in Liguria per terrazzi, tetti e fondazioni. Zero demolizioni, calpestabile in 60 min."
    extraStructuredData={faqStructuredData}
>
    <!-- HERO SECTION -->
    <section class="home-hero relative overflow-hidden">
        <!-- Immagine di base sempre presente sotto al video (evita schermate nere o icone play su iOS Risparmio Energetico) -->
        <img
            src="/images/hero-capannone-poliurea-bianca.webp"
            alt="Tecnico Poliurea System in tuta bianca mentre spruzza poliurea bianca sulla copertura di un capannone industriale"
            width="1376"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-[78%_20%] sm:object-[68%_20%] lg:object-[center_20%] z-0 pointer-events-none"
        />
        <!-- Video di sfondo a tutto schermo (appare in dissolvenza appena parte la riproduzione reale) -->
        <video
            id="hero-bg-video"
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline
            disablepictureinpicture
            disableRemotePlayback
            preload="auto"
            aria-hidden="true"
            src="/media/hero-poliurea.mp4?v=3"
            class="hero-bg-video absolute inset-0 w-full h-full object-cover object-[78%_20%] sm:object-[68%_20%] lg:object-[center_20%] z-0 pointer-events-none opacity-0 transition-opacity duration-500 motion-reduce:hidden"
        ></video>

        <!-- Velo scuro uniforme (nessuna sfumatura) per mantenere leggibile il testo sul video -->
        <div class="absolute inset-0 bg-[#161D2E]/60 z-0 pointer-events-none"></div>

        <!-- Blocco testi con sfondo trasparente direttamente sopra al video -->
        <div class="hero-stage wrap relative z-10">
            <div class="hero-copy max-w-2xl w-full">
                <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold tracking-tight text-white leading-[1.12] mb-5 [text-shadow:0_2px_10px_rgba(0,0,0,0.85)]">
                    L’acqua trova la strada.<br />
                    <span class="text-[#2997FF]">Noi la soluzione definitiva.</span>
                </h1>
                <p class="hero-description text-base sm:text-lg text-white leading-relaxed max-w-xl font-medium [text-shadow:0_1px_6px_rgba(0,0,0,0.9)]">
                    Basta infiltrazioni, continue riparazioni provvisorie e costose demolizioni di piastrelle. Applichiamo una membrana continua in pura poliurea a caldo: monolitica, elastica al 400% e calpestabile già dopo 60 minuti.
                </p>
                <div class="hero-actions">
                    <a
                        class="group inline-flex w-full sm:w-auto items-center justify-center gap-3 rounded-full border-2 border-[#2997FF] bg-[#0071E3] hover:bg-[#0064CC] hover:border-white active:bg-[#005BB8] text-white no-underline font-semibold text-base tracking-tight px-7 py-4 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#161D2E]"
                        href="/metodo"
                    >
                        <span>Scopri il nostro metodo</span>
                        <span
                            aria-hidden="true"
                            class="flex h-7 w-7 items-center justify-center rounded-full bg-white/20 transition-transform duration-200 group-hover:translate-x-1"
                        >
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <div class="hero-bottom wrap relative z-10 shrink-0 flex flex-wrap items-center justify-start sm:justify-center gap-x-4 gap-y-2 sm:gap-6 pr-16 sm:pr-0 text-xs font-mono font-bold tracking-widest text-white py-5 border-t border-white/20 [text-shadow:0_1px_6px_rgba(0,0,0,0.9)]">
            <span>DALLE FONDAZIONI</span><i class="h-1.5 w-1.5 rounded-full bg-[#2997FF] hidden sm:inline-block"></i><span>ALLE COPERTURE</span><i class="h-1.5 w-1.5 rounded-full bg-[#2997FF] hidden sm:inline-block"></i><span>FINO AI DETTAGLI</span>
        </div>
    </section>

    <!-- TRUST BAR: 4 QUANTITATIVE METRICS -->
    <section class="trust-bar bg-[#F5F5F7] border-b border-[#D2D2D7] py-8 sm:py-12">
        <div class="wrap">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                <div class="flex flex-col p-5 sm:p-6 rounded-2xl border border-[#D2D2D7] bg-white transition-colors duration-200 hover:border-[#0071E3]">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#0071E3] tracking-tight">0 Demolizioni</div>
                    <div class="mt-1.5 text-xs sm:text-sm font-bold text-[#1D1D1F]">Nessuna rimozione piastrelle</div>
                    <p class="mt-1 text-xs text-[#6E6E73] leading-normal">Zero macerie, nessun costo di discarica o polvere.</p>
                </div>
                <div class="flex flex-col p-5 sm:p-6 rounded-2xl border border-[#D2D2D7] bg-white transition-colors duration-200 hover:border-[#0071E3]">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#0071E3] tracking-tight">60 Minuti</div>
                    <div class="mt-1.5 text-xs sm:text-sm font-bold text-[#1D1D1F]">Pedonabile all'istante</div>
                    <p class="mt-1 text-xs text-[#6E6E73] leading-normal">Asciugatura rapida: cantiere fruibile in giornata.</p>
                </div>
                <div class="flex flex-col p-5 sm:p-6 rounded-2xl border border-[#D2D2D7] bg-white transition-colors duration-200 hover:border-[#0071E3]">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#0071E3] tracking-tight">0 Giunzioni</div>
                    <div class="mt-1.5 text-xs sm:text-sm font-bold text-[#1D1D1F]">Membrana continua 100%</div>
                    <p class="mt-1 text-xs text-[#6E6E73] leading-normal">Monolitica senza sormonti o saldature a fiamma.</p>
                </div>
                <div class="flex flex-col p-5 sm:p-6 rounded-2xl border border-[#D2D2D7] bg-white transition-colors duration-200 hover:border-[#0071E3]">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#0071E3] tracking-tight">&gt; 400%</div>
                    <div class="mt-1.5 text-xs sm:text-sm font-bold text-[#1D1D1F]">Allungamento elastico</div>
                    <p class="mt-1 text-xs text-[#6E6E73] leading-normal">Assorbe movimenti strutturali ed escursioni termiche.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- MENU RAPIDO STICKY DEGLI ARGOMENTI -->
    <nav class="home-quick-nav" aria-label="Argomenti della home page">
        <div class="wrap home-quick-nav-inner">
            <span class="home-quick-nav-label">ARGOMENTI</span>
            <a class="home-quick-link is-active" href="#interventi" data-band-link="interventi"><span>01</span> Dove interveniamo</a>
            <a class="home-quick-link" href="#metodo" data-band-link="metodo"><span>02</span> Il metodo</a>
            <a class="home-quick-link" href="#poliurea" data-band-link="poliurea"><span>03</span> Perché la poliurea</a>
            <a class="home-quick-link" href="#clienti" data-band-link="clienti"><span>04</span> Privati &amp; Imprese</a>
            <a class="home-quick-link" href="#preventivo-step" data-band-link="preventivo-step"><span>05</span> Preventivo</a>
            <a class="home-quick-link" href="#faq" data-band-link="faq"><span>06</span> FAQ</a>
        </div>
    </nav>

    <!-- BARRA 01: DOVE POSSIAMO INTERVENIRE -->
    <section id="interventi" class="home-band" data-band="interventi">
        <div class="home-band-bar">
            <div class="wrap home-band-bar-inner">
                <div class="home-band-title">
                    <span class="home-band-num">01</span>
                    <span class="home-band-label">Dove risolviamo il problema</span>
                </div>
                <a class="home-band-action" href="/fondazioni">Tutte le aree di intervento <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="wrap home-band-body">
            <div class="section-heading mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1D1D1F] leading-tight">Danni da infiltrazione?<br /><span class="text-[#0071E3]">Ecco dove interveniamo alla radice.</span></h2>
                </div>
                <p class="text-base text-[#6E6E73] leading-relaxed max-w-md">Umidità, guaine fessurate e ristagni d'acqua: clicca su ogni schema tecnico per ingrandirlo e leggere nel dettaglio la stratigrafia dell'intervento.</p>
            </div>
            <div class="service-grid">
                <article class="service-card rounded-[24px] border border-[#D2D2D7] bg-[#F5F5F7] p-5 sm:p-6 transition-colors duration-200 hover:border-[#0071E3] flex flex-col">
                    <button
                        type="button"
                        data-schema-zoom
                        data-schema-src="/images/terrazzi-impermeabilizzazione.svg"
                        data-schema-title="Schema Tecnico — Terrazzi e lastrici solari"
                        data-schema-alt="Schema tecnico impermeabilizzazione terrazzi e lastrici solari senza demolizione"
                        class="group/zoom w-full rounded-2xl border border-[#D2D2D7] hover:border-[#0071E3] bg-[#161D2E] p-2 mb-5 text-left cursor-zoom-in transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3]"
                        aria-label="Ingrandisci schema tecnico terrazzi e lastrici solari"
                    >
                        <img
                            src="/images/terrazzi-impermeabilizzazione.svg"
                            alt="Schema tecnico impermeabilizzazione terrazzi e lastrici solari senza demolizione"
                            class="w-full aspect-[16/10] rounded-xl object-contain bg-[#0f172a]"
                            width="800"
                            height="500"
                            loading="lazy"
                        />
                        <span class="mt-2 flex items-center justify-between gap-2 rounded-xl bg-white border border-[#D2D2D7] px-3 py-2 text-xs font-bold text-[#1D1D1F] group-hover/zoom:bg-[#0071E3] group-hover/zoom:border-[#0071E3] group-hover/zoom:text-white transition-colors">
                            <span>Clicca per ingrandire lo schema</span>
                            <span aria-hidden="true">⤢</span>
                        </span>
                    </button>
                    <span class="card-index text-xs font-extrabold uppercase tracking-wider text-[#0071E3]">01 / TERRAZZI E BALCONI</span>
                    <h3 class="mt-2 text-lg font-bold text-[#1D1D1F]">
                        <a href="/fondazioni#terrazzi" class="text-[#1D1D1F] hover:text-[#0071E3] transition-colors">Terrazzi e lastrici solari</a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-[#6E6E73]">Stop definitivo alle infiltrazioni ai piani sottostanti senza demolire la pavimentazione esistente. Calpestabile in 60 minuti.</p>
                    <a href="/fondazioni#terrazzi" class="card-link mt-auto pt-4 text-xs font-bold text-[#0071E3] hover:text-[#0064CC] flex items-center gap-1 transition-colors">Approfondisci terrazzi <span aria-hidden="true">↗</span></a>
                </article>

                <article class="service-card rounded-[24px] border border-[#D2D2D7] bg-[#F5F5F7] p-5 sm:p-6 transition-colors duration-200 hover:border-[#0071E3] flex flex-col">
                    <button
                        type="button"
                        data-schema-zoom
                        data-schema-src="/images/coperture-impermeabilizzazione.svg"
                        data-schema-title="Schema Tecnico — Tetti e coperture industriali"
                        data-schema-alt="Schema tecnico impermeabilizzazione tetti e coperture industriali"
                        class="group/zoom w-full rounded-2xl border border-[#D2D2D7] hover:border-[#0071E3] bg-[#161D2E] p-2 mb-5 text-left cursor-zoom-in transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3]"
                        aria-label="Ingrandisci schema tecnico tetti e coperture industriali"
                    >
                        <img
                            src="/images/coperture-impermeabilizzazione.svg"
                            alt="Schema tecnico impermeabilizzazione tetti e coperture industriali"
                            class="w-full aspect-[16/10] rounded-xl object-contain bg-[#0f172a]"
                            width="800"
                            height="500"
                            loading="lazy"
                        />
                        <span class="mt-2 flex items-center justify-between gap-2 rounded-xl bg-white border border-[#D2D2D7] px-3 py-2 text-xs font-bold text-[#1D1D1F] group-hover/zoom:bg-[#0071E3] group-hover/zoom:border-[#0071E3] group-hover/zoom:text-white transition-colors">
                            <span>Clicca per ingrandire lo schema</span>
                            <span aria-hidden="true">⤢</span>
                        </span>
                    </button>
                    <span class="card-index text-xs font-extrabold uppercase tracking-wider text-[#0071E3]">02 / TETTI E COPERTURE</span>
                    <h3 class="mt-2 text-lg font-bold text-[#1D1D1F]">
                        <a href="/fondazioni#coperture" class="text-[#1D1D1F] hover:text-[#0071E3] transition-colors">Tetti e coperture industriali</a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-[#6E6E73]">Scudo protettivo continuo per coperture piane, guaine ammalorate e lamiere. Sigillatura ermetica di lucernari e raccordi.</p>
                    <a href="/fondazioni#coperture" class="card-link mt-auto pt-4 text-xs font-bold text-[#0071E3] hover:text-[#0064CC] flex items-center gap-1 transition-colors">Approfondisci coperture <span aria-hidden="true">↗</span></a>
                </article>

                <article class="service-card rounded-[24px] border border-[#D2D2D7] bg-[#F5F5F7] p-5 sm:p-6 transition-colors duration-200 hover:border-[#0071E3] flex flex-col">
                    <button
                        type="button"
                        data-schema-zoom
                        data-schema-src="/images/fondazioni-impermeabilizzazione.svg"
                        data-schema-title="Schema Tecnico — Fondazioni, corselli e cantine"
                        data-schema-alt="Schema tecnico impermeabilizzazione fondazioni e strutture interrate"
                        class="group/zoom w-full rounded-2xl border border-[#D2D2D7] hover:border-[#0071E3] bg-[#161D2E] p-2 mb-5 text-left cursor-zoom-in transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3]"
                        aria-label="Ingrandisci schema tecnico fondazioni, corselli e cantine"
                    >
                        <img
                            src="/images/fondazioni-impermeabilizzazione.svg"
                            alt="Schema tecnico impermeabilizzazione fondazioni e strutture interrate"
                            class="w-full aspect-[16/10] rounded-xl object-contain bg-[#0f172a]"
                            width="800"
                            height="500"
                            loading="lazy"
                        />
                        <span class="mt-2 flex items-center justify-between gap-2 rounded-xl bg-white border border-[#D2D2D7] px-3 py-2 text-xs font-bold text-[#1D1D1F] group-hover/zoom:bg-[#0071E3] group-hover/zoom:border-[#0071E3] group-hover/zoom:text-white transition-colors">
                            <span>Clicca per ingrandire lo schema</span>
                            <span aria-hidden="true">⤢</span>
                        </span>
                    </button>
                    <span class="card-index text-xs font-extrabold uppercase tracking-wider text-[#0071E3]">03 / STRUTTURE INTERRATE</span>
                    <h3 class="mt-2 text-lg font-bold text-[#1D1D1F]">
                        <a href="/fondazioni#fondazioni" class="text-[#1D1D1F] hover:text-[#0071E3] transition-colors">Fondazioni, corselli e cantine</a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-[#6E6E73]">Barriera continua contro la spinta idrostatica e l'umidità di risalita su muri controterra, fosse ascensore e vasche.</p>
                    <a href="/fondazioni#fondazioni" class="card-link mt-auto pt-4 text-xs font-bold text-[#0071E3] hover:text-[#0064CC] flex items-center gap-1 transition-colors">Approfondisci fondazioni <span aria-hidden="true">↗</span></a>
                </article>
            </div>
        </div>
    </section>

    <!-- BARRA 02: METODO DIAGNOSTICO -->
    <section id="metodo" class="home-band home-band--alt method-preview" data-band="metodo">
        <div class="home-band-bar">
            <div class="wrap home-band-bar-inner">
                <div class="home-band-title">
                    <span class="home-band-num">02</span>
                    <span class="home-band-label">Metodo diagnostico certificato</span>
                </div>
                <a class="home-band-action" href="/metodo">Approfondisci il protocollo <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="wrap home-band-body">
            <div class="method-preview-grid">
                <div class="method-copy">
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1D1D1F] leading-tight mb-4">Prima capire.<br /><span class="text-[#0071E3]">Poi intervenire.</span></h2>
                    <p class="text-base text-[#6E6E73] leading-relaxed mb-6">Un'impermeabilizzazione fallisce se applicata senza diagnosi su un supporto inadeguato. Il nostro protocollo esclude interventi alla cieca: verifichiamo l'umidità del supporto e garantiamo adesione chimica e tenuta idraulica certificata.</p>
                    <div class="flex flex-wrap gap-2.5 mb-7">
                        <span class="inline-flex items-center gap-2 rounded-full border border-[#D2D2D7] bg-white px-3.5 py-2 text-xs font-bold text-[#1D1D1F]">
                            <span class="h-2 w-2 rounded-full bg-[#0071E3]"></span> Termocamera IR
                        </span>
                        <span class="inline-flex items-center gap-2 rounded-full border border-[#D2D2D7] bg-white px-3.5 py-2 text-xs font-bold text-[#1D1D1F]">
                            <span class="h-2 w-2 rounded-full bg-[#0071E3]"></span> Igrometro a carburo
                        </span>
                        <span class="inline-flex items-center gap-2 rounded-full border border-[#D2D2D7] bg-white px-3.5 py-2 text-xs font-bold text-[#1D1D1F]">
                            <span class="h-2 w-2 rounded-full bg-[#30A14E]"></span> Collaudo certificato
                        </span>
                    </div>
                    <a class="inline-flex items-center gap-2 rounded-full border-2 border-[#0071E3] bg-white hover:bg-[#0071E3] px-6 py-3 text-sm font-semibold text-[#0071E3] hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3]" href="/metodo">Scopri le fasi del metodo <span aria-hidden="true">→</span></a>
                </div>
                <div class="method-steps flex flex-col gap-4">
                    <div class="flex items-start gap-4 rounded-2xl border border-[#D2D2D7] bg-white p-5 transition-colors duration-200 hover:border-[#0071E3]">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#0071E3] font-mono text-xs font-extrabold text-white">01</span>
                        <div>
                            <strong class="block text-base font-bold text-[#1D1D1F] mb-1">Analisi Diagnostica Strumentale</strong>
                            <small class="text-sm text-[#6E6E73] leading-relaxed block">Rilevamento termografico e igrometrico per mappare con precisione l'origine esatta dell'acqua e l'umidità del sottofondo.</small>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 rounded-2xl border border-[#D2D2D7] bg-white p-5 transition-colors duration-200 hover:border-[#0071E3]">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#0071E3] font-mono text-xs font-extrabold text-white">02</span>
                        <div>
                            <strong class="block text-base font-bold text-[#1D1D1F] mb-1">Trattamento Meccanico del Supporto</strong>
                            <small class="text-sm text-[#6E6E73] leading-relaxed block">Levigatura diamantata, ripristino giunti e applicazione del primer epossidico per una forza di adesione strutturale (&gt; 2.5 MPa).</small>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 rounded-2xl border border-[#D2D2D7] bg-white p-5 transition-colors duration-200 hover:border-[#0071E3]">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#0071E3] font-mono text-xs font-extrabold text-white">03</span>
                        <div>
                            <strong class="block text-base font-bold text-[#1D1D1F] mb-1">Spruzzatura Continua &amp; Collaudo</strong>
                            <small class="text-sm text-[#6E6E73] leading-relaxed block">Nebulizzazione a caldo (70°C, 200 bar) della membrana continua in pura poliurea e successivo collaudo idraulico certificato.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BARRA 03: BENEFICI DELLA POLIUREA -->
    <section id="poliurea" class="home-band polyurea-section" data-band="poliurea">
        <div class="home-band-bar">
            <div class="wrap home-band-bar-inner">
                <div class="home-band-title">
                    <span class="home-band-num">03</span>
