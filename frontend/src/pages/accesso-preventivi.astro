---
import '../styles/global.css';
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#05070b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/favicon-192x192.png?v=3" />
    <title>Area riservata | Poliurea System</title>
</head>
<body class="admin-body min-h-screen bg-[#0b0f17] text-slate-100">
    <div class="admin-shell w-full max-w-5xl mx-auto px-4 sm:px-6">
        <header class="admin-header flex items-center justify-between py-6 border-b border-slate-700 mb-10">
            <a class="admin-brand inline-flex items-center" href="/" aria-label="Poliurea System, home">
                <picture>
                    <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                    <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="180" height="40" />
                </picture>
            </a>
            <a class="admin-secure-label text-xs font-bold text-slate-100 hover:text-sky-400 border border-slate-600 bg-slate-800 px-3 py-1.5 rounded-lg transition" href="/">Torna al sito</a>
        </header>

        <main class="admin-login flex justify-center items-center py-8">
            <section class="admin-login-panel w-full max-w-md rounded-2xl border-2 border-slate-600 bg-slate-800 p-8 sm:p-10" aria-labelledby="login-title">
                <p class="admin-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">ACCESSO SICURO</p>
                <h2 id="login-title" class="text-2xl font-extrabold text-white tracking-tight mb-2">Accedi al tuo account</h2>
                <p class="admin-login-hint text-sm text-slate-200 mb-6">Inserisci le credenziali amministrative per continuare.</p>
                <form id="login-form" class="grid gap-4">
                    <label for="username" class="grid gap-2 text-xs font-bold text-slate-100">Nome utente</label>
                    <input type="text" id="username" name="username" autocomplete="username" required class="w-full rounded-xl border border-slate-500 bg-slate-900 p-3 text-sm text-white placeholder-slate-400 outline-none transition focus:border-sky-400" />
                    <label for="password" class="grid gap-2 text-xs font-bold text-slate-100">Password</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-500 bg-slate-900 p-3 text-sm text-white placeholder-slate-400 outline-none transition focus:border-sky-400" />
                    <button id="login-btn" type="submit" class="w-full rounded-xl bg-sky-600 p-3.5 text-sm font-bold text-white transition hover:bg-sky-500 mt-2">Accedi</button>
                </form>
                <p id="error-msg" class="mt-4 hidden rounded-lg border border-red-500 bg-red-950 p-3 text-xs font-semibold text-red-200" role="alert" aria-live="polite"></p>
            </section>
        </main>
    </div>

    <script is:inline>
        const loginForm = document.getElementById('login-form');
        const loginButton = document.getElementById('login-btn');
        const errorMessage = document.getElementById('error-msg');
        const sessionKey = 'poliurea-admin-logged';

        const mostraErrore = (messaggio) => {
            errorMessage.textContent = messaggio;
            errorMessage.classList.remove('hidden');
        };

        if (new URLSearchParams(window.location.search).has('scaduta')) {
            mostraErrore('La sessione è scaduta. Accedi di nuovo per continuare.');
        }

        loginForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            loginButton.disabled = true;
            loginButton.textContent = 'Verifica accesso...';
            errorMessage.classList.add('hidden');

            try {
                const risposta = await fetch('/api/auth/admin/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password }),
                });
                if (risposta.status === 401) throw new Error('Nome utente o password non corretti.');
                if (!risposta.ok) {
                    const err = await risposta.json().catch(() => ({}));
                    throw new Error(err.detail || `Errore del server (HTTP ${risposta.status}).`);
                }
                sessionStorage.setItem(sessionKey, '1');
                window.location.replace('/admin');
            } catch (errore) {
                mostraErrore(errore.message || 'Impossibile accedere. Riprova tra poco.');
            } finally {
                loginButton.disabled = false;
                loginButton.textContent = 'Accedi';
            }
        });
    </script>
</body>
</html>
