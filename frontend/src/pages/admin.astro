            <div class="flex items-center justify-center p-2 bg-black/50 rounded-xl border border-zinc-800/80">
                <img id="photo-viewer" class="max-h-[72vh] w-auto max-w-full rounded-lg object-contain shadow-2xl" alt="Foto allegata al preventivo" />
            </div>
        </dialog>

        <!-- Modale Editor Fullscreen: Cosa serve al cliente -->
        <dialog id="notes-dialog" class="m-auto rounded-3xl border border-zinc-800 bg-zinc-900/98 backdrop-blur-xl p-6 sm:p-8 shadow-2xl backdrop:bg-black/85 w-[96vw] max-w-5xl h-[88vh] max-h-[880px] open:flex flex-col justify-between">
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 pb-4 border-b border-zinc-800 shrink-0">
                <div>
                    <p id="notes-kicker" class="text-xs font-bold uppercase tracking-wider text-sky-400">AGGIORNAMENTO RICHIESTA</p>
                    <h2 class="text-xl sm:text-2xl font-bold text-white mt-0.5">Cosa serve al cliente</h2>
                    <p class="text-xs text-zinc-400 mt-1">Scrivi qui le indicazioni e i documenti necessari che il cliente visualizzerà nella sua area riservata.</p>
                </div>
                <button id="close-notes-btn" type="button" class="text-xs font-bold text-zinc-300 hover:text-white px-3.5 py-2 rounded-xl bg-zinc-800 border border-zinc-700 hover:border-zinc-600 transition cursor-pointer">
                    ✕ Chiudi
                </button>
            </div>

            <!-- Body: Context + Fullscreen Textarea -->
            <div class="my-4 flex-1 flex flex-col gap-3 min-h-0">
                <div id="notes-context" class="rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-3 text-xs text-zinc-400 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <span id="notes-context-service" class="font-medium text-sky-400"></span>
                    <span id="notes-context-date" class="text-zinc-500"></span>
                </div>
                <div class="relative flex-1 min-h-[260px] flex flex-col">
                    <textarea id="notes-fullscreen-input" maxlength="1200" placeholder="Descrivi chiaramente cosa serve per procedere (es. foto aggiuntive, planimetrie, conferma orari sopralluogo)..." class="w-full flex-1 rounded-2xl border border-zinc-700 bg-zinc-950 p-4 text-sm sm:text-base text-white placeholder-zinc-500 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/25 resize-none font-sans leading-relaxed"></textarea>
                    <div class="flex justify-between items-center pt-2 text-[11px] font-mono text-zinc-500">
                        <span class="text-zinc-400">Premi <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-[10px]">Ctrl</kbd> + <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-[10px]">Invio</kbd> per salvare rapidamente</span>
                        <span id="notes-char-count">0 / 1200</span>
                    </div>
                </div>
            </div>

            <!-- Footer: Save & Done Button -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-zinc-800 shrink-0">
                <div class="flex flex-wrap items-center gap-3">
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-zinc-300 cursor-pointer select-none">
                        <input id="notes-send-email-check" type="checkbox" checked class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-sky-500 focus:ring-sky-500/20 cursor-pointer" />
                        <span class="flex items-center gap-1.5 text-zinc-200">
                            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Invia email di notifica al cliente
                        </span>
                    </label>
                    <p id="notes-feedback" class="text-xs text-sky-400 font-medium"></p>
                </div>
                <div class="flex items-center gap-3">
                    <button id="cancel-notes-btn" type="button" class="px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900 text-xs font-semibold text-zinc-300 hover:text-white transition cursor-pointer">
                        Annulla
                    </button>
                    <button id="save-notes-btn" type="button" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-6 py-2.5 text-xs font-bold text-white hover:bg-sky-500 transition cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Salva e invia chiarimenti
                    </button>
                </div>
            </div>
        </dialog>

        <!-- Modale di Conferma Eliminazione con Doppia Conferma -->
        <dialog id="delete-confirm-dialog" class="m-auto rounded-3xl border border-red-500/30 bg-zinc-950 p-6 sm:p-8 shadow-2xl backdrop:bg-black/85 w-[92vw] max-w-lg">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 border border-red-500/25 text-red-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold uppercase tracking-wider text-red-400">CONFERMA ELIMINAZIONE</p>
                    <h3 id="delete-dialog-title" class="text-lg font-bold text-white mt-0.5">Sei sicuro di voler eliminare?</h3>
                    <p id="delete-dialog-desc" class="text-xs text-zinc-400 mt-1 leading-relaxed"></p>
                </div>
            </div>

            <div class="mt-5 rounded-2xl border border-zinc-800 bg-zinc-900/80 p-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-zinc-400">Elemento selezionato:</span>
                    <strong id="delete-dialog-target" class="text-white font-mono truncate max-w-[260px]"></strong>
                </div>
                <div id="delete-dialog-details" class="text-xs text-zinc-400 border-t border-zinc-800/80 pt-2 break-words"></div>
            </div>

            <!-- Box Doppia Conferma Obbligatoria -->
            <div class="mt-5">
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-red-500/30 bg-red-950/20 hover:bg-red-950/30 transition cursor-pointer select-none">
                    <input id="delete-confirm-checkbox" type="checkbox" class="w-4 h-4 mt-0.5 rounded border-zinc-700 bg-zinc-900 text-red-500 focus:ring-red-500/20 cursor-pointer" />
                    <span class="text-xs font-semibold text-red-200 leading-snug">
                        Confermo l'eliminazione definitiva. Ho compreso che l'operazione è irreversibile e non potrà essere annullata.
                    </span>
                </label>
            </div>

            <p id="delete-dialog-feedback" class="mt-3 text-xs text-red-400 hidden"></p>

            <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-zinc-800">
                <button id="delete-cancel-btn" type="button" class="px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900 text-xs font-semibold text-zinc-300 hover:text-white transition cursor-pointer">
                    Annulla
                </button>
                <button id="delete-execute-btn" type="button" disabled class="inline-flex items-center gap-2 rounded-xl bg-red-600/40 text-zinc-400 px-5 py-2.5 text-xs font-bold transition cursor-not-allowed">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    <span>Elimina definitivamente</span>
                </button>
            </div>
        </dialog>
    </div>

    <!-- is:inline dice ad Astro di non toccare questo script e passarlo puro al browser -->
    <script is:inline>
        const adminApp = document.getElementById('admin-app');
        const logoutBtn = document.getElementById('logout-btn');
        const adminTabs = document.getElementById('admin-tabs');
        const adminSummary = document.getElementById('admin-summary');
        const summaryTotal = document.getElementById('summary-total');
        const summaryAttachments = document.getElementById('summary-attachments');
        const summaryLatest = document.getElementById('summary-latest');
        const tabPreventivi = document.getElementById('tab-preventivi');
        const tabLavori = document.getElementById('tab-lavori');
        const tabClienti = document.getElementById('tab-clienti');
        const tableSection = document.getElementById('table-section');
        const worksSection = document.getElementById('works-section');
        const clientsSection = document.getElementById('clients-section');
        const dashboardError = document.getElementById('dashboard-error');
        const tableBody = document.getElementById('table-body');
        const totalCount = document.getElementById('total-count');
        const photoDialog = document.getElementById('photo-dialog');
        const photoViewer = document.getElementById('photo-viewer');
        const photoSubtitle = document.getElementById('photo-subtitle');
        const photoTitle = document.getElementById('photo-title');
        const photoLoading = document.getElementById('photo-loading');
        const downloadPhotoBtn = document.getElementById('download-photo-btn');
        let activePhotoData = null;

        const scaricaAllegato = async (prevId, allegatoId, nomeOriginale) => {
            try {
                const risposta = await fetch(`/api/preventivi/${prevId}/allegati/${allegatoId}`);
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const blob = await risposta.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = nomeOriginale || `preventivo-${prevId}-allegato-${allegatoId}.jpg`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            } catch (err) {
                console.error('Errore durante il download:', err);
                alert('Impossibile scaricare la foto.');
            }
        };

        const apriFotoGrande = async (prevId, allegatoId, nomeOriginale, nomeCliente) => {
            activePhotoData = { prevId, allegatoId, nome: nomeOriginale };
            if (photoSubtitle) photoSubtitle.textContent = `RICHIESTA #${prevId} · ${nomeCliente || 'CLIENTE'}`;
            if (photoTitle) photoTitle.textContent = nomeOriginale || 'Foto allegata';
            photoViewer.classList.add('hidden');
            if (photoLoading) photoLoading.classList.remove('hidden');
            photoDialog.showModal();

            try {
                const risposta = await fetch(`/api/preventivi/${prevId}/allegati/${allegatoId}`);
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const blob = await risposta.blob();
                if (photoViewer.src && photoViewer.src.startsWith('blob:')) {
                    URL.revokeObjectURL(photoViewer.src);
                }
                photoViewer.src = URL.createObjectURL(blob);
                photoViewer.classList.remove('hidden');
            } catch (error) {
                console.error('Errore durante il caricamento della foto:', error);
                alert('Impossibile aprire la foto allegata.');
                photoDialog.close();
            } finally {
                if (photoLoading) photoLoading.classList.add('hidden');
            }
        };

        const notesDialog = document.getElementById('notes-dialog');
        const notesKicker = document.getElementById('notes-kicker');
        const notesContextService = document.getElementById('notes-context-service');
        const notesContextDate = document.getElementById('notes-context-date');
        const notesFullscreenInput = document.getElementById('notes-fullscreen-input');
        const notesCharCount = document.getElementById('notes-char-count');
        const notesFeedback = document.getElementById('notes-feedback');
        const saveNotesBtn = document.getElementById('save-notes-btn');
        const cancelNotesBtn = document.getElementById('cancel-notes-btn');
        const closeNotesBtn = document.getElementById('close-notes-btn');

        let activeNotesContext = null;

        const aggiornaConteggioNote = () => {
            const len = (notesFullscreenInput.value || '').length;
            notesCharCount.textContent = `${len} / 1200`;
            if (len >= 1150) {
                notesCharCount.className = 'text-red-400 font-bold';
            } else {
                notesCharCount.className = 'text-zinc-500 font-mono';
            }
        };

        notesFullscreenInput.addEventListener('input', aggiornaConteggioNote);

        const notesSendEmailCheck = document.getElementById('notes-send-email-check');

        const apriEditorNote = (prev, noteInput, statoSelect, salvaStatoBtn) => {
            activeNotesContext = { prev, noteInput, statoSelect, salvaStatoBtn };
            notesKicker.textContent = `RICHIESTA #${prev.id} · ${prev.nome ? prev.nome.toUpperCase() : 'CLIENTE'}`;
            notesContextService.textContent = `Servizio: ${prev.servizio || 'Non specificato'}`;
            notesContextDate.textContent = `Ricevuto: ${formattaData(prev.data_richiesta)}`;
            notesFullscreenInput.value = noteInput.value || '';
            notesFeedback.textContent = '';
            if (notesSendEmailCheck) notesSendEmailCheck.checked = true;
            aggiornaConteggioNote();
            notesDialog.showModal();
            setTimeout(() => {
                notesFullscreenInput.focus();
                notesFullscreenInput.selectionStart = notesFullscreenInput.selectionEnd = notesFullscreenInput.value.length;
            }, 60);
        };

        const salvaNoteFullscreen = async () => {
            if (!activeNotesContext) return;
            const { prev, noteInput, statoSelect, salvaStatoBtn } = activeNotesContext;
            const nuovoTesto = notesFullscreenInput.value.trim();
            const sendEmail = notesSendEmailCheck ? notesSendEmailCheck.checked : true;

            saveNotesBtn.disabled = true;
            notesFeedback.textContent = 'Salvataggio in corso...';
            try {
                const risposta = await fetch(`/api/preventivi/${prev.id}/stato`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        stato: statoSelect.value,
                        note_cliente: nuovoTesto,
                        invia_email: sendEmail && !!nuovoTesto,
                    }),
                });
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                const data = await risposta.json();
                
                noteInput.value = nuovoTesto;
                prev.note_cliente = nuovoTesto;
                prev.stato = statoSelect.value;
                if (data.email_inviata) {
                    salvaStatoBtn.textContent = 'Salvato & Email inviata!';
                    salvaStatoBtn.className = 'rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-emerald-500/20 transition cursor-pointer';
                    notesFeedback.textContent = 'Chiarimenti salvati ed email inviata con successo al cliente!';
                } else {
                    salvaStatoBtn.textContent = 'Salvato';
                    salvaStatoBtn.className = 'rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-sky-500 transition cursor-pointer';
                    notesFeedback.textContent = 'Modifiche salvate con successo.';
                }
                setTimeout(() => {
                    salvaStatoBtn.textContent = 'Salva aggiornamento';
                    salvaStatoBtn.className = 'rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-sky-500 transition cursor-pointer';
                }, 2500);

                setTimeout(() => {
                    notesDialog.close();
                    activeNotesContext = null;
                }, 900);
            } catch (err) {
                notesFeedback.textContent = `Errore durante il salvataggio: ${err.message}`;
            } finally {
                saveNotesBtn.disabled = false;
            }
        };

        saveNotesBtn.addEventListener('click', salvaNoteFullscreen);
        cancelNotesBtn.addEventListener('click', () => notesDialog.close());
        closeNotesBtn.addEventListener('click', () => notesDialog.close());
        notesDialog.addEventListener('click', (evento) => {
            if (evento.target === notesDialog) notesDialog.close();
        });
        notesFullscreenInput.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                salvaNoteFullscreen();
            }
        });

        // Gestione Modale Eliminazione con Doppia Conferma
        const deleteDialog = document.getElementById('delete-confirm-dialog');
        const deleteDialogTitle = document.getElementById('delete-dialog-title');
        const deleteDialogDesc = document.getElementById('delete-dialog-desc');
        const deleteDialogTarget = document.getElementById('delete-dialog-target');
        const deleteDialogDetails = document.getElementById('delete-dialog-details');
        const deleteConfirmCheckbox = document.getElementById('delete-confirm-checkbox');
        const deleteExecuteBtn = document.getElementById('delete-execute-btn');
        const deleteCancelBtn = document.getElementById('delete-cancel-btn');
        const deleteDialogFeedback = document.getElementById('delete-dialog-feedback');

        let pendingDeleteAction = null;

        const apriConfermaEliminazione = ({ tipo, id, titolo, target, dettagli, onConfirm }) => {
            pendingDeleteAction = onConfirm;
            deleteDialogTitle.textContent = titolo || 'Conferma eliminazione';
            deleteDialogDesc.textContent = tipo === 'preventivo'
                ? 'Questa operazione eliminerà definitivamente la richiesta di preventivo e tutti gli allegati e foto caricati.'
                : tipo === 'lavoro'
                    ? 'Questa operazione eliminerà definitivamente il lavoro dalla pagina /lavori insieme a tutte le foto Prima, Dopo e ai video caricati.'
                    : 'Questa operazione eliminerà definitivamente l\'account cliente. L\'utente non potrà più effettuare l\'accesso all\'Area Clienti.';
            deleteDialogTarget.textContent = target || `#${id}`;
            deleteDialogDetails.textContent = dettagli || '';
            deleteConfirmCheckbox.checked = false;
            deleteExecuteBtn.disabled = true;
            deleteExecuteBtn.className = 'inline-flex items-center gap-2 rounded-xl bg-red-600/40 text-zinc-400 px-5 py-2.5 text-xs font-bold transition cursor-not-allowed';
            deleteDialogFeedback.classList.add('hidden');
            deleteDialogFeedback.textContent = '';
            deleteDialog.showModal();
        };

        deleteConfirmCheckbox?.addEventListener('change', () => {
            const isChecked = deleteConfirmCheckbox.checked;
            deleteExecuteBtn.disabled = !isChecked;
            if (isChecked) {
                deleteExecuteBtn.className = 'inline-flex items-center gap-2 rounded-xl bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-600/25 px-5 py-2.5 text-xs font-bold transition cursor-pointer';
            } else {
                deleteExecuteBtn.className = 'inline-flex items-center gap-2 rounded-xl bg-red-600/40 text-zinc-400 px-5 py-2.5 text-xs font-bold transition cursor-not-allowed';
            }
        });

        deleteCancelBtn?.addEventListener('click', () => {
            deleteDialog.close();
            pendingDeleteAction = null;
        });

        deleteDialog?.addEventListener('click', (e) => {
            if (e.target === deleteDialog) {
                deleteDialog.close();
                pendingDeleteAction = null;
            }
        });

        deleteExecuteBtn?.addEventListener('click', async () => {
            if (!pendingDeleteAction || !deleteConfirmCheckbox.checked) return;
            deleteExecuteBtn.disabled = true;
            deleteExecuteBtn.textContent = 'Eliminazione in corso...';
            try {
                await pendingDeleteAction();
                deleteDialog.close();
                pendingDeleteAction = null;
            } catch (err) {
                deleteDialogFeedback.textContent = `Errore durante l'eliminazione: ${err.message}`;
                deleteDialogFeedback.classList.remove('hidden');
            } finally {
                deleteExecuteBtn.disabled = false;
