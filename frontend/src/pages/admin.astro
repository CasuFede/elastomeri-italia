---
import '../styles/global.css';
// frontend/src/pages/admin.astro
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gestione preventivi | Poliurea System</title>
</head>
<body class="admin-body min-h-screen bg-black text-zinc-200">

    <div id="admin-app" class="admin-shell w-full max-w-7xl mx-auto px-4 sm:px-6 hidden">
        <header class="admin-header flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-6 border-b border-zinc-800 mb-8">
            <div class="flex items-center justify-between gap-4">
                <a class="admin-brand inline-flex items-center" href="/" aria-label="Poliurea System, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="180" height="40" />
                    </picture>
                </a>
                <span class="sm:hidden admin-secure-label border border-zinc-800 bg-zinc-900 text-zinc-400 px-3 py-1.5 rounded-lg text-xs font-semibold">Area riservata</span>
            </div>
            <div class="admin-header-title">
                <p class="text-[11px] font-bold uppercase tracking-wider text-sky-400">AREA GESTIONE</p>
                <h1 class="text-xl sm:text-2xl font-bold text-white">Gestione preventivi</h1>
            </div>
            <span class="hidden sm:inline-flex admin-secure-label border border-zinc-800 bg-zinc-900 text-zinc-400 px-3 py-1.5 rounded-lg text-xs font-semibold">Area riservata</span>
        </header>

        <p id="dashboard-error" class="hidden mb-5 rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-400" role="alert"></p>

        <nav id="admin-tabs" class="mb-8 hidden flex-wrap items-center justify-between gap-3" aria-label="Sezioni amministrazione">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Contenuti">
                <button id="tab-preventivi" type="button" role="tab" aria-selected="true" aria-controls="table-section" class="rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/20">Preventivi</button>
                <button id="tab-lavori" type="button" role="tab" aria-selected="false" aria-controls="works-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Lavori e immagini</button>
                <button id="tab-clienti" type="button" role="tab" aria-selected="false" aria-controls="clients-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Account clienti</button>
            </div>
            <button id="logout-btn" type="button" class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-sm font-bold text-red-400 hover:border-red-500/30 hover:bg-red-500/10 transition">Esci dal pannello</button>
        </nav>

        <section id="admin-summary" class="admin-summary hidden grid gap-4 sm:grid-cols-3 mb-8" aria-label="Riepilogo preventivi">
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Richieste totali</span><strong id="summary-total" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">Preventivi ricevuti</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Foto e allegati</span><strong id="summary-attachments" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">File nelle richieste</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Ultima richiesta</span><strong id="summary-latest" class="block text-2xl font-extrabold text-white mt-1">Nessuna</strong><small class="text-xs text-zinc-500 mt-1 block">Data di ricezione</small></article>
        </section>

        <!-- SEZIONE TABELLA (Nascosta di default) -->
        <div id="table-section" class="hidden w-full overflow-x-auto rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl">
            <div class="admin-table-toolbar flex items-center justify-between gap-4 border-b border-zinc-800 bg-zinc-900/80 p-5">
                <div>
                    <p class="admin-table-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">RICHIESTE IN INGRESSO</p>
                    <span class="text-base font-bold text-white sm:text-lg">Totale richieste</span>
                </div>
                <span id="total-count" class="admin-count rounded-full border border-sky-500/30 bg-sky-500/10 px-3 py-1 font-mono text-sm font-bold text-sky-400">0</span>
            </div>
            <table class="w-full min-w-[1560px] border-collapse text-left text-sm">
                <thead>
                    <tr class="bg-zinc-950 text-zinc-400 border-b border-zinc-800 text-xs uppercase tracking-wider">
                        <th class="p-4">ID</th>
                        <th class="p-4">Data</th>
                        <th class="p-4">Nome</th>
                        <th class="p-4">Contatti</th>
                        <th class="p-4">Servizio</th>
                        <th class="p-4">Messaggio</th>
                        <th class="p-4">Foto</th>
                        <th class="p-4">Stato</th>
                        <th class="p-4">Cosa serve al cliente</th>
                    </tr>
                </thead>
                <tbody id="table-body" class="divide-y divide-zinc-800 text-zinc-300">
                    <!-- I dati verranno inseriti qui -->
                </tbody>
            </table>
        </div>
        <section id="works-section" class="hidden w-full" aria-labelledby="tab-lavori">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Contenuti del sito</p>
                    <h2 class="text-2xl font-bold text-white sm:text-3xl">Lavori e immagini</h2>
                    <p class="mt-2 max-w-2xl text-sm text-zinc-400">Pubblica un intervento nella galleria e aggiorna testi o immagini quando vuoi.</p>
                </div>
            </div>
            <form id="work-form" class="mb-8 grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:grid-cols-2 shadow-xl">
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Titolo
                    <input name="titolo" required maxlength="160" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Località
                    <input name="localita" maxlength="160" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">Descrizione
                    <textarea name="descrizione" maxlength="3000" rows="3" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"></textarea>
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">Immagine (JPG, PNG o WEBP, massimo 10 MB)
                    <input name="immagine" type="file" accept="image/jpeg,image/png,image/webp" required class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-zinc-300 file:mr-4 file:rounded-lg file:border-0 file:bg-sky-500 file:px-4 file:py-2 file:text-xs file:font-bold file:text-white file:cursor-pointer hover:file:bg-sky-400" />
                </label>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2 pt-2">
                    <button id="work-submit" type="submit" class="rounded-xl bg-sky-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-400 hover:-translate-y-0.5">Pubblica nella galleria</button>
                    <p id="work-feedback" class="text-sm text-zinc-300" role="status" aria-live="polite"></p>
                </div>
            </form>
            <div id="works-list" class="grid gap-4"></div>
        </section>
        <section id="clients-section" class="hidden w-full" aria-labelledby="tab-clienti">
            <div class="mb-6">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Area clienti</p>
                <h2 class="text-2xl font-bold text-white sm:text-3xl">Crea un account cliente</h2>
                <p class="mt-2 max-w-3xl text-sm text-zinc-400">Il cliente vedrà solo le richieste associate alla stessa email. Condividi le credenziali iniziali tramite un canale sicuro.</p>
            </div>
            <form id="client-form" class="mb-8 grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:grid-cols-2 shadow-xl">
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Nome cliente
                    <input name="nome" required maxlength="160" autocomplete="name" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Email usata nel preventivo
                    <input name="email" type="email" required maxlength="254" autocomplete="email" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">Password iniziale (almeno 12 caratteri)
                    <input name="password" type="password" required minlength="12" autocomplete="new-password" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2 pt-2">
                    <button id="client-submit" type="submit" class="rounded-xl bg-sky-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-400 hover:-translate-y-0.5">Crea account</button>
                    <p id="client-feedback" class="text-sm text-zinc-300" role="status" aria-live="polite"></p>
                </div>
            </form>
            <div class="mb-4">
                <h3 class="text-lg font-bold text-white">Account esistenti</h3>
            </div>
            <div id="clients-list" class="grid gap-3"></div>
        </section>
        <dialog id="photo-dialog" class="m-auto rounded-2xl border border-zinc-800 bg-zinc-900 p-4 sm:p-6 shadow-2xl backdrop:bg-black/80 max-w-[calc(100vw-2rem)] sm:max-w-3xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between gap-4 pb-3 sm:pb-4 border-b border-zinc-800 mb-4 sticky top-0 bg-zinc-900 z-10">
                <h2 class="font-bold text-white text-sm sm:text-base">Foto allegata</h2>
                <button id="close-photo-btn" type="button" class="text-xs font-bold text-zinc-400 hover:text-white px-2.5 py-1 rounded-lg bg-zinc-800 border border-zinc-700 transition">Chiudi</button>
            </div>
            <div class="flex items-center justify-center">
                <img id="photo-viewer" class="max-h-[70vh] w-auto max-w-full rounded-xl object-contain border border-zinc-800" alt="Foto allegata al preventivo" />
            </div>
        </dialog>
    </div>

    <!-- is:inline dice ad Astro di non toccare questo script e passarlo puro al browser -->
    <script is:inline>
        const adminApp = document.getElementById('admin-app');
        const logoutBtn = document.getElementById('logout-btn');
        const adminTabs = document.getElementById('admin-tabs');
        const adminSummary = document.getElementById('admin-summary');
        const summaryTotal = document.getElementById('summary-total');
        const summaryAttachments = document.getElementById('summary-attachments');
        const summaryLatest = document.getElementById('summary-latest');
        const tabPreventivi = document.getElementById('tab-preventivi');
        const tabLavori = document.getElementById('tab-lavori');
        const tabClienti = document.getElementById('tab-clienti');
        const tableSection = document.getElementById('table-section');
        const worksSection = document.getElementById('works-section');
        const clientsSection = document.getElementById('clients-section');
        const dashboardError = document.getElementById('dashboard-error');
        const tableBody = document.getElementById('table-body');
        const totalCount = document.getElementById('total-count');
        const photoDialog = document.getElementById('photo-dialog');
        const photoViewer = document.getElementById('photo-viewer');
        const workForm = document.getElementById('work-form');
        const workFeedback = document.getElementById('work-feedback');
        const worksList = document.getElementById('works-list');
        const workSubmit = document.getElementById('work-submit');
        const clientForm = document.getElementById('client-form');
        const clientSubmit = document.getElementById('client-submit');
        const clientFeedback = document.getElementById('client-feedback');
        const clientsList = document.getElementById('clients-list');
        const sessionKey = 'poliurea-admin-logged';
        let isLogged = sessionStorage.getItem(sessionKey) === '1';

        if (!isLogged) {
            window.location.replace('/accesso-preventivi');
        }

        window.addEventListener('pageshow', () => {
            if (sessionStorage.getItem(sessionKey) !== '1') window.location.replace('/accesso-preventivi');
        });

        const formattaData = (dataIso) => {
            if (!dataIso) return '-';
            const data = new Date(dataIso);
            if (Number.isNaN(data.getTime())) return '-';
            return data.toLocaleString('it-IT', { 
                day: '2-digit', month: '2-digit', year: 'numeric', 
                hour: '2-digit', minute: '2-digit' 
            });
        };

        const creaCella = (contenuto, className = '') => {
            const cella = document.createElement('td');
            cella.className = className;
            cella.textContent = contenuto ?? '-';
            return cella;
        };

        const mostraFeedbackLavori = (messaggio, errore = false) => {
            workFeedback.textContent = messaggio;
            workFeedback.className = errore ? 'text-xs text-red-400' : 'text-xs text-sky-400';
        };

        const creaCampoLavoro = (etichetta, valore, multilinea = false) => {
            const contenitore = document.createElement('label');
            contenitore.className = 'grid gap-2 text-xs font-semibold text-zinc-300';
            contenitore.append(document.createTextNode(etichetta));
            const campo = document.createElement(multilinea ? 'textarea' : 'input');
            campo.className = 'w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20';
            campo.value = valore || '';
            if (multilinea) {
                campo.rows = 3;
                campo.maxLength = 3000;
            } else {
                campo.maxLength = etichetta === 'Titolo' ? 160 : 160;
            }
            contenitore.appendChild(campo);
            return { contenitore, campo };
        };

        const caricaLavori = async () => {
            try {
                const risposta = await fetch('/api/lavori');
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const risultato = await risposta.json();
                if (!Array.isArray(risultato.dati)) throw new Error('Formato della risposta non valido.');
                worksList.replaceChildren();
                if (!risultato.dati.length) {
                    const vuoto = document.createElement('p');
                    vuoto.className = 'rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-400';
                    vuoto.textContent = 'La galleria è vuota. Pubblica il primo lavoro dal modulo qui sopra.';
                    worksList.appendChild(vuoto);
                    return;
                }

                risultato.dati.forEach((lavoro) => {
                    const scheda = document.createElement('article');
                    scheda.className = 'grid gap-5 rounded-2xl border border-zinc-800 bg-zinc-900 p-5 shadow-xl md:grid-cols-[240px_1fr]';
                    const anteprima = document.createElement('img');
                    anteprima.className = 'aspect-[4/3] w-full rounded-xl bg-zinc-950 object-cover border border-zinc-800';
                    anteprima.src = lavoro.immagine_url;
                    anteprima.alt = `Lavoro: ${lavoro.titolo}`;
                    scheda.appendChild(anteprima);

                    const colonna = document.createElement('div');
                    colonna.className = 'grid content-start gap-4';
                    const editor = document.createElement('div');
                    editor.className = 'grid gap-3 sm:grid-cols-2';
                    const titolo = creaCampoLavoro('Titolo', lavoro.titolo);
                    const localita = creaCampoLavoro('Località', lavoro.localita);
                    const descrizione = creaCampoLavoro('Descrizione', lavoro.descrizione, true);
                    descrizione.contenitore.classList.add('sm:col-span-2');
                    editor.append(titolo.contenitore, localita.contenitore, descrizione.contenitore);
                    colonna.appendChild(editor);

                    const azioni = document.createElement('div');
                    azioni.className = 'flex flex-wrap items-center gap-3';
                    const salva = document.createElement('button');
                    salva.type = 'button';
                    salva.className = 'rounded-xl bg-sky-500 px-4 py-2 text-xs font-bold text-white shadow-md shadow-sky-500/20 transition hover:bg-sky-400';
                    salva.textContent = 'Salva modifiche';
                    salva.addEventListener('click', async () => {
                        salva.disabled = true;
                        try {
                            const risposta = await fetch(`/api/lavori/${lavoro.id}`, {
                                method: 'PATCH',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    titolo: titolo.campo.value,
                                    localita: localita.campo.value,
                                    descrizione: descrizione.campo.value,
                                }),
                            });
                            if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                            mostraFeedbackLavori('Modifiche salvate.');
                            await caricaLavori();
                        } catch (errore) {
                            mostraFeedbackLavori(`Impossibile salvare: ${errore.message}`, true);
                        } finally {
                            salva.disabled = false;
                        }
                    });
                    azioni.appendChild(salva);

                    const sostituisci = document.createElement('label');
                    sostituisci.className = 'cursor-pointer rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-semibold text-zinc-200 hover:border-sky-500 hover:text-white transition';
                    sostituisci.textContent = 'Sostituisci immagine';
                    const file = document.createElement('input');
                    file.type = 'file';
                    file.accept = 'image/jpeg,image/png,image/webp';
                    file.className = 'sr-only';
                    file.addEventListener('change', async () => {
                        if (!file.files.length) return;
                        const modulo = new FormData();
                        modulo.append('immagine', file.files[0]);
                        try {
                            const risposta = await fetch(`/api/lavori/${lavoro.id}/immagine`, {
                                method: 'PUT',
                                body: modulo,
                            });
                            if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                            mostraFeedbackLavori('Immagine sostituita.');
                            await caricaLavori();
                        } catch (errore) {
                            mostraFeedbackLavori(`Impossibile sostituire l’immagine: ${errore.message}`, true);
                        }
                    });
                    sostituisci.appendChild(file);
                    azioni.appendChild(sostituisci);

                    const elimina = document.createElement('button');
                    elimina.type = 'button';
                    elimina.className = 'rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2 text-xs font-semibold text-red-400 hover:border-red-500/30 hover:bg-red-500/10 transition';
                    elimina.textContent = 'Elimina lavoro';
                    elimina.addEventListener('click', async () => {
                        if (!confirm(`Eliminare "${lavoro.titolo}" dalla galleria?`)) return;
                        try {
                            const risposta = await fetch(`/api/lavori/${lavoro.id}`, {
                                method: 'DELETE',
                            });
                            if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                            mostraFeedbackLavori('Lavoro eliminato.');
                            await caricaLavori();
                        } catch (errore) {
                            mostraFeedbackLavori(`Impossibile eliminare: ${errore.message}`, true);
                        }
                    });
                    azioni.appendChild(elimina);
                    colonna.appendChild(azioni);
                    scheda.appendChild(colonna);
                    worksList.appendChild(scheda);
                });
            } catch (errore) {
                mostraFeedbackLavori(`Impossibile caricare la galleria: ${errore.message}`, true);
            }
        };

        const mostraFeedbackClienti = (messaggio, errore = false) => {
            clientFeedback.textContent = messaggio;
            clientFeedback.className = errore ? 'text-xs text-red-400' : 'text-xs text-sky-400';
        };

        const caricaClienti = async () => {
            try {
                const risposta = await fetch('/api/clienti');
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                const risultato = await risposta.json();
                if (!Array.isArray(risultato.dati)) throw new Error('Formato della risposta non valido.');
                clientsList.replaceChildren();
                if (!risultato.dati.length) {
                    const vuoto = document.createElement('p');
                    vuoto.className = 'rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-400';
                    vuoto.textContent = 'Non ci sono ancora account clienti.';
                    clientsList.appendChild(vuoto);
                    return;
                }
                risultato.dati.forEach((cliente) => {
                    const scheda = document.createElement('article');
                    scheda.className = 'flex flex-wrap items-center justify-between gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-5 shadow-lg';
                    const informazioni = document.createElement('div');
                    informazioni.className = 'grid gap-1';
                    const nome = document.createElement('strong');
                    nome.className = 'text-base font-bold text-white';
                    nome.textContent = cliente.nome;
                    const email = document.createElement('span');
                    email.className = 'text-xs text-zinc-400 font-mono';
                    email.textContent = cliente.email;
                    informazioni.append(nome, email);
                    const richieste = document.createElement('span');
                    richieste.className = 'rounded-lg border border-sky-500/30 bg-sky-500/10 px-3 py-1 text-xs font-mono font-bold text-sky-400';
                    richieste.textContent = `${cliente.preventivi} ${cliente.preventivi === 1 ? 'preventivo' : 'preventivi'}`;
                    scheda.append(informazioni, richieste);
                    clientsList.appendChild(scheda);
                });
            } catch (errore) {
                mostraFeedbackClienti(`Impossibile caricare gli account: ${errore.message}`, true);
            }
        };

        clientForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            clientSubmit.disabled = true;
            mostraFeedbackClienti('Creazione account in corso...');
            const dati = new FormData(clientForm);
            try {
                const risposta = await fetch('/api/clienti', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        nome: dati.get('nome'),
                        email: dati.get('email'),
                        password: dati.get('password'),
                    }),
                });
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                const cliente = await risposta.json();
                clientForm.reset();
                mostraFeedbackClienti(`Account creato per ${cliente.email}.`);
                await caricaClienti();
            } catch (errore) {
                mostraFeedbackClienti(`Impossibile creare l’account: ${errore.message}`, true);
            } finally {
                clientSubmit.disabled = false;
            }
        });

        workForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            workSubmit.disabled = true;
            mostraFeedbackLavori('Caricamento in corso...');
            try {
                const risposta = await fetch('/api/lavori', {
                    method: 'POST',
                    body: new FormData(workForm),
                });
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                workForm.reset();
                mostraFeedbackLavori('Lavoro pubblicato nella galleria.');
                await caricaLavori();
            } catch (errore) {
                mostraFeedbackLavori(`Impossibile pubblicare: ${errore.message}`, true);
            } finally {
                workSubmit.disabled = false;
            }
        });

        const mostraSchedaAdmin = (sezione) => {
            const mostraLavori = sezione === 'lavori';
            const mostraClienti = sezione === 'clienti';
            tableSection.classList.toggle('hidden', mostraLavori || mostraClienti);
            worksSection.classList.toggle('hidden', !mostraLavori);
            clientsSection.classList.toggle('hidden', !mostraClienti);
            tabPreventivi.setAttribute('aria-selected', String(sezione === 'preventivi'));
            tabLavori.setAttribute('aria-selected', String(mostraLavori));
            tabClienti.setAttribute('aria-selected', String(mostraClienti));
            const classeAttiva = 'rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/20';
            const classeInattiva = 'rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white transition';
            tabPreventivi.className = sezione === 'preventivi' ? classeAttiva : classeInattiva;
            tabLavori.className = mostraLavori ? classeAttiva : classeInattiva;
            tabClienti.className = mostraClienti ? classeAttiva : classeInattiva;
            if (mostraLavori) caricaLavori();
            if (mostraClienti) caricaClienti();
        };

        tabPreventivi.addEventListener('click', () => mostraSchedaAdmin('preventivi'));
        tabLavori.addEventListener('click', () => mostraSchedaAdmin('lavori'));
        tabClienti.addEventListener('click', () => mostraSchedaAdmin('clienti'));

        const caricaPreventivi = async () => {
            if (!isLogged) {
                window.location.replace('/accesso-preventivi');
                return;
            }
            try {
                const response = await fetch('/api/preventivi');

                if (response.status === 401) {
                    sessionStorage.removeItem(sessionKey);
                    window.location.replace('/accesso-preventivi?scaduta');
                    return;
                }

                if (!response.ok) {
                    throw new Error(`Il server ha risposto con errore HTTP ${response.status}.`);
                }

                const data = await response.json();
                if (!Array.isArray(data.dati)) {
                    throw new Error('Formato della risposta API non valido.');
                }
                
                adminApp.classList.remove('hidden');
                dashboardError.classList.add('hidden');
                adminTabs.classList.remove('hidden');
                adminTabs.classList.add('flex');
                mostraSchedaAdmin('preventivi');
                
                totalCount.textContent = data.dati.length;
                summaryTotal.textContent = data.dati.length;
                summaryAttachments.textContent = data.dati.reduce((totale, preventivo) => totale + (Array.isArray(preventivo.allegati) ? preventivo.allegati.length : 0), 0);
                summaryLatest.textContent = data.dati.length ? formattaData(data.dati[0].data_richiesta) : 'Nessuna';
                adminSummary.classList.remove('hidden');
                tableBody.innerHTML = ''; 

                if (data.dati.length === 0) {
                    const tr = document.createElement('tr');
                    const cella = creaCella('Nessun preventivo ricevuto.', 'p-6 text-center text-zinc-400');
                    cella.colSpan = 9;
                    tr.appendChild(cella);
                    tableBody.appendChild(tr);
                } else {
                    data.dati.forEach(prev => {
                        const tr = document.createElement('tr');
                        tr.className = 'border-b border-zinc-800/80 hover:bg-zinc-800/30 transition-colors';
                        tr.appendChild(creaCella(`#${prev.id}`, 'p-4 font-mono font-bold text-sky-400'));
                        tr.appendChild(creaCella(formattaData(prev.data_richiesta), 'p-4 whitespace-nowrap text-xs text-zinc-400'));
                        tr.appendChild(creaCella(prev.nome, 'p-4 font-semibold text-white'));

                        const contatti = document.createElement('td');
                        contatti.className = 'p-4';
                        if (prev.email) {
                            const email = document.createElement('a');
                            email.href = `mailto:${prev.email}`;
                            email.className = 'block text-sky-400 hover:text-sky-300 text-xs font-medium';
                            email.textContent = prev.email;
                            contatti.appendChild(email);
                        }
                        const telefono = document.createElement('a');
                        const telPulito = (prev.telefono || '').replace(/[^\d+]/g, '');
                        telefono.href = telPulito ? `tel:${telPulito}` : '#';
                        telefono.className = 'text-zinc-300 hover:text-sky-400 text-xs font-medium';
                        telefono.textContent = prev.telefono ?? '-';
                        contatti.appendChild(telefono);
                        tr.appendChild(contatti);

                        const servizio = document.createElement('td');
                        servizio.className = 'p-4';
                        const badge = document.createElement('span');
                        badge.className = 'inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-2.5 py-1 text-xs font-bold text-sky-400';
                        badge.textContent = prev.servizio ?? '-';
                        servizio.appendChild(badge);
                        tr.appendChild(servizio);

                        const messaggio = creaCella(prev.messaggio || '-', 'max-w-xs whitespace-pre-wrap p-4 text-xs text-zinc-300');
                        messaggio.title = prev.messaggio || '';
                        tr.appendChild(messaggio);

                        const foto = document.createElement('td');
                        foto.className = 'p-4';
                        for (const allegato of prev.allegati || []) {
                            const apriFoto = document.createElement('button');
                            apriFoto.type = 'button';
                            apriFoto.className = 'block text-sky-400 hover:text-sky-300 text-xs font-medium underline';
                            apriFoto.textContent = allegato.nome;
                            apriFoto.addEventListener('click', async () => {
                                try {
                                    const risposta = await fetch(`/api/preventivi/${prev.id}/allegati/${allegato.id}`);
                                    if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                                    photoViewer.src = URL.createObjectURL(await risposta.blob());
                                    photoDialog.showModal();
                                } catch (error) {
                                    console.error('Errore durante il caricamento della foto:', error);
                                    alert('Impossibile aprire la foto allegata.');
                                }
                            });
                            foto.appendChild(apriFoto);
                        }
                        if (!foto.childElementCount) foto.textContent = '-';
                        tr.appendChild(foto);

                        const statoCella = document.createElement('td');
                        statoCella.className = 'p-4';
                        const statoSelect = document.createElement('select');
                        statoSelect.className = 'min-w-44 rounded-xl border border-zinc-700 bg-zinc-950 p-2.5 text-xs text-white outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20';
                        statoSelect.setAttribute('aria-label', `Stato richiesta ${prev.id}`);
                        const stati = [
                            ['ricevuto', 'Ricevuto'],
                            ['in_valutazione', 'In valutazione'],
                            ['preventivo_inviato', 'Preventivo inviato'],
                            ['in_lavorazione', 'In lavorazione'],
                            ['completato', 'Completato'],
                            ['annullato', 'Annullato'],
                        ];
                        stati.forEach(([valore, etichetta]) => {
                            const opzione = document.createElement('option');
                            opzione.value = valore;
                            opzione.textContent = etichetta;
                            statoSelect.appendChild(opzione);
                        });
                        statoSelect.value = prev.stato || 'ricevuto';
                        statoCella.appendChild(statoSelect);
                        tr.appendChild(statoCella);

                        const noteCella = document.createElement('td');
                        noteCella.className = 'min-w-72 p-4';
                        const noteInput = document.createElement('textarea');
                        noteInput.className = 'mb-2 min-h-20 w-full rounded-xl border border-zinc-700 bg-zinc-950 p-2.5 text-xs text-white placeholder-zinc-500 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20';
                        noteInput.maxLength = 1200;
                        noteInput.placeholder = 'Cosa serve al cliente?';
                        noteInput.setAttribute('aria-label', `Cosa serve al cliente per la richiesta ${prev.id}`);
                        noteInput.value = prev.note_cliente || '';
                        const salvaStato = document.createElement('button');
                        salvaStato.type = 'button';
                        salvaStato.className = 'rounded-lg bg-sky-500 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-sky-500/20 hover:bg-sky-400 transition';
                        salvaStato.textContent = 'Salva aggiornamento';
                        salvaStato.addEventListener('click', async () => {
                            salvaStato.disabled = true;
                            try {
                                const risposta = await fetch(`/api/preventivi/${prev.id}/stato`, {
                                    method: 'PATCH',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    body: JSON.stringify({ stato: statoSelect.value, note_cliente: noteInput.value }),
                                });
                                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                                salvaStato.textContent = 'Salvato';
                                setTimeout(() => { salvaStato.textContent = 'Salva aggiornamento'; }, 1800);
                            } catch (errore) {
                                salvaStato.textContent = 'Errore';
                                dashboardError.textContent = `Aggiornamento non salvato: ${errore.message}`;
                                dashboardError.classList.remove('hidden');
                            } finally {
                                salvaStato.disabled = false;
                            }
                        });
                        noteCella.append(noteInput, salvaStato);
                        tr.appendChild(noteCella);
                        tableBody.appendChild(tr);
                    });
                }

            } catch (error) {
                console.error("Errore fetch:", error);
                dashboardError.textContent = error instanceof Error ? error.message : 'Errore durante il caricamento dei dati. Verifica la connessione e riprova.';
                dashboardError.classList.remove('hidden');
            }
        };

        logoutBtn.addEventListener('click', async () => {
            tableSection.classList.add('hidden');
            worksSection.classList.add('hidden');
            adminTabs.classList.add('hidden');
            adminTabs.classList.remove('flex');
            adminSummary.classList.add('hidden');
            sessionStorage.removeItem(sessionKey);
            tableBody.innerHTML = '';
            worksList.replaceChildren();
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (_) {}
            window.location.replace('/accesso-preventivi');
        });

        document.getElementById('close-photo-btn').addEventListener('click', () => photoDialog.close());
        photoDialog.addEventListener('click', (evento) => {
            if (evento.target === photoDialog) photoDialog.close();
        });
        photoDialog.addEventListener('close', () => {
            URL.revokeObjectURL(photoViewer.src);
            photoViewer.removeAttribute('src');
        });

        if (isLogged) caricaPreventivi();
    </script>
</body>
</html>