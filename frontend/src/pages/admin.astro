        const ottimizzaImmagineBrowser = async (file) => {
            if (!file || !file.type.startsWith('image/')) return file;
            if (file.size <= 900 * 1024) return file;
            try {
                const bitmap = await createImageBitmap(file);
                const maxLato = 1800;
                const scala = Math.min(1, maxLato / Math.max(bitmap.width, bitmap.height));
                const w = Math.max(1, Math.round(bitmap.width * scala));
                const h = Math.max(1, Math.round(bitmap.height * scala));
                const canvas = document.createElement('canvas');
                canvas.width = w;
                canvas.height = h;
                const ctx = canvas.getContext('2d');
                if (!ctx) {
                    bitmap.close();
                    return file;
                }
                ctx.drawImage(bitmap, 0, 0, w, h);
                bitmap.close();

                const mimeOut = file.type === 'image/png' ? 'image/webp' : 'image/jpeg';
                const extOut = mimeOut === 'image/webp' ? '.webp' : '.jpg';
                const blob = await new Promise((resolve) => canvas.toBlob(resolve, mimeOut, 0.85));
                if (!blob || blob.size >= file.size) return file;
                const baseName = (file.name || 'foto').replace(/\.[^.]+$/, '');
                return new File([blob], `${baseName}${extOut}`, { type: mimeOut });
            } catch {
                return file;
            }
        };

        const estraiMetadataVideoBrowser = (file) =>
            new Promise((resolve) => {
                const url = URL.createObjectURL(file);
                const video = document.createElement('video');
                video.muted = true;
                video.playsInline = true;
                video.preload = 'metadata';
                let risolto = false;

                const chiudi = (risultato) => {
                    if (risolto) return;
                    risolto = true;
                    clearTimeout(timer);
                    video.removeAttribute('src');
                    video.load();
                    URL.revokeObjectURL(url);
                    resolve(risultato);
                };

                const timer = setTimeout(() => chiudi({ durata: '', posterFile: null, previewUrl: '' }), 4500);

                video.addEventListener('loadedmetadata', () => {
                    const durata = formattaDurataSecondi(video.duration);
                    const targetTime = Number.isFinite(video.duration) && video.duration > 1.2 ? Math.min(1.5, video.duration / 3) : 0.1;
                    try {
                        video.currentTime = targetTime;
                    } catch {
                        chiudi({ durata, posterFile: null, previewUrl: '' });
                    }
                });

                video.addEventListener('seeked', () => {
                    const durata = formattaDurataSecondi(video.duration);
                    try {
                        const maxW = 1080;
                        const vw = video.videoWidth || 1280;
                        const vh = video.videoHeight || 720;
                        const scala = Math.min(1, maxW / Math.max(vw, vh));
                        const canvas = document.createElement('canvas');
                        canvas.width = Math.max(1, Math.round(vw * scala));
                        canvas.height = Math.max(1, Math.round(vh * scala));
                        const ctx = canvas.getContext('2d');
                        if (!ctx) {
                            chiudi({ durata, posterFile: null, previewUrl: '' });
                            return;
                        }
                        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                        canvas.toBlob(
                            (blob) => {
                                if (!blob) {
                                    chiudi({ durata, posterFile: null, previewUrl: '' });
                                    return;
                                }
                                const posterFile = new File([blob], 'poster.jpg', { type: 'image/jpeg' });
                                const previewUrl = URL.createObjectURL(blob);
                                chiudi({ durata, posterFile, previewUrl });
                            },
                            'image/jpeg',
                            0.84
                        );
                    } catch {
                        chiudi({ durata, posterFile: null, previewUrl: '' });
                    }
                });

                video.addEventListener('error', () => chiudi({ durata: '', posterFile: null, previewUrl: '' }));
                video.src = url;
            });

