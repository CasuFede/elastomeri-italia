---
import '../styles/global.css';
// frontend/src/pages/admin.astro

const adminCookie = Astro.cookies.get('poliurea_admin_session')?.value;
if (!adminCookie) {
  return Astro.redirect('/accesso-preventivi', 302);
}
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=4" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=4" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=4" />
    <link rel="shortcut icon" href="/favicon.ico?v=4" />
    <link rel="apple-touch-icon" href="/favicon-192x192.png?v=4" />
    <title>Gestione preventivi | Poliurea System</title>
</head>
<body class="admin-body min-h-screen bg-black text-zinc-200">

    <div id="admin-app" class="admin-shell w-full max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-8 pb-12 hidden">
        <header class="admin-header flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-6 border-b border-zinc-800 mb-8">
            <div class="flex items-center gap-4">
                <a class="admin-brand inline-flex items-center" href="/" aria-label="Poliurea System, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="180" height="40" />
                    </picture>
                </a>
                <div class="hidden sm:block h-6 w-px bg-zinc-800"></div>
                <div class="admin-header-title">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-sky-400">AREA GESTIONE</p>
                    <h1 class="text-xl sm:text-2xl font-bold text-white">Gestione preventivi</h1>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 border border-zinc-800 bg-zinc-900 text-zinc-300 px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Area riservata
                </span>
            </div>
        </header>

        <p id="dashboard-error" class="hidden mb-5 rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-400" role="alert"></p>

        <nav id="admin-tabs" class="mb-8 hidden flex-wrap items-center justify-between gap-3" aria-label="Sezioni amministrazione">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Contenuti">
                <button id="tab-preventivi" type="button" role="tab" aria-selected="true" aria-controls="table-section" class="rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-bold text-white">Preventivi</button>
                <button id="tab-lavori" type="button" role="tab" aria-selected="false" aria-controls="works-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Lavori e immagini</button>
                <button id="tab-clienti" type="button" role="tab" aria-selected="false" aria-controls="clients-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Account clienti</button>
            </div>
            <button id="logout-btn" type="button" class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-sm font-bold text-red-400 hover:border-red-500/30 hover:bg-red-500/10 transition">Esci dal pannello</button>
        </nav>

        <section id="admin-summary" class="admin-summary hidden grid gap-4 sm:grid-cols-3 mb-8" aria-label="Riepilogo preventivi">
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Richieste totali</span><strong id="summary-total" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">Preventivi ricevuti</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Foto e allegati</span><strong id="summary-attachments" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">File nelle richieste</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Ultima richiesta</span><strong id="summary-latest" class="block text-2xl font-extrabold text-white mt-1">Nessuna</strong><small class="text-xs text-zinc-500 mt-1 block">Data di ricezione</small></article>
        </section>

        <!-- SEZIONE TABELLA (Nascosta di default) -->
        <div id="table-section" class="hidden w-full overflow-x-auto rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl">
            <div class="admin-table-toolbar flex items-center justify-between gap-4 border-b border-zinc-800 bg-zinc-900/80 p-5">
                <div>
                    <p class="admin-table-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">RICHIESTE IN INGRESSO</p>
                    <span class="text-base font-bold text-white sm:text-lg">Totale richieste</span>
                </div>
                <span id="total-count" class="admin-count rounded-full border border-sky-500/30 bg-sky-500/10 px-3 py-1 font-mono text-sm font-bold text-sky-400">0</span>
            </div>
            <table class="w-full border-separate border-spacing-0 text-left text-sm">
                <thead>
                    <tr class="bg-zinc-950 text-zinc-400 text-[11px] uppercase tracking-wider font-semibold">
                        <th class="p-3 w-12 min-w-[48px] font-mono text-center border-b border-zinc-800">ID</th>
                        <th class="p-3 w-20 min-w-[80px] border-b border-zinc-800">Data</th>
                        <th class="p-3 w-28 min-w-[100px] border-b border-zinc-800">Nome</th>
                        <th class="p-3 w-40 min-w-[140px] border-b border-zinc-800">Contatti</th>
                        <th class="p-3 w-32 min-w-[110px] border-b border-zinc-800">Servizio</th>
                        <th class="p-3 min-w-[160px] max-w-[200px] border-b border-zinc-800">Messaggio</th>
                        <th class="p-3 w-20 min-w-[80px] border-b border-zinc-800">Foto</th>
                        <th class="p-3 w-28 min-w-[115px] border-b border-zinc-800">Stato</th>
                        <th class="p-3 min-w-[160px] max-w-[200px] border-b border-zinc-800">Cosa serve al cliente</th>
                        <th class="p-3 w-20 min-w-[76px] text-center border-b border-zinc-800">Azioni</th>
                    </tr>
                </thead>
                <tbody id="table-body" class="text-zinc-300">
                    <!-- I dati verranno inseriti qui -->
                </tbody>
            </table>
        </div>
        <section id="works-section" class="hidden w-full" aria-labelledby="tab-lavori">
            <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Contenuti del sito</p>
                    <h2 class="text-2xl font-bold text-white sm:text-3xl">Gestione Lavori e Cantieri</h2>
                    <p class="mt-2 max-w-3xl text-sm text-zinc-400">Inserisci nuovi cantieri completi di scheda tecnica, stratigrafia, galleria fotografica Prima/Dopo e video del risultato finale. Verranno pubblicati automaticamente affiancati nella pagina <a href="/lavori" target="_blank" class="text-sky-400 underline hover:text-sky-300">/lavori</a>.</p>
                </div>
                <a href="/lavori" target="_blank" class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-2 text-xs font-semibold text-zinc-200 transition hover:border-sky-500 hover:text-white">
                    Apri pagina Lavori <span aria-hidden="true">↗</span>
                </a>
            </div>

            <form id="work-form" class="mb-10 grid gap-6 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl">
                <!-- BLOCCO 1: Dati principali -->
                <div class="grid gap-4">
                    <div class="flex items-center gap-2 border-b border-zinc-800 pb-3">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sky-500/20 text-xs font-bold text-sky-400">1</span>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Informazioni principali</h3>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">
                            Titolo intervento *
                            <input name="titolo" required maxlength="160" placeholder="es. Risanamento copertura bituminosa 600 mq — Ciclo Sika armato" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                            Categoria
                            <select name="categoria" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20">
                                <option value="Coperture industriali">Coperture industriali</option>
                                <option value="Terrazzi e lastrici">Terrazzi e lastrici</option>
                                <option value="Fondazioni e cantine">Fondazioni e cantine</option>
                                <option value="Impermeabilizzazioni">Impermeabilizzazioni</option>
                            </select>
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                            Superficie (mq)
                            <input name="superficie_mq" type="number" min="0" max="1000000" step="1" placeholder="es. 600" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">
                            Località
                            <input name="localita" maxlength="160" placeholder="es. Genova e Liguria" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">
                            Metodo applicativo
                            <input name="applicazione" maxlength="160" placeholder="es. Spruzzo con pompa airless / Poliurea a caldo bimixer / Manuale" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2 lg:col-span-4">
                            Riepilogo dell’intervento
                            <textarea name="descrizione" maxlength="3000" rows="2" placeholder="Breve descrizione leggibile in apertura della scheda lavoro..." class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"></textarea>
                        </label>
                    </div>
                </div>

                <!-- BLOCCO 2: Scheda Tecnica e Stratigrafia -->
                <div class="grid gap-4">
                    <div class="flex items-center gap-2 border-b border-zinc-800 pb-3">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sky-500/20 text-xs font-bold text-sky-400">2</span>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Scheda tecnica e stratigrafia</h3>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-3">
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                            Supporto esistente
                            <input name="supporto" maxlength="160" placeholder="es. Materiale bituminoso" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                            Ciclo e sistema
                            <input name="ciclo_sistema" maxlength="160" placeholder="es. Ciclo Sika (Remat)" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                        <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                            Armatura strutturale
                            <input name="armatura" maxlength="160" placeholder="es. Corazzato con fibra di vetro Remax" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        </label>
                    </div>

                    <label class="grid gap-2 text-xs font-semibold text-zinc-300">
                        Descrizione generale della stratigrafia
                        <textarea name="stratigrafia_descrizione" maxlength="3000" rows="2" placeholder="es. Resina elastica monocomponente applicata a spruzzo con pompa airless, armatura con tessuto in fibra di vetro e ulteriore mano di chiusura..." class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"></textarea>
                    </label>

                    <div class="grid gap-3 rounded-xl border border-zinc-800 bg-zinc-950/70 p-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-zinc-200">Fasi operative di posa (opzionali)</p>
                                <p class="text-[11px] text-zinc-400">Compila solo gli strati che vuoi mostrare nella scheda tecnica (le righe vuote vengono ignorate).</p>
                            </div>
                            <button type="button" id="work-add-fase" class="rounded-lg border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 text-xs font-bold text-sky-400 transition hover:bg-sky-500/25 cursor-pointer">
                                + Aggiungi fase
                            </button>
                        </div>
                        <div id="work-fasi-container" class="grid gap-3"></div>
                    </div>
                </div>

                <!-- BLOCCO 3: Foto Prima, Foto Dopo e Video del Dopo -->
                <div class="grid gap-4">
                    <div class="flex items-center gap-2 border-b border-zinc-800 pb-3">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sky-500/20 text-xs font-bold text-sky-400">3</span>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Galleria Foto Prima / Dopo e Video del Dopo</h3>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-3">
                        <!-- Upload Foto Prima -->
                        <div class="flex flex-col gap-3 rounded-xl border border-zinc-800 bg-zinc-950/80 p-4">
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-800 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white">PRIMA</span>
                                <span id="work-count-prima" class="text-[11px] font-semibold text-zinc-400">0 selezionate</span>
                            </div>
                            <label class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border border-dashed border-zinc-700 bg-zinc-900/60 px-3 py-4 text-center transition hover:border-sky-500 hover:bg-zinc-900">
                                <span class="text-xs font-bold text-sky-400">+ Seleziona foto Prima</span>
                                <span class="text-[11px] text-zinc-400">JPG, PNG o WEBP · Selezione multipla</span>
                                <input id="work-input-prima" type="file" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" />
                            </label>
                            <div id="work-queue-prima" class="grid gap-2"></div>
                        </div>

                        <!-- Upload Foto Dopo -->
                        <div class="flex flex-col gap-3 rounded-xl border border-zinc-800 bg-zinc-950/80 p-4">
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-600 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white">DOPO</span>
                                <span id="work-count-dopo" class="text-[11px] font-semibold text-zinc-400">0 selezionate</span>
                            </div>
                            <label class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border border-dashed border-zinc-700 bg-zinc-900/60 px-3 py-4 text-center transition hover:border-sky-500 hover:bg-zinc-900">
                                <span class="text-xs font-bold text-sky-400">+ Seleziona foto Dopo</span>
                                <span class="text-[11px] text-zinc-400">JPG, PNG o WEBP · Selezione multipla</span>
                                <input id="work-input-dopo" type="file" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" />
                            </label>
                            <div id="work-queue-dopo" class="grid gap-2"></div>
                        </div>

                        <!-- Upload Video del Dopo -->
                        <div class="flex flex-col gap-3 rounded-xl border border-zinc-800 bg-zinc-950/80 p-4">
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-600 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white">VIDEO DOPO</span>
                                <span id="work-count-video" class="text-[11px] font-semibold text-zinc-400">0 selezionati</span>
                            </div>
                            <label class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border border-dashed border-zinc-700 bg-zinc-900/60 px-3 py-4 text-center transition hover:border-emerald-500 hover:bg-zinc-900">
                                <span class="text-xs font-bold text-emerald-400">+ Aggiungi video del Dopo</span>
                                <span class="text-[11px] text-zinc-400">MP4 o WEBM (max 30 MB) · Copertina auto</span>
                                <input id="work-input-video" type="file" multiple accept="video/mp4,video/webm,video/quicktime" class="sr-only" />
                            </label>
                            <div id="work-queue-video" class="grid gap-2"></div>
                        </div>
                    </div>
                </div>

                <!-- Barra invio e avanzamento -->
                <div class="grid gap-3 border-t border-zinc-800 pt-4">
                    <div id="work-progress-wrap" class="hidden h-2 w-full overflow-hidden rounded-full bg-zinc-800">
                        <div id="work-progress-bar" class="h-full bg-sky-500 transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <div class="flex flex-wrap items-center gap-4">
                        <button id="work-submit" type="submit" class="rounded-xl bg-sky-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-sky-500 disabled:opacity-50 cursor-pointer">
                            Pubblica lavoro nella galleria
                        </button>
                        <p id="work-feedback" class="text-sm text-zinc-300" role="status" aria-live="polite"></p>
                    </div>
                </div>
            </form>

            <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-bold text-white">Lavori pubblicati da Admin</h3>
                <span id="works-total-badge" class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1 text-xs font-mono text-zinc-400">0 cantieri</span>
            </div>
            <div id="works-list" class="grid gap-5"></div>
        </section>
        <section id="clients-section" class="hidden w-full" aria-labelledby="tab-clienti">
            <div class="mb-6">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Area clienti</p>
                <h2 class="text-2xl font-bold text-white sm:text-3xl">Crea un account cliente</h2>
                <p class="mt-2 max-w-3xl text-sm text-zinc-400">Il cliente vedrà solo le richieste associate alla stessa email. Condividi le credenziali iniziali tramite un canale sicuro.</p>
            </div>
            <form id="client-form" class="mb-8 grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:grid-cols-2 shadow-xl">
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Nome cliente
                    <input name="nome" required maxlength="160" autocomplete="name" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Email usata nel preventivo
                    <input name="email" type="email" required maxlength="254" autocomplete="email" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <div class="grid gap-2 sm:col-span-2">
                    <div class="flex items-center justify-between">
                        <label for="admin-client-password" class="text-xs font-semibold text-zinc-300">
                            Password iniziale temporanea (generata automaticamente)
                        </label>
                        <span class="text-[11px] text-amber-400 font-medium flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            Randomica sicura
                        </span>
                    </div>
                    <div class="relative flex items-center">
                        <input id="admin-client-password" name="password" type="text" required minlength="12" autocomplete="new-password" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 pr-44 text-sm font-mono text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <div class="absolute right-2 flex items-center gap-1.5">
                            <button type="button" id="btn-toggle-client-pwd-vis" class="p-1.5 text-zinc-400 hover:text-zinc-200 transition cursor-pointer" title="Mostra / Nascondi password" aria-label="Mostra o nascondi password">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            </button>
                            <button type="button" id="btn-copy-client-pwd" class="rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white px-2.5 py-1 text-xs font-medium transition cursor-pointer flex items-center gap-1 shadow-sm" title="Copia password negli appunti">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                <span id="copy-pwd-label">Copia</span>
                            </button>
                            <button type="button" id="btn-generate-client-pwd" class="rounded-lg bg-sky-500/15 hover:bg-sky-500/25 border border-sky-500/30 text-sky-400 px-2.5 py-1 text-xs font-semibold transition cursor-pointer flex items-center gap-1 shadow-sm" title="Genera un'altra password casuale">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                <span>Rigenera</span>
                            </button>
                        </div>
                    </div>
                    <p class="text-[11px] text-zinc-400">
                        La password temporanea viene generata in modo randomico sicuro. Verrà recapitata via email al cliente e al suo primo accesso gli verrà chiesto di sostituirla.
                    </p>
