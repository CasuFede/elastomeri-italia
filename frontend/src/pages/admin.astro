---
import '../styles/global.css';
// frontend/src/pages/admin.astro

const adminCookie = Astro.cookies.get('poliurea_admin_session')?.value;
if (!adminCookie) {
  return Astro.redirect('/accesso-preventivi', 302);
}
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gestione preventivi | Poliurea System</title>
</head>
<body class="admin-body min-h-screen bg-black text-zinc-200">

    <div id="admin-app" class="admin-shell w-full max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-8 pb-12 hidden">
        <header class="admin-header flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-6 border-b border-zinc-800 mb-8">
            <div class="flex items-center gap-4">
                <a class="admin-brand inline-flex items-center" href="/" aria-label="Poliurea System, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="180" height="40" />
                    </picture>
                </a>
                <div class="hidden sm:block h-6 w-px bg-zinc-800"></div>
                <div class="admin-header-title">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-sky-400">AREA GESTIONE</p>
                    <h1 class="text-xl sm:text-2xl font-bold text-white">Gestione preventivi</h1>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 border border-zinc-800 bg-zinc-900 text-zinc-300 px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Area riservata
                </span>
            </div>
        </header>

        <p id="dashboard-error" class="hidden mb-5 rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-400" role="alert"></p>

        <nav id="admin-tabs" class="mb-8 hidden flex-wrap items-center justify-between gap-3" aria-label="Sezioni amministrazione">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Contenuti">
                <button id="tab-preventivi" type="button" role="tab" aria-selected="true" aria-controls="table-section" class="rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/20">Preventivi</button>
                <button id="tab-lavori" type="button" role="tab" aria-selected="false" aria-controls="works-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Lavori e immagini</button>
                <button id="tab-clienti" type="button" role="tab" aria-selected="false" aria-controls="clients-section" class="rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white">Account clienti</button>
            </div>
            <button id="logout-btn" type="button" class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-sm font-bold text-red-400 hover:border-red-500/30 hover:bg-red-500/10 transition">Esci dal pannello</button>
        </nav>

        <section id="admin-summary" class="admin-summary hidden grid gap-4 sm:grid-cols-3 mb-8" aria-label="Riepilogo preventivi">
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Richieste totali</span><strong id="summary-total" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">Preventivi ricevuti</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Foto e allegati</span><strong id="summary-attachments" class="block text-3xl font-extrabold text-white mt-1">0</strong><small class="text-xs text-zinc-500 mt-1 block">File nelle richieste</small></article>
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl relative overflow-hidden border-l-4 border-l-sky-500"><span class="text-xs font-semibold text-zinc-400">Ultima richiesta</span><strong id="summary-latest" class="block text-2xl font-extrabold text-white mt-1">Nessuna</strong><small class="text-xs text-zinc-500 mt-1 block">Data di ricezione</small></article>
        </section>

        <!-- SEZIONE TABELLA (Nascosta di default) -->
        <div id="table-section" class="hidden w-full overflow-x-auto rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl">
            <div class="admin-table-toolbar flex items-center justify-between gap-4 border-b border-zinc-800 bg-zinc-900/80 p-5">
                <div>
                    <p class="admin-table-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">RICHIESTE IN INGRESSO</p>
                    <span class="text-base font-bold text-white sm:text-lg">Totale richieste</span>
                </div>
                <span id="total-count" class="admin-count rounded-full border border-sky-500/30 bg-sky-500/10 px-3 py-1 font-mono text-sm font-bold text-sky-400">0</span>
            </div>
            <table class="w-full border-separate border-spacing-0 text-left text-sm">
                <thead>
                    <tr class="bg-zinc-950 text-zinc-400 text-[11px] uppercase tracking-wider font-semibold">
                        <th class="p-3 w-12 min-w-[48px] font-mono text-center border-b border-zinc-800">ID</th>
                        <th class="p-3 w-20 min-w-[80px] border-b border-zinc-800">Data</th>
                        <th class="p-3 w-28 min-w-[100px] border-b border-zinc-800">Nome</th>
                        <th class="p-3 w-40 min-w-[140px] border-b border-zinc-800">Contatti</th>
                        <th class="p-3 w-32 min-w-[110px] border-b border-zinc-800">Servizio</th>
                        <th class="p-3 min-w-[160px] max-w-[200px] border-b border-zinc-800">Messaggio</th>
                        <th class="p-3 w-20 min-w-[80px] border-b border-zinc-800">Foto</th>
                        <th class="p-3 w-28 min-w-[115px] border-b border-zinc-800">Stato</th>
                        <th class="p-3 min-w-[160px] max-w-[200px] border-b border-zinc-800">Cosa serve al cliente</th>
                        <th class="p-3 w-20 min-w-[76px] text-center border-b border-zinc-800">Azioni</th>
                    </tr>
                </thead>
                <tbody id="table-body" class="text-zinc-300">
                    <!-- I dati verranno inseriti qui -->
                </tbody>
            </table>
        </div>
        <section id="works-section" class="hidden w-full" aria-labelledby="tab-lavori">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Contenuti del sito</p>
                    <h2 class="text-2xl font-bold text-white sm:text-3xl">Lavori e immagini</h2>
                    <p class="mt-2 max-w-2xl text-sm text-zinc-400">Pubblica un intervento nella galleria e aggiorna testi o immagini quando vuoi.</p>
                </div>
            </div>
            <form id="work-form" class="mb-8 grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:grid-cols-2 shadow-xl">
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Titolo
                    <input name="titolo" required maxlength="160" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Località
                    <input name="localita" maxlength="160" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">Descrizione
                    <textarea name="descrizione" maxlength="3000" rows="3" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"></textarea>
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300 sm:col-span-2">Immagine (JPG, PNG o WEBP, massimo 10 MB)
                    <input name="immagine" type="file" accept="image/jpeg,image/png,image/webp" required class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-zinc-300 file:mr-4 file:rounded-lg file:border-0 file:bg-sky-500 file:px-4 file:py-2 file:text-xs file:font-bold file:text-white file:cursor-pointer hover:file:bg-sky-400" />
                </label>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2 pt-2">
                    <button id="work-submit" type="submit" class="rounded-xl bg-sky-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-400 hover:-translate-y-0.5">Pubblica nella galleria</button>
                    <p id="work-feedback" class="text-sm text-zinc-300" role="status" aria-live="polite"></p>
                </div>
            </form>
            <div id="works-list" class="grid gap-4"></div>
        </section>
        <section id="clients-section" class="hidden w-full" aria-labelledby="tab-clienti">
            <div class="mb-6">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-sky-400">Area clienti</p>
                <h2 class="text-2xl font-bold text-white sm:text-3xl">Crea un account cliente</h2>
                <p class="mt-2 max-w-3xl text-sm text-zinc-400">Il cliente vedrà solo le richieste associate alla stessa email. Condividi le credenziali iniziali tramite un canale sicuro.</p>
            </div>
            <form id="client-form" class="mb-8 grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:grid-cols-2 shadow-xl">
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Nome cliente
                    <input name="nome" required maxlength="160" autocomplete="name" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <label class="grid gap-2 text-xs font-semibold text-zinc-300">Email usata nel preventivo
                    <input name="email" type="email" required maxlength="254" autocomplete="email" class="rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                </label>
                <div class="grid gap-2 sm:col-span-2">
                    <div class="flex items-center justify-between">
                        <label for="admin-client-password" class="text-xs font-semibold text-zinc-300">
                            Password iniziale temporanea (generata automaticamente)
                        </label>
                        <span class="text-[11px] text-amber-400 font-medium flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            Randomica sicura
                        </span>
                    </div>
                    <div class="relative flex items-center">
                        <input id="admin-client-password" name="password" type="text" required minlength="12" autocomplete="new-password" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 pr-44 text-sm font-mono text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <div class="absolute right-2 flex items-center gap-1.5">
                            <button type="button" id="btn-toggle-client-pwd-vis" class="p-1.5 text-zinc-400 hover:text-zinc-200 transition cursor-pointer" title="Mostra / Nascondi password" aria-label="Mostra o nascondi password">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            </button>
                            <button type="button" id="btn-copy-client-pwd" class="rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white px-2.5 py-1 text-xs font-medium transition cursor-pointer flex items-center gap-1 shadow-sm" title="Copia password negli appunti">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                <span id="copy-pwd-label">Copia</span>
                            </button>
                            <button type="button" id="btn-generate-client-pwd" class="rounded-lg bg-sky-500/15 hover:bg-sky-500/25 border border-sky-500/30 text-sky-400 px-2.5 py-1 text-xs font-semibold transition cursor-pointer flex items-center gap-1 shadow-sm" title="Genera un'altra password casuale">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                <span>Rigenera</span>
                            </button>
                        </div>
                    </div>
                    <p class="text-[11px] text-zinc-400">
                        La password temporanea viene generata in modo randomico sicuro. Verrà recapitata via email al cliente e al suo primo accesso gli verrà chiesto di sostituirla.
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2 pt-2">
                    <button id="client-submit" type="submit" class="rounded-xl bg-sky-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-400 hover:-translate-y-0.5 cursor-pointer">Crea account</button>
                    <p id="client-feedback" class="text-sm text-zinc-300" role="status" aria-live="polite"></p>
                </div>
            </form>
            <div class="mb-4">
                <h3 class="text-lg font-bold text-white">Account esistenti</h3>
            </div>
            <div id="clients-list" class="grid gap-3"></div>
        </section>
        <dialog id="photo-dialog" class="m-auto rounded-2xl border border-zinc-800 bg-zinc-900 p-4 sm:p-6 shadow-2xl backdrop:bg-black/85 max-w-[calc(100vw-2rem)] sm:max-w-4xl max-h-[92vh] overflow-y-auto">
            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-zinc-800 mb-4 sticky top-0 bg-zinc-900/95 backdrop-blur z-10">
                <div class="min-w-0 pr-2">
                    <p id="photo-subtitle" class="text-[11px] font-bold uppercase tracking-wider text-sky-400 mb-0.5">ALLEGATO RICHIESTA</p>
                    <h2 id="photo-title" class="font-bold text-white text-sm sm:text-base truncate">Foto allegata</h2>
                </div>
                <div class="flex items-center gap-2">
                    <button id="download-photo-btn" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-sky-500 hover:bg-sky-400 px-3.5 py-2 rounded-xl shadow-md shadow-sky-500/20 transition cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        <span>Scarica foto</span>
                    </button>
                    <button id="close-photo-btn" type="button" class="text-xs font-bold text-zinc-300 hover:text-white px-3 py-2 rounded-xl bg-zinc-800 border border-zinc-700 hover:border-zinc-600 transition cursor-pointer">Chiudi</button>
                </div>
            </div>
            <div id="photo-loading" class="hidden py-16 text-center text-zinc-400 text-xs font-medium">Caricamento foto in alta definizione...</div>
            <div class="flex items-center justify-center p-2 bg-black/50 rounded-xl border border-zinc-800/80">
                <img id="photo-viewer" class="max-h-[72vh] w-auto max-w-full rounded-lg object-contain shadow-2xl" alt="Foto allegata al preventivo" />
            </div>
        </dialog>

        <!-- Modale Editor Fullscreen: Cosa serve al cliente -->
        <dialog id="notes-dialog" class="m-auto rounded-3xl border border-zinc-800 bg-zinc-900/98 backdrop-blur-xl p-6 sm:p-8 shadow-2xl backdrop:bg-black/85 w-[96vw] max-w-5xl h-[88vh] max-h-[880px] open:flex flex-col justify-between">
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 pb-4 border-b border-zinc-800 shrink-0">
                <div>
                    <p id="notes-kicker" class="text-xs font-bold uppercase tracking-wider text-sky-400">AGGIORNAMENTO RICHIESTA</p>
                    <h2 class="text-xl sm:text-2xl font-bold text-white mt-0.5">Cosa serve al cliente</h2>
                    <p class="text-xs text-zinc-400 mt-1">Scrivi qui le indicazioni e i documenti necessari che il cliente visualizzerà nella sua area riservata.</p>
                </div>
                <button id="close-notes-btn" type="button" class="text-xs font-bold text-zinc-300 hover:text-white px-3.5 py-2 rounded-xl bg-zinc-800 border border-zinc-700 hover:border-zinc-600 transition cursor-pointer">
                    ✕ Chiudi
                </button>
            </div>

            <!-- Body: Context + Fullscreen Textarea -->
            <div class="my-4 flex-1 flex flex-col gap-3 min-h-0">
                <div id="notes-context" class="rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-3 text-xs text-zinc-400 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <span id="notes-context-service" class="font-medium text-sky-400"></span>
                    <span id="notes-context-date" class="text-zinc-500"></span>
                </div>
                <div class="relative flex-1 min-h-[260px] flex flex-col">
                    <textarea id="notes-fullscreen-input" maxlength="1200" placeholder="Descrivi chiaramente cosa serve per procedere (es. foto aggiuntive, planimetrie, conferma orari sopralluogo)..." class="w-full flex-1 rounded-2xl border border-zinc-700 bg-zinc-950 p-4 text-sm sm:text-base text-white placeholder-zinc-500 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/25 resize-none font-sans leading-relaxed"></textarea>
                    <div class="flex justify-between items-center pt-2 text-[11px] font-mono text-zinc-500">
                        <span class="text-zinc-400">Premi <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-[10px]">Ctrl</kbd> + <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-[10px]">Invio</kbd> per salvare rapidamente</span>
                        <span id="notes-char-count">0 / 1200</span>
                    </div>
                </div>
            </div>

            <!-- Footer: Save & Done Button -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-zinc-800 shrink-0">
                <div class="flex flex-wrap items-center gap-3">
                    <label class="inline-flex items-center gap-2 text-xs font-medium text-zinc-300 cursor-pointer select-none">
                        <input id="notes-send-email-check" type="checkbox" checked class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-sky-500 focus:ring-sky-500/20 cursor-pointer" />
                        <span class="flex items-center gap-1.5 text-zinc-200">
                            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Invia email di notifica al cliente
                        </span>
                    </label>
                    <p id="notes-feedback" class="text-xs text-sky-400 font-medium"></p>
                </div>
                <div class="flex items-center gap-3">
                    <button id="cancel-notes-btn" type="button" class="px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900 text-xs font-semibold text-zinc-300 hover:text-white transition cursor-pointer">
                        Annulla
                    </button>
                    <button id="save-notes-btn" type="button" class="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-6 py-2.5 text-xs font-bold text-white shadow-lg shadow-sky-500/25 hover:bg-sky-400 transition cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Salva e invia chiarimenti
                    </button>
                </div>
            </div>
        </dialog>

        <!-- Modale di Conferma Eliminazione con Doppia Conferma -->
        <dialog id="delete-confirm-dialog" class="m-auto rounded-3xl border border-red-500/30 bg-zinc-950 p-6 sm:p-8 shadow-2xl backdrop:bg-black/85 w-[92vw] max-w-lg">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 border border-red-500/25 text-red-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold uppercase tracking-wider text-red-400">CONFERMA ELIMINAZIONE</p>
                    <h3 id="delete-dialog-title" class="text-lg font-bold text-white mt-0.5">Sei sicuro di voler eliminare?</h3>
                    <p id="delete-dialog-desc" class="text-xs text-zinc-400 mt-1 leading-relaxed"></p>
                </div>
            </div>

            <div class="mt-5 rounded-2xl border border-zinc-800 bg-zinc-900/80 p-4 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-zinc-400">Elemento selezionato:</span>
                    <strong id="delete-dialog-target" class="text-white font-mono truncate max-w-[260px]"></strong>
                </div>
                <div id="delete-dialog-details" class="text-xs text-zinc-400 border-t border-zinc-800/80 pt-2 break-words"></div>
