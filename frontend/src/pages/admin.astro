        </section>
        <dialog id="photo-dialog" class="m-auto rounded-2xl border border-zinc-800 bg-zinc-900 p-4 sm:p-6 shadow-2xl backdrop:bg-black/85 max-w-[calc(100vw-2rem)] sm:max-w-4xl max-h-[92vh] overflow-y-auto">
            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-zinc-800 mb-4 sticky top-0 bg-zinc-900/95 backdrop-blur z-10">
                <div class="min-w-0 pr-2">
                    <p id="photo-subtitle" class="text-[11px] font-bold uppercase tracking-wider text-sky-400 mb-0.5">ALLEGATO RICHIESTA</p>
                    <h2 id="photo-title" class="font-bold text-white text-sm sm:text-base truncate">Foto allegata</h2>
