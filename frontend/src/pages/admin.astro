                        // Al click sulla textarea o sul pulsantino, apri l'editor fullscreen
                        noteInput.addEventListener('click', () => {
                            apriEditorNote(prev, noteInput, statoSelect, salvaStato);
                        });
                        expandIconBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            apriEditorNote(prev, noteInput, statoSelect, salvaStato);
                        });

                        noteBoxWrap.append(noteInput, expandIconBtn);

                        const salvaStato = document.createElement('button');
                        salvaStato.type = 'button';
                        salvaStato.className = 'w-full rounded-lg bg-sky-500 px-2.5 py-1.5 text-xs font-bold text-white shadow-md shadow-sky-500/20 hover:bg-sky-400 transition cursor-pointer text-center';
                        salvaStato.textContent = 'Salva aggiornamento';
                        salvaStato.addEventListener('click', async () => {
                            salvaStato.disabled = true;
                            const nuovoTesto = noteInput.value.trim();
                            const noteModificate = nuovoTesto !== (prev.note_cliente || '').trim();
                            try {
                                const risposta = await fetch(`/api/preventivi/${prev.id}/stato`, {
                                    method: 'PATCH',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    body: JSON.stringify({
                                        stato: statoSelect.value,
                                        note_cliente: noteInput.value,
                                        invia_email: noteModificate && !!nuovoTesto,
                                    }),
                                });
                                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                                const data = await risposta.json();
                                prev.note_cliente = noteInput.value;
                                prev.stato = statoSelect.value;
                                if (data.email_inviata) {
                                    salvaStato.textContent = 'Salvato & Email inviata!';
                                    salvaStato.className = 'w-full rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-bold text-white shadow-md shadow-emerald-500/20 transition cursor-pointer text-center';
                                } else {
                                    salvaStato.textContent = 'Salvato';
                                    salvaStato.className = 'w-full rounded-lg bg-sky-500 px-2.5 py-1.5 text-xs font-bold text-white shadow-md shadow-sky-500/20 hover:bg-sky-400 transition cursor-pointer text-center';
                                }
                                setTimeout(() => {
                                    salvaStato.textContent = 'Salva aggiornamento';
                                    salvaStato.className = 'w-full rounded-lg bg-sky-500 px-2.5 py-1.5 text-xs font-bold text-white shadow-md shadow-sky-500/20 hover:bg-sky-400 transition cursor-pointer text-center';
                                }, 2500);
                            } catch (errore) {
                                salvaStato.textContent = 'Errore';
                                dashboardError.textContent = `Aggiornamento non salvato: ${errore.message}`;
                                dashboardError.classList.remove('hidden');
                            } finally {
                                salvaStato.disabled = false;
                            }
                        });
                        noteCella.append(noteBoxWrap, salvaStato);
                        tr.appendChild(noteCella);

                        // 10. Azioni (Elimina pulito, centrato e spazioso senza sovrapposizioni)
                        const azioniCella = document.createElement('td');
                        azioniCella.className = 'p-3 w-20 min-w-[76px] text-center align-top border-b border-zinc-800/80';

                        const btnEliminaPrev = document.createElement('button');
                        btnEliminaPrev.type = 'button';
                        btnEliminaPrev.className = 'inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-red-500/25 bg-red-500/10 hover:bg-red-500/25 hover:border-red-500/50 text-red-400 text-xs font-semibold transition cursor-pointer shadow-sm';
                        btnEliminaPrev.title = `Elimina richiesta #${prev.id}`;
                        btnEliminaPrev.setAttribute('aria-label', `Elimina richiesta #${prev.id}`);
                        btnEliminaPrev.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg><span>Elimina</span>';

                        btnEliminaPrev.addEventListener('click', () => {
                            const fotoCount = Array.isArray(prev.allegati) ? prev.allegati.length : 0;
                            apriConfermaEliminazione({
                                tipo: 'preventivo',
                                id: prev.id,
                                titolo: `Elimina Richiesta #${prev.id}`,
                                target: `#${prev.id} · ${prev.nome}`,
                                dettagli: `Email: ${prev.email} · Servizio: ${prev.servizio || '-'}${fotoCount ? ` · ${fotoCount} file/foto correlati` : ''}`,
                                onConfirm: async () => {
                                    const res = await fetch(`/api/preventivi/${prev.id}`, { method: 'DELETE' });
                                    if (!res.ok) throw new Error((await res.json()).detail || `HTTP ${res.status}`);
                                    await caricaPreventivi();
                                }
                            });
                        });

                        azioniCella.appendChild(btnEliminaPrev);
                        tr.appendChild(azioniCella);
                        tableBody.appendChild(tr);
                    });
                }

            } catch (error) {
                console.error("Errore fetch:", error);
                dashboardError.textContent = error instanceof Error ? error.message : 'Errore durante il caricamento dei dati. Verifica la connessione e riprova.';
                dashboardError.classList.remove('hidden');
            }
        };

        logoutBtn.addEventListener('click', async () => {
            tableSection.classList.add('hidden');
            worksSection.classList.add('hidden');
            adminTabs.classList.add('hidden');
            adminTabs.classList.remove('flex');
            adminSummary.classList.add('hidden');
            sessionStorage.removeItem(sessionKey);
            tableBody.innerHTML = '';
            worksList.replaceChildren();
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (_) {}
            window.location.replace('/accesso-preventivi');
        });

        document.getElementById('close-photo-btn').addEventListener('click', () => photoDialog.close());
        downloadPhotoBtn.addEventListener('click', () => {
            if (activePhotoData) {
                scaricaAllegato(activePhotoData.prevId, activePhotoData.allegatoId, activePhotoData.nome);
            }
        });
        photoDialog.addEventListener('click', (evento) => {
            if (evento.target === photoDialog) photoDialog.close();
        });
        photoDialog.addEventListener('close', () => {
            if (photoViewer.src && photoViewer.src.startsWith('blob:')) {
                URL.revokeObjectURL(photoViewer.src);
            }
            photoViewer.removeAttribute('src');
            activePhotoData = null;
        });

        if (isLogged) caricaPreventivi();
    </script>
</body>
</html>