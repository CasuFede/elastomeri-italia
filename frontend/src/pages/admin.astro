                        statoSelect.value = prev.stato || 'ricevuto';

                        const statoFeedback = document.createElement('div');
                        statoFeedback.className = 'text-[10px] text-zinc-500 mt-1.5 transition-all duration-200 hidden font-semibold flex items-center gap-1';

                        statoCella.append(statoSelect, statoFeedback);
