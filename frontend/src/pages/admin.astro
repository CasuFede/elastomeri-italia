        const caricaSingoloMediaSuApi = async (lavoroId, tipo, item, ordine) => {
            const fd = new FormData();
            fd.append('tipo', tipo);
            const fileDaCaricare = tipo === 'video' ? item.file : await ottimizzaImmagineBrowser(item.file);
            fd.append('file', fileDaCaricare);
            fd.append('ordine', String(ordine));
            if (item.titolo) fd.append('titolo', item.titolo);
            if (item.didascalia) fd.append('didascalia', item.didascalia);
            if (item.durata) fd.append('durata', item.durata);
            if (tipo === 'video' && item.posterFile) {
                fd.append('poster', item.posterFile);
            }
            const res = await fetch(`/api/lavori/${lavoroId}/media`, {
                method: 'POST',
                body: fd,
            });
            if (!res.ok) {
                let detail = `HTTP ${res.status}`;
                try { detail = (await res.json()).detail || detail; } catch {}
                throw new Error(detail);
            }
            return res.json();
        };

        const creaCampoLavoro = (etichetta, valore, opz = {}) => {
            const { multilinea = false, tipo = 'text', opzioni = null, placeholder = '' } = opz;
            const contenitore = document.createElement('label');
            contenitore.className = 'grid gap-1.5 text-xs font-semibold text-zinc-300';
            contenitore.append(document.createTextNode(etichetta));
            let campo;
            if (opzioni) {
                campo = document.createElement('select');
                opzioni.forEach((optVal) => {
                    const opt = document.createElement('option');
                    opt.value = optVal;
                    opt.textContent = optVal;
                    campo.appendChild(opt);
                });
                campo.value = opzioni.includes(valore) ? valore : opzioni[0];
            } else {
                campo = document.createElement(multilinea ? 'textarea' : 'input');
                if (!multilinea) campo.type = tipo;
                campo.value = valore ?? '';
                if (placeholder) campo.placeholder = placeholder;
                if (multilinea) {
                    campo.rows = 2;
                    campo.maxLength = 3000;
                } else if (tipo === 'number') {
                    campo.min = '0';
                    campo.max = '1000000';
                } else {
                    campo.maxLength = 160;
                }
            }
            campo.className = 'w-full rounded-xl border border-zinc-700 bg-zinc-950 p-2.5 text-sm font-normal text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20';
            contenitore.appendChild(campo);
            return { contenitore, campo };
        };

        const caricaLavori = async () => {
            try {
                const risposta = await fetch('/api/lavori');
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const risultato = await risposta.json();
                if (!Array.isArray(risultato.dati)) throw new Error('Formato della risposta non valido.');
                worksList.replaceChildren();
                if (worksTotalBadge) {
                    const n = risultato.dati.length;
                    worksTotalBadge.textContent = `${n} ${n === 1 ? 'cantiere' : 'cantieri'}`;
                }
                if (!risultato.dati.length) {
                    const vuoto = document.createElement('p');
                    vuoto.className = 'rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-400';
                    vuoto.textContent = 'Nessun lavoro pubblicato da Admin al momento. Usa il modulo completo qui sopra per aggiungerne uno: apparirà affiancato nella pagina /lavori.';
                    worksList.appendChild(vuoto);
                    return;
                }

                risultato.dati.forEach((lavoro) => {
                    const fotoPrima = Array.isArray(lavoro.foto_prima) ? lavoro.foto_prima : [];
                    const fotoDopo = Array.isArray(lavoro.foto_dopo) ? lavoro.foto_dopo : [];
                    const videoDopo = Array.isArray(lavoro.video_dopo) ? lavoro.video_dopo : [];

                    const scheda = document.createElement('article');
                    scheda.className = 'grid gap-5 rounded-2xl border border-zinc-800 bg-zinc-900 p-5 shadow-xl';

                    // INTESTAZIONE RIEPILOGATIVA DEL LAVORO
                    const header = document.createElement('div');
                    header.className = 'grid gap-4 md:grid-cols-[220px_1fr] items-start';

                    // Copertina mini Prima | Dopo o singola
                    const coverBox = document.createElement('div');
                    coverBox.className = 'overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 aspect-[16/10]';
                    if (fotoPrima[0] && fotoDopo[0]) {
                        coverBox.classList.add('grid', 'grid-cols-2', 'gap-0.5');
                        const img1 = document.createElement('img');
                        img1.src = fotoPrima[0].url;
                        img1.alt = `Prima: ${lavoro.titolo}`;
                        img1.className = 'h-full w-full object-cover';
                        const img2 = document.createElement('img');
                        img2.src = fotoDopo[0].url;
                        img2.alt = `Dopo: ${lavoro.titolo}`;
                        img2.className = 'h-full w-full object-cover';
                        coverBox.append(img1, img2);
                    } else if (lavoro.immagine_url) {
                        const img = document.createElement('img');
                        img.src = lavoro.immagine_url;
                        img.alt = lavoro.titolo;
                        img.className = 'h-full w-full object-cover';
                        coverBox.appendChild(img);
                    } else {
                        const ph = document.createElement('div');
                        ph.className = 'flex h-full w-full items-center justify-center text-xs text-zinc-500';
                        ph.textContent = 'Nessuna foto';
                        coverBox.appendChild(ph);
                    }

                    const summary = document.createElement('div');
                    summary.className = 'grid gap-2.5';

                    const badgesRow = document.createElement('div');
                    badgesRow.className = 'flex flex-wrap items-center gap-2';

                    const bCat = document.createElement('span');
                    bCat.className = 'rounded-full border border-sky-500/30 bg-sky-500/15 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-sky-400';
                    bCat.textContent = lavoro.categoria || 'Impermeabilizzazioni';
                    badgesRow.appendChild(bCat);

                    if (lavoro.superficie_mq > 0) {
                        const bMq = document.createElement('span');
                        bMq.className = 'rounded-full bg-sky-600 px-2.5 py-0.5 text-[11px] font-bold text-white';
                        bMq.textContent = `${lavoro.superficie_mq} mq`;
                        badgesRow.appendChild(bMq);
                    }

                    const bMedia = document.createElement('span');
                    bMedia.className = 'rounded-full border border-zinc-700 bg-zinc-950 px-2.5 py-0.5 text-[11px] font-semibold text-zinc-300';
                    bMedia.textContent = `${fotoPrima.length} Prima · ${fotoDopo.length} Dopo · ${videoDopo.length} Video`;
                    badgesRow.appendChild(bMedia);

                    const hTitle = document.createElement('h4');
                    hTitle.className = 'text-lg font-bold text-white leading-snug';
                    hTitle.textContent = lavoro.titolo;

                    const specsLine = [lavoro.localita, lavoro.supporto, lavoro.ciclo_sistema, lavoro.armatura]
                        .filter(Boolean)
                        .join(' · ');
                    const pSpecs = document.createElement('p');
                    pSpecs.className = 'text-xs text-zinc-400';
                    pSpecs.textContent = specsLine || 'Scheda tecnica modificabile qui sotto.';

                    const topActions = document.createElement('div');
                    topActions.className = 'flex flex-wrap items-center gap-2 pt-1';

                    const linkPub = document.createElement('a');
                    linkPub.href = `/lavori#cantiere-${lavoro.id}`;
                    linkPub.target = '_blank';
                    linkPub.className = 'rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-xs font-semibold text-zinc-200 transition hover:border-sky-500 hover:text-white';
                    linkPub.textContent = 'Vedi sul sito ↗';

                    const creaUploadRapido = (tipo, label, accept, colorCls) => {
                        const lbl = document.createElement('label');
                        lbl.className = `cursor-pointer rounded-lg border px-3 py-1.5 text-xs font-semibold transition ${colorCls}`;
                        lbl.textContent = label;
                        const inp = document.createElement('input');
                        inp.type = 'file';
                        inp.multiple = true;
                        inp.accept = accept;
                        inp.className = 'sr-only';
                        inp.addEventListener('change', async () => {
                            const files = Array.from(inp.files || []);
                            inp.value = '';
                            if (!files.length) return;
                            mostraFeedbackLavori(`Caricamento ${files.length} file (${tipo}) su "${lavoro.titolo}"...`);
                            try {
                                const baseOrder =
                                    tipo === 'prima' ? fotoPrima.length : tipo === 'dopo' ? fotoDopo.length : videoDopo.length;
                                for (let i = 0; i < files.length; i++) {
                                    const f = files[i];
                                    const item = { file: f, titolo: '', didascalia: '', durata: '', posterFile: null };
                                    if (tipo === 'video') {
                                        if (f.size > 30 * 1024 * 1024) throw new Error(`"${f.name}" supera i 30 MB.`);
                                        const meta = await estraiMetadataVideoBrowser(f);
                                        item.durata = meta.durata;
                                        item.posterFile = meta.posterFile;
                                        item.titolo = (f.name || 'Video risultato').replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();
                                    }
                                    await caricaSingoloMediaSuApi(lavoro.id, tipo, item, baseOrder + i);
                                }
                                mostraFeedbackLavori('Media aggiunti con successo.');
                                await caricaLavori();
                            } catch (err) {
                                mostraFeedbackLavori(`Errore upload media: ${err.message}`, true);
                            }
                        });
                        lbl.appendChild(inp);
                        return lbl;
                    };

                    const btnAddPrima = creaUploadRapido('prima', '+ Foto Prima', 'image/jpeg,image/png,image/webp', 'border-zinc-700 bg-zinc-950 text-zinc-200 hover:border-sky-500');
                    const btnAddDopo = creaUploadRapido('dopo', '+ Foto Dopo', 'image/jpeg,image/png,image/webp', 'border-sky-500/40 bg-sky-500/15 text-sky-300 hover:bg-sky-500/25');
                    const btnAddVideo = creaUploadRapido('video', '+ Video Dopo', 'video/mp4,video/webm,video/quicktime', 'border-emerald-500/40 bg-emerald-500/15 text-emerald-300 hover:bg-emerald-500/25');

                    const elimina = document.createElement('button');
                    elimina.type = 'button';
                    elimina.className = 'ml-auto rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-1.5 text-xs font-semibold text-red-400 transition hover:border-red-500/40 hover:bg-red-500/20 cursor-pointer';
                    elimina.textContent = 'Elimina lavoro';
                    elimina.addEventListener('click', () => {
                        apriConfermaEliminazione({
                            tipo: 'lavoro',
                            id: lavoro.id,
                            titolo: 'Elimina Lavoro dalla Galleria',
                            target: lavoro.titolo,
                            dettagli: `${fotoPrima.length} foto Prima · ${fotoDopo.length} foto Dopo · ${videoDopo.length} video verranno eliminati definitivamente.`,
                            onConfirm: async () => {
                                const res = await fetch(`/api/lavori/${lavoro.id}`, { method: 'DELETE' });
                                if (!res.ok) throw new Error((await res.json()).detail || `HTTP ${res.status}`);
                                mostraFeedbackLavori('Lavoro eliminato.');
                                await caricaLavori();
                            },
                        });
                    });

                    topActions.append(linkPub, btnAddPrima, btnAddDopo, btnAddVideo, elimina);
                    summary.append(badgesRow, hTitle, pSpecs, topActions);
                    header.append(coverBox, summary);
                    scheda.appendChild(header);

                    // MINIATURE MEDIA CARICATI CON ELIMINAZIONE SINGOLA
                    const tuttiMediaCard = [
                        ...fotoPrima.filter((m) => m.id > 0).map((m) => ({ ...m, badge: 'PRIMA', badgeCls: 'bg-zinc-900 text-white' })),
                        ...fotoDopo.filter((m) => m.id > 0).map((m) => ({ ...m, badge: 'DOPO', badgeCls: 'bg-sky-600 text-white' })),
                        ...videoDopo.map((v) => ({ id: v.id, url: v.poster_url || '', didascalia: v.titolo, badge: `VIDEO${v.durata ? ` ${v.durata}` : ''}`, badgeCls: 'bg-emerald-600 text-white', isVideo: true })),
                    ];
                    if (tuttiMediaCard.length > 0) {
                        const mediaStrip = document.createElement('div');
                        mediaStrip.className = 'grid grid-cols-3 gap-2.5 sm:grid-cols-5 lg:grid-cols-6 border-t border-zinc-800 pt-4';
                        tuttiMediaCard.forEach((m) => {
                            const tile = document.createElement('div');
                            tile.className = 'relative overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950 aspect-[4/3] group';

                            if (m.url) {
                                const img = document.createElement('img');
                                img.src = m.url;
                                img.alt = m.didascalia || m.badge;
                                img.loading = 'lazy';
                                img.className = 'h-full w-full object-cover';
                                tile.appendChild(img);
                            } else {
                                const ph = document.createElement('div');
                                ph.className = 'flex h-full w-full items-center justify-center text-xs font-bold text-emerald-400';
                                ph.textContent = '▶ VIDEO';
                                tile.appendChild(ph);
                            }

                            const b = document.createElement('span');
                            b.className = `absolute left-1.5 top-1.5 rounded px-1.5 py-0.5 text-[9px] font-extrabold tracking-wider ${m.badgeCls}`;
                            b.textContent = m.badge;

                            const btnDelM = document.createElement('button');
                            btnDelM.type = 'button';
                            btnDelM.title = 'Elimina questo file';
                            btnDelM.className = 'absolute right-1.5 top-1.5 flex h-6 w-6 items-center justify-center rounded-full bg-zinc-950/90 text-[11px] font-bold text-red-400 border border-red-500/40 hover:bg-red-600 hover:text-white cursor-pointer';
                            btnDelM.textContent = '✕';
                            btnDelM.addEventListener('click', async () => {
                                if (!confirm('Rimuovere questo media dal lavoro?')) return;
                                try {
                                    const res = await fetch(`/api/lavori/${lavoro.id}/media/${m.id}`, { method: 'DELETE' });
                                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                                    mostraFeedbackLavori('File rimosso.');
                                    await caricaLavori();
                                } catch (err) {
                                    mostraFeedbackLavori(`Errore eliminazione media: ${err.message}`, true);
                                }
                            });

                            tile.append(b, btnDelM);
                            mediaStrip.appendChild(tile);
                        });
                        scheda.appendChild(mediaStrip);
                    }

                    // EDITOR ESPANDIBILE PER MODIFICARE TUTTI I CAMPI TECNICI
                    const details = document.createElement('details');
                    details.className = 'rounded-xl border border-zinc-800 bg-zinc-950/60';
                    const summ = document.createElement('summary');
                    summ.className = 'cursor-pointer select-none px-4 py-3 text-xs font-bold uppercase tracking-wider text-sky-400 hover:text-sky-300';
                    summ.textContent = 'Modifica scheda tecnica, testi e stratigrafia';
                    details.appendChild(summ);

                    const editorWrap = document.createElement('div');
                    editorWrap.className = 'grid gap-4 border-t border-zinc-800 p-4';

                    const gridCampi = document.createElement('div');
                    gridCampi.className = 'grid gap-3 sm:grid-cols-2 lg:grid-cols-4';
                    const fTitolo = creaCampoLavoro('Titolo *', lavoro.titolo);
                    fTitolo.contenitore.classList.add('sm:col-span-2');
                    const fCat = creaCampoLavoro('Categoria', lavoro.categoria, { opzioni: CATEGORIE_LAVORO });
                    const fMq = creaCampoLavoro('Superficie (mq)', lavoro.superficie_mq || '', { tipo: 'number' });
                    const fLoc = creaCampoLavoro('Località', lavoro.localita);
                    const fApp = creaCampoLavoro('Metodo applicativo', lavoro.applicazione);
                    const fSupp = creaCampoLavoro('Supporto esistente', lavoro.supporto);
                    const fCiclo = creaCampoLavoro('Ciclo e sistema', lavoro.ciclo_sistema);
                    const fArm = creaCampoLavoro('Armatura strutturale', lavoro.armatura);
                    fArm.contenitore.classList.add('sm:col-span-2');
                    const fDesc = creaCampoLavoro('Riepilogo intervento', lavoro.descrizione, { multilinea: true });
                    fDesc.contenitore.classList.add('sm:col-span-2', 'lg:col-span-4');
                    const fStratDesc = creaCampoLavoro('Descrizione stratigrafia', lavoro.stratigrafia_descrizione, { multilinea: true });
                    fStratDesc.contenitore.classList.add('sm:col-span-2', 'lg:col-span-4');

                    gridCampi.append(
                        fTitolo.contenitore,
                        fCat.contenitore,
                        fMq.contenitore,
                        fLoc.contenitore,
                        fApp.contenitore,
                        fSupp.contenitore,
                        fCiclo.contenitore,
                        fArm.contenitore,
                        fDesc.contenitore,
                        fStratDesc.contenitore
                    );

                    const fasiHead = document.createElement('div');
                    fasiHead.className = 'flex items-center justify-between gap-2';
                    const fasiLbl = document.createElement('span');
                    fasiLbl.className = 'text-xs font-bold uppercase tracking-wider text-zinc-300';
                    fasiLbl.textContent = 'Fasi della stratigrafia';
                    const fasiAdd = document.createElement('button');
                    fasiAdd.type = 'button';
                    fasiAdd.className = 'rounded-lg border border-sky-500/40 bg-sky-500/15 px-3 py-1 text-xs font-bold text-sky-400 hover:bg-sky-500/25 cursor-pointer';
                    fasiAdd.textContent = '+ Aggiungi fase';
                    fasiHead.append(fasiLbl, fasiAdd);

                    const fasiListEl = document.createElement('div');
                    fasiListEl.className = 'grid gap-2';
                    const fasiBuilder = creaBuilderFasi(
                        fasiListEl,
                        fasiAdd,
                        Array.isArray(lavoro.stratigrafia_fasi) && lavoro.stratigrafia_fasi.length
                            ? lavoro.stratigrafia_fasi
                            : [{ titolo: '', dettaglio: '' }]
                    );

                    const salva = document.createElement('button');
                    salva.type = 'button';
                    salva.className = 'justify-self-start rounded-xl bg-sky-600 px-5 py-2.5 text-xs font-bold text-white transition hover:bg-sky-500 cursor-pointer';
                    salva.textContent = 'Salva modifiche scheda';
                    salva.addEventListener('click', async () => {
                        salva.disabled = true;
                        try {
                            const res = await fetch(`/api/lavori/${lavoro.id}`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    titolo: fTitolo.campo.value,
                                    categoria: fCat.campo.value,
                                    superficie_mq: Number(fMq.campo.value || 0),
                                    localita: fLoc.campo.value,
                                    applicazione: fApp.campo.value,
                                    supporto: fSupp.campo.value,
                                    ciclo_sistema: fCiclo.campo.value,
                                    armatura: fArm.campo.value,
                                    descrizione: fDesc.campo.value,
                                    stratigrafia_descrizione: fStratDesc.campo.value,
                                    stratigrafia_fasi: fasiBuilder.leggiFasi(),
                                }),
                            });
                            if (!res.ok) throw new Error((await res.json()).detail || `HTTP ${res.status}`);
                            mostraFeedbackLavori('Scheda tecnica aggiornata.');
                            await caricaLavori();
                        } catch (errore) {
                            mostraFeedbackLavori(`Impossibile salvare: ${errore.message}`, true);
                        } finally {
                            salva.disabled = false;
                        }
                    });

                    editorWrap.append(gridCampi, fasiHead, fasiListEl, salva);
                    details.appendChild(editorWrap);
                    scheda.appendChild(details);
                    worksList.appendChild(scheda);
                });
            } catch (errore) {
                mostraFeedbackLavori(`Impossibile caricare la galleria: ${errore.message}`, true);
            }
        };

        const mostraFeedbackClienti = (messaggio, errore = false) => {
            clientFeedback.textContent = messaggio;
            clientFeedback.className = errore ? 'text-xs text-red-400' : 'text-xs text-sky-400';
        };

        const caricaClienti = async () => {
            try {
                const risposta = await fetch('/api/clienti');
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                const risultato = await risposta.json();
                if (!Array.isArray(risultato.dati)) throw new Error('Formato della risposta non valido.');
                clientsList.replaceChildren();
                if (!risultato.dati.length) {
                    const vuoto = document.createElement('p');
                    vuoto.className = 'rounded-xl border border-zinc-800 bg-zinc-900 p-5 text-sm text-zinc-400';
                    vuoto.textContent = 'Non ci sono ancora account clienti.';
                    clientsList.appendChild(vuoto);
                    return;
                }
                risultato.dati.forEach((cliente) => {
                    const scheda = document.createElement('article');
                    scheda.className = 'flex flex-wrap items-center justify-between gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-5 shadow-lg';
                    const informazioni = document.createElement('div');
                    informazioni.className = 'grid gap-1';
                    const nome = document.createElement('strong');
                    nome.className = 'text-base font-bold text-white';
                    nome.textContent = cliente.nome;
                    const email = document.createElement('span');
                    email.className = 'text-xs text-zinc-400 font-mono';
                    email.textContent = cliente.email;
                    informazioni.append(nome, email);
                    const azioni = document.createElement('div');
                    azioni.className = 'flex items-center gap-3';

                    const richieste = document.createElement('span');
                    richieste.className = 'rounded-lg border border-sky-500/30 bg-sky-500/10 px-3 py-1 text-xs font-mono font-bold text-sky-400';
                    richieste.textContent = `${cliente.preventivi} ${cliente.preventivi === 1 ? 'preventivo' : 'preventivi'}`;

                    const btnReset = document.createElement('button');
                    btnReset.type = 'button';
                    btnReset.className = 'rounded-lg border border-zinc-700 bg-zinc-800 hover:border-amber-500/50 hover:bg-amber-500/10 hover:text-amber-400 text-zinc-300 text-xs px-3 py-1.5 font-semibold transition cursor-pointer flex items-center gap-1.5';
                    btnReset.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg><span>Reimposta password</span>';
                    btnReset.addEventListener('click', async () => {
                        const passRandom = generaPasswordRandom(14);
                        const nuovaPass = prompt(`Inserisci la nuova password per ${cliente.email} (minimo 12 caratteri, pre-compilata casuale):`, passRandom);
                        if (!nuovaPass) return;
                        if (nuovaPass.length < 12) {
                            alert('La password deve contenere almeno 12 caratteri.');
                            return;
                        }
                        try {
                            btnReset.disabled = true;
                            btnReset.textContent = 'Aggiornamento...';
                            const res = await fetch(`/api/clienti/${cliente.id}/password`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ password: nuovaPass }),
                            });
                            if (!res.ok) throw new Error((await res.json()).detail || `HTTP ${res.status}`);
                            alert(`Password aggiornata per ${cliente.email}! Comunicala al cliente.`);
                        } catch (e) {
                            alert(`Errore: ${e.message}`);
                        } finally {
                            btnReset.disabled = false;
                            btnReset.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg><span>Reimposta password</span>';
                        }
                    });

                    const btnEliminaCliente = document.createElement('button');
                    btnEliminaCliente.type = 'button';
                    btnEliminaCliente.className = 'rounded-lg border border-red-500/20 bg-red-500/10 hover:border-red-500/40 hover:bg-red-500/20 text-red-400 text-xs px-3 py-1.5 font-semibold transition cursor-pointer flex items-center gap-1.5 shadow-sm';
                    btnEliminaCliente.title = `Elimina account ${cliente.email}`;
                    btnEliminaCliente.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg><span>Elimina</span>';
                    btnEliminaCliente.addEventListener('click', () => {
                        apriConfermaEliminazione({
                            tipo: 'cliente',
                            id: cliente.id,
                            titolo: 'Elimina Account Cliente',
                            target: cliente.email,
                            dettagli: `Cliente: ${cliente.nome} · Richieste preventivo collegate: ${cliente.preventivi}`,
                            onConfirm: async () => {
                                const res = await fetch(`/api/clienti/${cliente.id}`, { method: 'DELETE' });
                                if (!res.ok) throw new Error((await res.json()).detail || `HTTP ${res.status}`);
                                mostraFeedbackClienti(`Account ${cliente.email} eliminato.`);
                                await caricaClienti();
                            }
                        });
                    });

                    azioni.append(richieste, btnReset, btnEliminaCliente);
                    scheda.append(informazioni, azioni);
                    clientsList.appendChild(scheda);
                });
            } catch (errore) {
                mostraFeedbackClienti(`Impossibile caricare gli account: ${errore.message}`, true);
            }
        };

        clientForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            clientSubmit.disabled = true;
            mostraFeedbackClienti('Creazione account in corso...');
            const dati = new FormData(clientForm);
            try {
                const risposta = await fetch('/api/clienti', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        nome: dati.get('nome'),
                        email: dati.get('email'),
                        password: dati.get('password'),
                    }),
                });
                if (!risposta.ok) throw new Error((await risposta.json()).detail || `HTTP ${risposta.status}`);
                const cliente = await risposta.json();
                clientForm.reset();
                impostaNuovaPasswordRandom();
                mostraFeedbackClienti(`Account creato per ${cliente.email}. Credenziali inviate via email.`);
                await caricaClienti();
            } catch (errore) {
                mostraFeedbackClienti(`Impossibile creare l’account: ${errore.message}`, true);
            } finally {
                clientSubmit.disabled = false;
            }
        });

        workForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            const fd = new FormData(workForm);
            const titolo = String(fd.get('titolo') || '').trim();
            if (!titolo) {
                mostraFeedbackLavori('Inserisci almeno il titolo del lavoro.', true);
                return;
            }
            if (codeMedia.prima.length === 0 && codeMedia.dopo.length === 0) {
                mostraFeedbackLavori('Seleziona almeno una foto Prima o una foto Dopo per pubblicare il lavoro.', true);
                return;
            }

            workSubmit.disabled = true;
            impostaProgressoLavori(6);
            mostraFeedbackLavori('Salvataggio scheda tecnica in corso...');

            const payload = {
                titolo,
                categoria: String(fd.get('categoria') || 'Impermeabilizzazioni'),
                localita: String(fd.get('localita') || '').trim(),
                superficie_mq: Math.max(0, Number(fd.get('superficie_mq') || 0) || 0),
                applicazione: String(fd.get('applicazione') || '').trim(),
                supporto: String(fd.get('supporto') || '').trim(),
                ciclo_sistema: String(fd.get('ciclo_sistema') || '').trim(),
                armatura: String(fd.get('armatura') || '').trim(),
                descrizione: String(fd.get('descrizione') || '').trim(),
                stratigrafia_descrizione: String(fd.get('stratigrafia_descrizione') || '').trim(),
                stratigrafia_fasi: builderFasiForm.leggiFasi(),
            };

            let createdId = null;
            try {
                const resCreate = await fetch('/api/lavori', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                if (!resCreate.ok) {
                    let detail = `HTTP ${resCreate.status}`;
                    try { detail = (await resCreate.json()).detail || detail; } catch {}
                    throw new Error(detail);
                }
                const created = await resCreate.json();
                createdId = created.id;

                const uploadTasks = [
                    ...codeMedia.prima.map((item, idx) => ({ tipo: 'prima', label: `Foto Prima ${idx + 1}`, item, ordine: idx })),
                    ...codeMedia.dopo.map((item, idx) => ({ tipo: 'dopo', label: `Foto Dopo ${idx + 1}`, item, ordine: idx })),
                    ...codeMedia.video.map((item, idx) => ({ tipo: 'video', label: `Video ${idx + 1}`, item, ordine: idx })),
                ];

                for (let i = 0; i < uploadTasks.length; i++) {
                    const task = uploadTasks[i];
                    const pct = 12 + ((i + 1) / uploadTasks.length) * 84;
                    mostraFeedbackLavori(`Caricamento ${i + 1}/${uploadTasks.length}: ${task.label}...`);
                    impostaProgressoLavori(pct);
                    await caricaSingoloMediaSuApi(createdId, task.tipo, task.item, task.ordine);
                }

                impostaProgressoLavori(100);
                workForm.reset();
                builderFasiForm.impostaFasi([]);
                svuotaCodeMedia();
                mostraFeedbackLavori(`Lavoro pubblicato con successo (${uploadTasks.length} media caricati)! Visibile subito su /lavori.`);
                await caricaLavori();
            } catch (errore) {
                if (createdId) {
                    mostraFeedbackLavori(`Scheda creata (#${createdId}) ma errore durante il caricamento media: ${errore.message}. Puoi completare gli allegati nella lista sotto.`, true);
                    await caricaLavori();
                } else {
                    mostraFeedbackLavori(`Impossibile pubblicare: ${errore.message}`, true);
                }
            } finally {
                workSubmit.disabled = false;
                setTimeout(() => impostaProgressoLavori(null), 900);
            }
        });

        const mostraSchedaAdmin = (sezione) => {
            const mostraLavori = sezione === 'lavori';
            const mostraClienti = sezione === 'clienti';
            tableSection.classList.toggle('hidden', mostraLavori || mostraClienti);
            worksSection.classList.toggle('hidden', !mostraLavori);
            clientsSection.classList.toggle('hidden', !mostraClienti);
            tabPreventivi.setAttribute('aria-selected', String(sezione === 'preventivi'));
            tabLavori.setAttribute('aria-selected', String(mostraLavori));
            tabClienti.setAttribute('aria-selected', String(mostraClienti));
            const classeAttiva = 'rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-bold text-white';
            const classeInattiva = 'rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white transition';
            tabPreventivi.className = sezione === 'preventivi' ? classeAttiva : classeInattiva;
            tabLavori.className = mostraLavori ? classeAttiva : classeInattiva;
            tabClienti.className = mostraClienti ? classeAttiva : classeInattiva;
            if (mostraLavori) caricaLavori();
            if (mostraClienti) caricaClienti();
        };

        tabPreventivi.addEventListener('click', () => mostraSchedaAdmin('preventivi'));
        tabLavori.addEventListener('click', () => mostraSchedaAdmin('lavori'));
        tabClienti.addEventListener('click', () => mostraSchedaAdmin('clienti'));

        const caricaPreventivi = async () => {
            if (!isLogged) {
                window.location.replace('/accesso-preventivi');
                return;
            }
            try {
                const response = await fetch('/api/preventivi');

                if (response.status === 401) {
                    sessionStorage.removeItem(sessionKey);
                    window.location.replace('/accesso-preventivi?scaduta');
                    return;
                }

                if (!response.ok) {
                    throw new Error(`Il server ha risposto con errore HTTP ${response.status}.`);
