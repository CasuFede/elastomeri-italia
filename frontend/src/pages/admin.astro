                                btnDownload.title = `Scarica ${allegato.nome}`;
                                btnDownload.setAttribute('aria-label', `Scarica foto ${allegato.nome}`);
                                btnDownload.innerHTML = '<svg class="w-2 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>';
                                btnDownload.addEventListener('click', (e) => {
