        deleteCancelBtn?.addEventListener('click', () => {
            deleteDialog.close();
            pendingDeleteAction = null;
        });

        deleteDialog?.addEventListener('click', (e) => {
            if (e.target === deleteDialog) {
                deleteDialog.close();
                pendingDeleteAction = null;
