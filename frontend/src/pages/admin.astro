---
import '../styles/global.css';
// frontend/src/pages/admin.astro
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin - Storico Preventivi</title>
</head>
<body class="bg-gray-100 p-8 font-sans">

    <div class="max-w-6xl mx-auto">
        <h1 class="text-3xl font-bold mb-8 text-gray-800">Pannello Amministrazione Preventivi</h1>

        <!-- SEZIONE LOGIN -->
        <div id="login-section" class="bg-white p-6 rounded-lg shadow-md max-w-sm mb-8">
            <h2 class="text-xl font-semibold mb-4">Accesso Richiesto</h2>
            <input type="text" id="username" placeholder="Username" class="w-full mb-3 p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none" />
            <input type="password" id="password" placeholder="Password" class="w-full mb-4 p-2 border rounded focus:ring-2 focus:ring-blue-500 outline-none" />
            <button id="login-btn" class="w-full bg-blue-600 text-white font-bold p-2 rounded hover:bg-blue-700 transition">Accedi</button>
            <p id="error-msg" class="text-red-500 text-sm mt-2 hidden">Credenziali errate o errore di connessione.</p>
        </div>

        <!-- SEZIONE TABELLA (Nascosta di default) -->
        <div id="table-section" class="bg-white rounded-lg shadow-md overflow-x-auto hidden">
            <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                <span class="font-semibold text-gray-700">Totale richieste: <span id="total-count">0</span></span>
                <button id="logout-btn" class="text-sm text-red-600 hover:underline font-bold">Esci dal pannello</button>
            </div>
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-800 text-white">
                        <th class="p-3">ID</th>
                        <th class="p-3">Data</th>
                        <th class="p-3">Nome</th>
                        <th class="p-3">Contatti</th>
                        <th class="p-3">Servizio</th>
                        <th class="p-3">Messaggio</th>
                    </tr>
                </thead>
                <tbody id="table-body" class="divide-y">
                    <!-- I dati verranno inseriti qui -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- is:inline dice ad Astro di non toccare questo script e passarlo puro al browser -->
    <script is:inline>
        const loginBtn = document.getElementById('login-btn');
        const logoutBtn = document.getElementById('logout-btn');
        const loginSection = document.getElementById('login-section');
        const tableSection = document.getElementById('table-section');
        const errorMsg = document.getElementById('error-msg');
        const tableBody = document.getElementById('table-body');
        const totalCount = document.getElementById('total-count');

        const formattaData = (dataIso) => {
            if (!dataIso) return '-';
            const data = new Date(dataIso);
            if (Number.isNaN(data.getTime())) return '-';
            return data.toLocaleString('it-IT', { 
                day: '2-digit', month: '2-digit', year: 'numeric', 
                hour: '2-digit', minute: '2-digit' 
            });
        };

        const creaCella = (contenuto, className = '') => {
            const cella = document.createElement('td');
            cella.className = className;
            cella.textContent = contenuto ?? '-';
            return cella;
        };

        loginBtn.addEventListener('click', async () => {
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;

            if(!user || !pass) {
                alert("Inserisci username e password!");
                return;
            }

            const token = btoa(user + ":" + pass);

            try {
                const response = await fetch('/api/preventivi', {
                    headers: { 'Authorization': `Basic ${token}` }
                });

                if (response.status === 401) {
                    errorMsg.textContent = 'Username o password non corretti.';
                    errorMsg.classList.remove('hidden');
                    return;

                }

                if (!response.ok) {
                    errorMsg.textContent = `Errore del server: HTTP ${response.status}.`;
                    errorMsg.classList.remove('hidden');
                    return;
                }

                const data = await response.json();
                if (!Array.isArray(data.dati)) {
                    throw new Error('Formato della risposta API non valido.');
                }
                
                loginSection.classList.add('hidden');
                errorMsg.classList.add('hidden');
                tableSection.classList.remove('hidden');
                
                totalCount.textContent = data.dati.length;
                tableBody.innerHTML = ''; 

                if (data.dati.length === 0) {
                    const tr = document.createElement('tr');
                    const cella = creaCella('Nessun preventivo ricevuto.', 'p-6 text-center text-gray-500');
                    cella.colSpan = 6;
                    tr.appendChild(cella);
                    tableBody.appendChild(tr);
                } else {
                    data.dati.forEach(prev => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-gray-50';
                        tr.appendChild(creaCella(`#${prev.id}`, 'p-3 font-semibold text-gray-600'));
                        tr.appendChild(creaCella(formattaData(prev.data_richiesta), 'p-3 whitespace-nowrap text-sm'));
                        tr.appendChild(creaCella(prev.nome, 'p-3 font-medium'));

                        const contatti = document.createElement('td');
                        contatti.className = 'p-3 text-sm';
                        const email = document.createElement('a');
                        email.href = `mailto:${prev.email}`;
                        email.className = 'text-blue-600 hover:underline block';
                        email.textContent = prev.email ?? '-';
                        const telefono = document.createElement('a');
                        telefono.href = `tel:${prev.telefono}`;
                        telefono.className = 'text-gray-500 hover:underline';
                        telefono.textContent = prev.telefono ?? '-';
                        contatti.append(email, telefono);
                        tr.appendChild(contatti);

                        const servizio = document.createElement('td');
                        servizio.className = 'p-3';
                        const badge = document.createElement('span');
                        badge.className = 'bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-semibold';
                        badge.textContent = prev.servizio ?? '-';
                        servizio.appendChild(badge);
                        tr.appendChild(servizio);

                        const messaggio = creaCella(prev.messaggio || '-', 'p-3 text-sm text-gray-700 max-w-xs truncate');
                        messaggio.title = prev.messaggio || '';
                        tr.appendChild(messaggio);
                        tableBody.appendChild(tr);
                    });
                }

            } catch (error) {
                console.error("Errore fetch:", error);
                errorMsg.textContent = 'Impossibile caricare i preventivi. Riprova tra poco.';
                errorMsg.classList.remove('hidden');
            }
        });

        logoutBtn.addEventListener('click', () => {
            tableSection.classList.add('hidden');
            loginSection.classList.remove('hidden');
            document.getElementById('password').value = '';
            tableBody.innerHTML = '';
        });
    </script>
</body>
</html>