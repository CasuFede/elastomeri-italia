            risposta.dati.forEach((preventivo) => {
                const stato = stati[preventivo.stato] || stati.ricevuto;
                const card = document.createElement('article');
                card.className = 'rounded-2xl border border-zinc-800 bg-zinc-900/90 p-6 sm:p-7 shadow-xl hover:border-zinc-700 transition flex flex-col justify-between gap-5 relative overflow-hidden';

                // 1. Intestazione Card: Kicker + Titolo + Data + Badge Stato
                const topHeader = document.createElement('div');
                topHeader.className = 'flex flex-wrap items-start justify-between gap-4 pb-4 border-b border-zinc-800/80';
                
                const titleBlock = document.createElement('div');
                titleBlock.className = 'min-w-0 flex-1';
                
                const kicker = document.createElement('p');
                kicker.className = 'text-[11px] font-bold uppercase tracking-wider text-sky-400 mb-1';
                kicker.textContent = `RICHIESTA #${preventivo.id}`;
                
                const serviceTitle = document.createElement('h3');
                serviceTitle.className = 'text-lg sm:text-xl font-bold text-white leading-snug';
                serviceTitle.textContent = preventivo.servizio || 'Richiesta di intervento';
                
                const reqDate = document.createElement('p');
                reqDate.className = 'text-xs text-zinc-400 mt-1 flex items-center gap-1.5';
                const formattedDate = new Date(preventivo.data_richiesta).toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric' });
                reqDate.innerHTML = '<svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>';
                const reqDateSpan = document.createElement('span');
