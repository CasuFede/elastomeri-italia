        });
        const stati = {
            ricevuto: { label: 'Ricevuto', progress: 15 },
            in_valutazione: { label: 'In valutazione', progress: 35 },
            preventivo_inviato: { label: 'Preventivo inviato', progress: 58 },
            in_lavorazione: { label: 'In lavorazione', progress: 82 },
            completato: { label: 'Completato', progress: 100 },
            annullato: { label: 'Annullato', progress: 0 },
