---
import '../styles/global.css';
---

<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#05070b" />
    <title>Area clienti | Poliurea System</title>
</head>
<body class="customer-body min-h-screen bg-black text-zinc-200">
    <div class="customer-shell w-full max-w-5xl mx-auto px-4 sm:px-6">
        <header class="customer-header flex items-center justify-between py-6 border-b border-zinc-800 mb-10">
            <a href="/" class="customer-brand inline-flex items-center" aria-label="Poliurea System, home">
                <picture>
                    <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                    <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="180" height="40" />
                </picture>
            </a>
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-sky-400">POLIUREA SYSTEM</p>
                <h1 class="text-xl font-bold text-white">Area clienti</h1>
            </div>
            <a class="customer-back text-xs font-semibold text-zinc-400 hover:text-sky-400 border border-zinc-800 bg-zinc-900 px-3 py-1.5 rounded-lg transition" href="/">Torna al sito</a>
        </header>

        <main>
            <section id="customer-login" class="customer-login my-8 grid gap-8 md:grid-cols-2 items-center">
                <div class="customer-intro">
                    <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">IL TUO INTERVENTO, AGGIORNATO</p>
                    <h2 class="text-3xl font-extrabold text-white tracking-tight leading-tight mb-4">Segui il tuo<br /><span class="text-sky-400">preventivo.</span></h2>
                    <p class="text-zinc-400 text-base leading-relaxed">Accedi per controllare lo stato delle richieste, leggere le indicazioni e scaricare i tuoi allegati.</p>
                </div>
                <div class="customer-login-panel rounded-2xl border border-zinc-800 bg-zinc-900 p-8 sm:p-10 shadow-2xl shadow-black/80">
                    <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">ACCESSO CLIENTI</p>
                    <h2 class="text-2xl font-extrabold text-white tracking-tight mb-2">Accedi alla tua area</h2>
                    <p class="text-zinc-400 text-sm mb-6">Usa l’email associata al preventivo e la password ricevuta.</p>
                    <form id="customer-login-form" class="customer-form grid gap-4">
                        <label for="customer-email" class="grid gap-2 text-xs font-semibold text-zinc-300">Email</label>
                        <input id="customer-email" type="email" autocomplete="username" required class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <label for="customer-password" class="grid gap-2 text-xs font-semibold text-zinc-300">Password</label>
                        <input id="customer-password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <button id="customer-login-button" type="submit" class="w-full rounded-xl bg-sky-500 p-3.5 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-400 hover:-translate-y-0.5 mt-2">Accedi</button>
                    </form>
                    <p id="customer-login-error" class="customer-error mt-4 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400" role="alert" aria-live="polite" hidden></p>
                </div>
            </section>

            <section id="customer-dashboard" class="customer-dashboard my-8" hidden>
                <div class="customer-dashboard-heading flex items-center justify-between pb-6 border-b border-zinc-800 mb-8">
                    <div>
                        <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">AREA PERSONALE</p>
                        <h2 class="text-2xl font-extrabold text-white">Ciao, <span id="customer-name" class="text-sky-400"></span></h2>
                        <p id="customer-email-label" class="text-xs text-zinc-400"></p>
                    </div>
                    <button id="customer-logout" type="button" class="rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-2 text-xs font-semibold text-zinc-300 hover:border-red-500/40 hover:text-red-400 transition">Esci</button>
                </div>
                <div id="customer-requests" class="customer-requests grid gap-6"></div>
                <p id="customer-dashboard-error" class="customer-error mt-4 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400" role="alert" aria-live="polite" hidden></p>
            </section>
        </main>
    </div>

    <script is:inline>
        const sessionKey = 'poliurea-client-logged';
        const loginSection = document.getElementById('customer-login');
        const dashboard = document.getElementById('customer-dashboard');
        const loginForm = document.getElementById('customer-login-form');
        const loginButton = document.getElementById('customer-login-button');
        const loginError = document.getElementById('customer-login-error');
        const dashboardError = document.getElementById('customer-dashboard-error');
        const requestsContainer = document.getElementById('customer-requests');
        const stati = {
            ricevuto: { label: 'Ricevuto', progress: 15 },
            in_valutazione: { label: 'In valutazione', progress: 35 },
            preventivo_inviato: { label: 'Preventivo inviato', progress: 58 },
            in_lavorazione: { label: 'In lavorazione', progress: 82 },
            completato: { label: 'Completato', progress: 100 },
            annullato: { label: 'Annullato', progress: 0 },
        };

        const mostraErroreAccesso = (messaggio) => {
            loginError.textContent = messaggio;
            loginError.hidden = false;
        };

        const creaDettaglio = (etichetta, valore) => {
            const dettaglio = document.createElement('p');
            dettaglio.className = 'customer-request-detail';
            const titolo = document.createElement('strong');
            titolo.textContent = etichetta;
            const testo = document.createElement('span');
            testo.textContent = valore;
            dettaglio.append(titolo, testo);
            return dettaglio;
        };

        const mostraRichieste = (risposta) => {
            document.getElementById('customer-name').textContent = risposta.cliente.nome;
            document.getElementById('customer-email-label').textContent = risposta.cliente.email;
            requestsContainer.replaceChildren();
            if (!risposta.dati.length) {
                const vuoto = document.createElement('p');
                vuoto.className = 'customer-empty';
                vuoto.textContent = 'Non risultano ancora preventivi associati a questo indirizzo email.';
                requestsContainer.appendChild(vuoto);
            }

            risposta.dati.forEach((preventivo) => {
                const stato = stati[preventivo.stato] || stati.ricevuto;
                const scheda = document.createElement('article');
                scheda.className = 'customer-request';
                const intestazione = document.createElement('div');
                intestazione.className = 'customer-request-heading';
                const titolo = document.createElement('div');
                const riferimento = document.createElement('p');
                riferimento.className = 'customer-kicker';
                riferimento.textContent = `RICHIESTA #${preventivo.id}`;
                const servizio = document.createElement('h3');
                servizio.textContent = preventivo.servizio || 'Richiesta di preventivo';
                const data = document.createElement('p');
                data.className = 'customer-request-date';
                data.textContent = new Date(preventivo.data_richiesta).toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric' });
                titolo.append(riferimento, servizio, data);
                const badge = document.createElement('span');
                badge.className = `customer-status customer-status-${preventivo.stato}`;
                badge.textContent = preventivo.stato_label || stato.label;
                intestazione.append(titolo, badge);
                scheda.appendChild(intestazione);

                const progresso = document.createElement('div');
                progresso.className = 'customer-progress';
                progresso.setAttribute('role', 'progressbar');
                progresso.setAttribute('aria-valuenow', String(stato.progress));
                progresso.setAttribute('aria-valuemin', '0');
                progresso.setAttribute('aria-valuemax', '100');
                progresso.setAttribute('aria-label', `Avanzamento: ${stato.label}`);
                const barra = document.createElement('span');
                barra.style.width = `${stato.progress}%`;
                progresso.appendChild(barra);
                scheda.appendChild(progresso);

                if (preventivo.note_cliente) {
                    const nota = document.createElement('div');
                    nota.className = 'customer-action-needed';
                    const etichetta = document.createElement('strong');
                    etichetta.textContent = 'Cosa serve da te';
                    const testo = document.createElement('p');
                    testo.textContent = preventivo.note_cliente;
                    nota.append(etichetta, testo);
                    scheda.appendChild(nota);
                } else {
                    scheda.appendChild(creaDettaglio('Aggiornamenti', 'Al momento non ci sono informazioni aggiuntive richieste.'));
                }

                if (preventivo.messaggio) scheda.appendChild(creaDettaglio('Dettagli della richiesta', preventivo.messaggio));
                if (preventivo.allegati.length) {
                    const allegati = document.createElement('div');
                    allegati.className = 'customer-attachments';
                    const etichetta = document.createElement('strong');
                    etichetta.textContent = 'I tuoi allegati';
                    allegati.appendChild(etichetta);
                    preventivo.allegati.forEach((allegato) => {
                        const scarica = document.createElement('button');
                        scarica.type = 'button';
                        scarica.textContent = allegato.nome;
                        scarica.addEventListener('click', async () => {
                            try {
                                const file = await fetch(`/api/area-clienti/preventivi/${preventivo.id}/allegati/${allegato.id}`);
                                if (!file.ok) throw new Error(`HTTP ${file.status}`);
                                const url = URL.createObjectURL(await file.blob());
                                const link = document.createElement('a');
                                link.href = url;
                                link.download = allegato.nome;
                                link.click();
                                URL.revokeObjectURL(url);
                            } catch (errore) {
                                dashboardError.textContent = `Impossibile scaricare l’allegato: ${errore.message}`;
                                dashboardError.hidden = false;
                            }
                        });
                        allegati.appendChild(scarica);
                    });
                    scheda.appendChild(allegati);
                }
                requestsContainer.appendChild(scheda);
            });

            loginSection.hidden = true;
            dashboard.hidden = false;
        };

        const caricaAreaCliente = async () => {
            try {
                const risposta = await fetch('/api/area-clienti');
                if (risposta.status === 401) {
                    sessionStorage.removeItem(sessionKey);
                    loginSection.hidden = false;
                    dashboard.hidden = true;
                    mostraErroreAccesso('Credenziali non valide o sessione scaduta.');
                    return;
                }
                if (!risposta.ok) throw new Error(`Errore del server (HTTP ${risposta.status}).`);
                mostraRichieste(await risposta.json());
            } catch (errore) {
                dashboardError.textContent = errore.message || 'Impossibile caricare i tuoi dati. Verifica la connessione.';
                dashboardError.hidden = false;
            }
        };

        loginForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            const email = document.getElementById('customer-email').value.trim().toLowerCase();
            const password = document.getElementById('customer-password').value;
            loginButton.disabled = true;
            loginButton.textContent = 'Verifica accesso...';
            loginError.hidden = true;
            try {
                const risposta = await fetch('/api/auth/cliente/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password }),
                });
                if (risposta.status === 401) throw new Error('Email o password non corrette.');
                if (!risposta.ok) {
                    const err = await risposta.json().catch(() => ({}));
                    throw new Error(err.detail || `Errore del server (HTTP ${risposta.status}).`);
                }
                sessionStorage.setItem(sessionKey, '1');
                await caricaAreaCliente();
            } catch (errore) {
                sessionStorage.removeItem(sessionKey);
                mostraErroreAccesso(errore.message || 'Impossibile accedere. Riprova tra poco.');
            } finally {
                loginButton.disabled = false;
                loginButton.textContent = 'Accedi';
            }
        });

        document.getElementById('customer-logout').addEventListener('click', async () => {
            sessionStorage.removeItem(sessionKey);
            dashboard.hidden = true;
            loginForm.reset();
            loginSection.hidden = false;
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (_) {}
        });

        if (sessionStorage.getItem(sessionKey) === '1') caricaAreaCliente();
    </script>
</body>
</html>
