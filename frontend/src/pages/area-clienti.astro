        const mostraErroreAccesso = (messaggio) => {
            loginError.textContent = messaggio;
            loginError.hidden = false;
        };

        const mostraRichieste = (risposta) => {
            document.getElementById('customer-name').textContent = risposta.cliente.nome;
            document.getElementById('customer-email-label').textContent = risposta.cliente.email;
            
            // Aggiorna statistiche riassuntive
            const totalPreventivi = risposta.dati.length;
            const totalAllegati = risposta.dati.reduce((tot, p) => tot + (p.allegati ? p.allegati.length : 0), 0);
            const primoStato = totalPreventivi > 0 ? (stati[risposta.dati[0].stato]?.label || risposta.dati[0].stato_label || risposta.dati[0].stato) : '-';

            const statPrevEl = document.getElementById('stat-preventivi-totali');
            const statStatoEl = document.getElementById('stat-ultimo-stato');
            const statAllegatiEl = document.getElementById('stat-allegati-totali');
            if (statPrevEl) statPrevEl.textContent = totalPreventivi;
            if (statStatoEl) statStatoEl.textContent = primoStato;
            if (statAllegatiEl) statAllegatiEl.textContent = totalAllegati;

            // Se è il primo accesso, apri la modale obbligatoria di cambio password
            if (risposta.cliente && risposta.cliente.primo_accesso) {
                validateFirstAccessPassword();
                firstAccessDialog?.showModal();
            }

            requestsContainer.replaceChildren();
            if (!risposta.dati.length) {
                const vuoto = document.createElement('div');
                vuoto.className = 'col-span-full rounded-2xl border border-zinc-800 bg-zinc-900/60 p-10 text-center text-zinc-400';
                vuoto.innerHTML = `
                    <svg class="w-10 h-10 text-zinc-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <p class="font-medium text-white text-base mb-1">Nessun preventivo associato</p>
                    <p class="text-xs text-zinc-400">Non risultano ancora preventivi associati a questo indirizzo email.</p>
                `;
                requestsContainer.appendChild(vuoto);
            }

            const badgeStyles = {
                ricevuto: 'bg-sky-500/15 border-sky-500/30 text-sky-400',
                in_valutazione: 'bg-amber-500/15 border-amber-500/30 text-amber-400',
                preventivo_inviato: 'bg-indigo-500/15 border-indigo-500/30 text-indigo-400',
                in_lavorazione: 'bg-cyan-500/15 border-cyan-500/30 text-cyan-400',
                completato: 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400',
                annullato: 'bg-zinc-800 border-zinc-700 text-zinc-400',
