                    emptyNote.innerHTML = `
                        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span>Nessun documento o chiarimento aggiuntivo richiesto al momento.</span>
                    `;
                    card.appendChild(emptyNote);
                }

                // 4. Dettagli della Richiesta
                if (preventivo.messaggio) {
                    const detailsBox = document.createElement('div');
                    detailsBox.className = 'rounded-xl border border-zinc-800/70 bg-zinc-950/40 p-4 text-xs space-y-1.5';
                    const detailsLabel = document.createElement('p');
                    detailsLabel.className = 'text-[11px] font-bold uppercase tracking-wider text-zinc-400';
                    detailsLabel.textContent = 'Dettagli dell’intervento';
                    const detailsContent = document.createElement('div');
                    detailsContent.className = 'text-zinc-300 whitespace-pre-wrap leading-relaxed';
                    detailsContent.textContent = preventivo.messaggio;
                    detailsBox.append(detailsLabel, detailsContent);
                    card.appendChild(detailsBox);
                }

                // 5. Foto e Allegati caricati con anteprima visuale
                if (preventivo.allegati && preventivo.allegati.length) {
                    const allegatiBox = document.createElement('div');
                    allegatiBox.className = 'pt-3 border-t border-zinc-800/80 space-y-2.5';
                    
                    const allegatiHeader = document.createElement('div');
                    allegatiHeader.className = 'flex items-center justify-between text-xs';
                    
                    const allegatiTitle = document.createElement('p');
                    allegatiTitle.className = 'text-[11px] font-bold uppercase tracking-wider text-sky-400 flex items-center gap-1.5';
                    allegatiTitle.innerHTML = '<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>';
                    const allegatiTitleSpan = document.createElement('span');
                    allegatiTitleSpan.textContent = `Foto allegate all'intervento (${preventivo.allegati.length})`;
                    allegatiTitle.appendChild(allegatiTitleSpan);

                    const allegatiHint = document.createElement('span');
                    allegatiHint.className = 'text-[11px] text-zinc-500 hidden sm:inline';
                    allegatiHint.textContent = 'Clicca per ingrandire';

                    allegatiHeader.append(allegatiTitle, allegatiHint);
                    
                    const allegatiGrid = document.createElement('div');
                    allegatiGrid.className = 'grid grid-cols-2 sm:grid-cols-3 gap-3 pt-1';

                    preventivo.allegati.forEach((allegato) => {
                        const thumbCard = document.createElement('div');
                        thumbCard.className = 'group relative rounded-xl border border-zinc-800 bg-zinc-950 overflow-hidden hover:border-sky-500/50 transition-all duration-200 shadow-md flex flex-col';

                        // Area Immagine con Aspect Ratio e Zoom Hover
                        const imgWrap = document.createElement('div');
                        imgWrap.className = 'relative w-full aspect-[4/3] overflow-hidden bg-zinc-900 cursor-pointer';
                        imgWrap.setAttribute('role', 'button');
                        imgWrap.setAttribute('tabindex', '0');
                        imgWrap.setAttribute('aria-label', `Ingrandisci foto ${allegato.nome}`);
                        
                        const img = document.createElement('img');
                        img.src = `/api/area-clienti/preventivi/${preventivo.id}/allegati/${allegato.id}`;
                        img.alt = allegato.nome;
                        img.className = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300';
                        img.loading = 'lazy';

                        // Overlay con lente di ingrandimento on hover
                        const zoomOverlay = document.createElement('div');
                        zoomOverlay.className = 'absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white transition duration-200';
                        zoomOverlay.innerHTML = `
                            <span class="rounded-full bg-black/70 p-2 text-sky-400 border border-sky-400/30 shadow-lg">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                            </span>
                        `;
                        imgWrap.append(img, zoomOverlay);
                        imgWrap.addEventListener('click', () => {
                            apriFotoGrandeCliente(preventivo.id, allegato.id, allegato.nome, preventivo.servizio);
                        });
                        imgWrap.addEventListener('keydown', (e) => {
                            if (e.key === 'Enter' || e.key === ' ') {
                                e.preventDefault();
                                apriFotoGrandeCliente(preventivo.id, allegato.id, allegato.nome, preventivo.servizio);
                            }
                        });

                        // Didascalia e pulsante di download sotto l'immagine
                        const footer = document.createElement('div');
                        footer.className = 'p-2 flex items-center justify-between gap-1.5 border-t border-zinc-800/80 bg-zinc-900/70';
                        
                        const nomeLabel = document.createElement('span');
                        nomeLabel.className = 'text-[11px] text-zinc-300 truncate font-medium';
                        nomeLabel.title = allegato.nome;
                        nomeLabel.textContent = allegato.nome;

                        const downloadBtn = document.createElement('button');
                        downloadBtn.type = 'button';
                        downloadBtn.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-sky-500 hover:text-white text-zinc-300 text-[10px] font-semibold transition shrink-0 cursor-pointer border border-zinc-700/80 shadow-sm';
                        downloadBtn.title = `Scarica ${allegato.nome}`;
                        downloadBtn.innerHTML = `
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            <span class="hidden sm:inline">Scarica</span>
                        `;
                        downloadBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            scaricaAllegatoCliente(preventivo.id, allegato.id, allegato.nome);
                        });

                        footer.append(nomeLabel, downloadBtn);
                        thumbCard.append(imgWrap, footer);
                        allegatiGrid.appendChild(thumbCard);
                    });

                    allegatiBox.append(allegatiHeader, allegatiGrid);
                    card.appendChild(allegatiBox);
                }

                requestsContainer.appendChild(card);
            });

            loginSection.hidden = true;
            dashboard.hidden = false;
        };

        const caricaAreaCliente = async () => {
            try {
                const risposta = await fetch('/api/area-clienti');
                if (risposta.status === 401) {
                    sessionStorage.removeItem(sessionKey);
                    loginSection.hidden = false;
                    dashboard.hidden = true;
                    mostraErroreAccesso('Credenziali non valide o sessione scaduta.');
                    return;
                }
                if (!risposta.ok) throw new Error(`Errore del server (HTTP ${risposta.status}).`);
                mostraRichieste(await risposta.json());
            } catch (errore) {
                dashboardError.textContent = errore.message || 'Impossibile caricare i tuoi dati. Verifica la connessione.';
                dashboardError.hidden = false;
            }
        };

        loginForm.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            const email = document.getElementById('customer-email').value.trim().toLowerCase();
            const password = document.getElementById('customer-password').value;
            loginButton.disabled = true;
            loginButton.textContent = 'Verifica accesso...';
            loginError.hidden = true;
            try {
                const risposta = await fetch('/api/auth/cliente/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password }),
                });
                if (risposta.status === 401) throw new Error('Email o password non corrette.');
                if (!risposta.ok) {
                    const err = await risposta.json().catch(() => ({}));
                    throw new Error(err.detail || `Errore del server (HTTP ${risposta.status}).`);
                }
                sessionStorage.setItem(sessionKey, '1');
                await caricaAreaCliente();
            } catch (errore) {
                sessionStorage.removeItem(sessionKey);
                mostraErroreAccesso(errore.message || 'Impossibile accedere. Riprova tra poco.');
            } finally {
                loginButton.disabled = false;
                loginButton.textContent = 'Accedi';
            }
        });

        document.getElementById('customer-logout').addEventListener('click', async () => {
            sessionStorage.removeItem(sessionKey);
            dashboard.hidden = true;
            loginForm.reset();
            loginSection.hidden = false;
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } catch (_) {}
        });

        // Pulsante di ricarica manuale rapida per aggiornare lo stato
        document.getElementById('customer-refresh-btn')?.addEventListener('click', async () => {
            const btn = document.getElementById('customer-refresh-btn');
            const svg = btn?.querySelector('svg');
            if (btn) btn.classList.add('opacity-70', 'pointer-events-none');
            if (svg) svg.classList.add('animate-spin');
            try {
                await caricaAreaCliente();
            } finally {
                setTimeout(() => {
                    if (btn) btn.classList.remove('opacity-70', 'pointer-events-none');
                    if (svg) svg.classList.remove('animate-spin');
                }, 300);
            }
        });

        // Auto-aggiornamento immediato al cambio di scheda/finestra del browser
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible' && sessionStorage.getItem(sessionKey) === '1') {
                caricaAreaCliente();
            }
        });

        // Gestione Recupero Password (Lost Password)
        const loginBoxNormal = document.getElementById('login-box-normal');
        const loginBoxLost = document.getElementById('login-box-lost');
        const btnShowLost = document.getElementById('btn-show-lost-password');
        const btnBackToLogin = document.getElementById('btn-back-to-login');
        const lostForm = document.getElementById('customer-lost-form');
        const lostEmail = document.getElementById('lost-email');
        const lostSubmit = document.getElementById('lost-submit-button');
        const lostFeedback = document.getElementById('lost-feedback');

        btnShowLost?.addEventListener('click', () => {
            loginBoxNormal.classList.add('hidden');
            loginBoxLost.classList.remove('hidden');
            loginError.hidden = true;
            lostFeedback.hidden = true;
            const currentEmail = document.getElementById('customer-email').value.trim();
            if (currentEmail) {
                lostEmail.value = currentEmail;
            }
            lostEmail.focus();
        });

        btnBackToLogin?.addEventListener('click', () => {
            loginBoxLost.classList.add('hidden');
            loginBoxNormal.classList.remove('hidden');
            lostFeedback.hidden = true;
        });

        lostForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = lostEmail.value.trim().toLowerCase();
            lostSubmit.disabled = true;
            lostSubmit.textContent = 'Invio nuova password in corso...';
            lostFeedback.hidden = true;
            try {
                const res = await fetch('/api/auth/cliente/lost-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.detail || `Errore del server (HTTP ${res.status})`);

                lostFeedback.className = 'mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs font-medium text-emerald-400 leading-relaxed';
                lostFeedback.textContent = data.message || 'Richiesta di recupero inviata con successo.';
                lostFeedback.hidden = false;
                lostForm.reset();
            } catch (err) {
                lostFeedback.className = 'mt-4 rounded-xl border border-red-500/30 bg-red-500/10 p-3.5 text-xs font-medium text-red-400 leading-relaxed';
                lostFeedback.textContent = err.message || 'Impossibile inviare la richiesta. Riprova tra poco.';
                lostFeedback.hidden = false;
            } finally {
                lostSubmit.disabled = false;
                lostSubmit.textContent = 'Invia nuova password provvisoria';
            }
        });

        // Helper Toggle Visibilità Password con Icona Occhio
        const eyeOpenSvg = `<svg class="w-4 h-4 text-zinc-400 hover:text-zinc-200 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
        const eyeOffSvg = `<svg class="w-4 h-4 text-zinc-400 hover:text-zinc-200 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>`;

        const setupPasswordToggle = (inputId, buttonId) => {
            const input = document.getElementById(inputId);
            const button = document.getElementById(buttonId);
            if (!input || !button) return;

            button.innerHTML = eyeOpenSvg;

            button.addEventListener('click', () => {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                button.innerHTML = isPassword ? eyeOffSvg : eyeOpenSvg;
                const newTitle = isPassword ? 'Nascondi password' : 'Mostra password';
                button.setAttribute('aria-label', newTitle);
                button.setAttribute('title', newTitle);
            });
        };

        setupPasswordToggle('customer-password', 'toggle-customer-password');
        setupPasswordToggle('first-access-password', 'toggle-first-pwd');
        setupPasswordToggle('first-access-confirm', 'toggle-first-confirm');

        // Validazione Live Requisiti Password Primo Accesso (Rosso -> Verde)
        function updateRequirement(el, valid) {
            if (!el) return;
            const icon = el.querySelector('.req-icon');
            if (valid) {
                el.classList.remove('text-red-400');
                el.classList.add('text-emerald-400');
                if (icon) icon.textContent = '✓';
            } else {
                el.classList.remove('text-emerald-400');
                el.classList.add('text-red-400');
                if (icon) icon.textContent = '✕';
            }
        }

        function validateFirstAccessPassword() {
            const pwd = firstAccessPwd ? firstAccessPwd.value : '';
            const confirm = firstAccessConfirm ? firstAccessConfirm.value : '';

            updateRequirement(document.getElementById('req-len'), pwd.length >= 8);
            updateRequirement(document.getElementById('req-upper'), /[A-Z]/.test(pwd));
            updateRequirement(document.getElementById('req-lower'), /[a-z]/.test(pwd));
            updateRequirement(document.getElementById('req-num'), /[0-9]/.test(pwd));
            updateRequirement(document.getElementById('req-match'), confirm.length > 0 && pwd === confirm);
        }

        firstAccessPwd?.addEventListener('input', validateFirstAccessPassword);
        firstAccessConfirm?.addEventListener('input', validateFirstAccessPassword);
        validateFirstAccessPassword();

        // Gestione Cambio Password al Primo Accesso
        firstAccessDialog?.addEventListener('cancel', (e) => {
            // Impedisce la chiusura con ESC finché non si cambia la password temporanea
            e.preventDefault();
        });

        firstAccessForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            firstAccessError.hidden = true;
            firstAccessSuccess.hidden = true;

            const pwd = firstAccessPwd.value.trim();
            const confirm = firstAccessConfirm.value.trim();

            if (pwd !== confirm) {
                firstAccessError.textContent = 'Le due password inserite non coincidono.';
                firstAccessError.hidden = false;
                firstAccessConfirm.focus();
                return;
            }

            const haMaiuscola = /[A-Z]/.test(pwd);
            const haMinuscola = /[a-z]/.test(pwd);
            const haNumero = /[0-9]/.test(pwd);
            if (pwd.length < 8 || !haMaiuscola || !haMinuscola || !haNumero) {
                firstAccessError.textContent = 'La password non rispetta i requisiti di sicurezza (minimo 8 caratteri, maiuscola, minuscola e numero).';
                firstAccessError.hidden = false;
                firstAccessPwd.focus();
                return;
            }

            firstAccessSubmit.disabled = true;
            firstAccessSubmit.textContent = 'Salvataggio nuova password...';

            try {
                const res = await fetch('/api/area-clienti/cambia-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: pwd }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.detail || `Errore del server (HTTP ${res.status})`);

                firstAccessSuccess.textContent = 'Password aggiornata con successo! Accesso alla dashboard in corso...';
                firstAccessSuccess.hidden = false;

                setTimeout(() => {
                    firstAccessDialog.close();
                    firstAccessForm.reset();
                    validateFirstAccessPassword();
                }, 1000);
            } catch (err) {
                firstAccessError.textContent = err.message || 'Impossibile aggiornare la password.';
                firstAccessError.hidden = false;
            } finally {
                firstAccessSubmit.disabled = false;
                firstAccessSubmit.textContent = 'Salva nuova password e continua';
            }
        });

        // Gestione Conferma Reset Password tramite token nel link (?reset=...)
        const confirmResetBox = document.getElementById('login-box-confirm-reset');
        const confirmResetForm = document.getElementById('confirm-reset-form');
        const confirmResetPwd = document.getElementById('confirm-reset-password');
        const confirmResetRepeat = document.getElementById('confirm-reset-repeat');
        const confirmResetSubmit = document.getElementById('confirm-reset-submit');
        const confirmResetFeedback = document.getElementById('confirm-reset-feedback');
        const btnBackFromReset = document.getElementById('btn-back-from-reset');
        const resetTokenFromUrl = new URLSearchParams(window.location.search).get('reset');

        if (resetTokenFromUrl && confirmResetBox) {
            document.getElementById('login-box-default')?.classList.add('hidden');
            document.getElementById('login-box-lost')?.classList.add('hidden');
            confirmResetBox.classList.remove('hidden');
            if (window.history && window.history.replaceState) {
                window.history.replaceState({}, document.title, '/area-clienti');
            }
        }

        btnBackFromReset?.addEventListener('click', () => {
            confirmResetBox?.classList.add('hidden');
            document.getElementById('login-box-default')?.classList.remove('hidden');
        });

        confirmResetForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!confirmResetFeedback) return;
            confirmResetFeedback.hidden = true;
            const pwd = confirmResetPwd.value.trim();
            const rep = confirmResetRepeat.value.trim();
            if (pwd !== rep) {
                confirmResetFeedback.className = 'mt-4 rounded-lg border border-red-500 bg-red-950 p-3 text-xs font-medium text-red-200';
                confirmResetFeedback.textContent = 'Le due password non coincidono.';
                confirmResetFeedback.hidden = false;
                return;
            }
            if (pwd.length < 8 || !/[A-Z]/.test(pwd) || !/[a-z]/.test(pwd) || !/[0-9]/.test(pwd)) {
                confirmResetFeedback.className = 'mt-4 rounded-lg border border-red-500 bg-red-950 p-3 text-xs font-medium text-red-200';
                confirmResetFeedback.textContent = 'La password deve avere almeno 8 caratteri, una maiuscola, una minuscola e un numero.';
                confirmResetFeedback.hidden = false;
                return;
            }
            confirmResetSubmit.disabled = true;
            confirmResetSubmit.textContent = 'Salvataggio in corso...';
            try {
                const res = await fetch('/api/auth/cliente/confirm-reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: resetTokenFromUrl, password: pwd }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.detail || `Errore (HTTP ${res.status})`);
                sessionStorage.setItem(sessionKey, '1');
                confirmResetFeedback.className = 'mt-4 rounded-lg border border-emerald-500 bg-emerald-950 p-3 text-xs font-medium text-emerald-200';
                confirmResetFeedback.textContent = data.message || 'Password aggiornata! Accesso in corso...';
                confirmResetFeedback.hidden = false;
                setTimeout(() => {
                    confirmResetBox?.classList.add('hidden');
                    document.getElementById('login-box-default')?.classList.remove('hidden');
                    caricaAreaCliente();
                }, 700);
            } catch (err) {
                confirmResetFeedback.className = 'mt-4 rounded-lg border border-red-500 bg-red-950 p-3 text-xs font-medium text-red-200';
                confirmResetFeedback.textContent = err.message || 'Link non valido o scaduto.';
                confirmResetFeedback.hidden = false;
            } finally {
                confirmResetSubmit.disabled = false;
                confirmResetSubmit.textContent = 'Salva nuova password e accedi';
            }
        });

        if (!resetTokenFromUrl && sessionStorage.getItem(sessionKey) === '1') caricaAreaCliente();
    </script>
</body>
</html>
