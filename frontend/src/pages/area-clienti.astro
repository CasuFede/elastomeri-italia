---
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/admin.css';
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#05070b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=4" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=4" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=4" />
    <link rel="shortcut icon" href="/favicon.ico?v=4" />
    <link rel="apple-touch-icon" href="/favicon-192x192.png?v=4" />
    <title>Area clienti | Poliurea System</title>
</head>
<body class="customer-body min-h-screen bg-black text-zinc-200">
    <div class="customer-shell w-full max-w-none min-h-screen">
        <header class="customer-header w-full px-4 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between py-6 border-b border-zinc-800 mb-8 gap-4">
            <a href="/" class="customer-brand inline-flex items-center" aria-label="Poliurea System, home">
                <picture>
                    <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                    <img src="/logo-poliurea-system.png" alt="Poliurea System" class="h-10 w-auto" width="200" height="34" />
                </picture>
            </a>
            <div class="flex flex-row items-center gap-4">
                <div class="text-right sm:text-left">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-sky-400">POLIUREA SYSTEM</p>
                    <h1 class="text-xl font-bold text-white">Area clienti</h1>
                </div>
                <a class="customer-back text-xs font-semibold text-zinc-400 hover:text-sky-400 border border-zinc-800 bg-zinc-900 px-3.5 py-2 rounded-xl transition hover:border-zinc-700" href="/">Torna al sito</a>
            </div>
        </header>

        <main class="w-full">
            <section id="customer-login" class="w-full max-w-7xl px-4 mx-auto my-12 flex flex-col items-center">
                <div class="customer-intro text-center mb-8 max-w-2xl">
                    <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">IL TUO INTERVENTO, AGGIORNATO</p>
                    <h2 class="text-3xl font-extrabold text-white tracking-tight leading-tight mb-4">Segui il tuo preventivo.</h2>
                    <p class="text-zinc-400 text-base leading-relaxed">Accedi per controllare lo stato delle richieste, leggere le indicazioni e scaricare i tuoi allegati.</p>
                </div>
                <div class="customer-login-panel w-full max-w-xl mx-auto rounded-2xl border border-zinc-800 bg-zinc-900 p-6 sm:p-10 shadow-2xl shadow-black/80">
                    <!-- Vista Accesso Standard -->
                    <div id="login-box-normal">
                        <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">ACCESSO CLIENTI</p>
                        <h2 class="text-2xl font-extrabold text-white tracking-tight mb-2">Accedi alla tua area</h2>
                        <p class="text-zinc-400 text-sm mb-6">Usa l’email associata al preventivo e la password ricevuta.</p>
                        <form id="customer-login-form" class="space-y-4">
                            <div>
                                <label for="customer-email" class="block text-xs font-semibold text-zinc-300 mb-1.5">Email</label>
                                <input id="customer-email" type="email" autocomplete="username" required placeholder="mario.rossi@example.com" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                            </div>
                            
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label for="customer-password" class="text-xs font-semibold text-zinc-300">Password</label>
                                    <button id="btn-show-lost-password" type="button" class="text-xs text-sky-400 hover:text-sky-300 font-medium transition cursor-pointer hover:underline" style="background: transparent !important; border: 0 !important; padding: 0 !important; margin: 0 !important; box-shadow: none !important; width: auto !important; min-height: 0 !important; color: #38bdf8 !important; text-decoration: none; cursor: pointer; display: inline-block !important;">Password dimenticata?</button>
                                </div>
                                <div class="relative">
                                    <input id="customer-password" type="password" autocomplete="current-password" required placeholder="••••••••••••" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 pr-11 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                                    <button type="button" id="toggle-customer-password" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-zinc-400 hover:text-zinc-200 transition cursor-pointer bg-transparent border-0 outline-none flex items-center justify-center" title="Mostra password" aria-label="Mostra password"></button>
                                </div>
                            </div>
                            
                            <button id="customer-login-button" type="submit" class="w-full rounded-xl bg-sky-600 p-3.5 text-sm font-bold text-white transition hover:bg-sky-500 mt-2 cursor-pointer">Accedi</button>
                        </form>
                        <p id="customer-login-error" class="customer-error mt-4 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400" role="alert" aria-live="polite" hidden></p>
                    </div>

                    <!-- Vista Recupero Password (Lost Password) -->
                    <div id="login-box-lost" class="hidden">
                        <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">ASSISTENZA CREDENZIALI</p>
                        <h2 class="text-2xl font-extrabold text-white tracking-tight mb-2">Recupera la password</h2>
                        <p class="text-zinc-300 text-sm mb-6 leading-relaxed">Inserisci l’email con cui hai richiesto il preventivo. Se l'account esiste, riceverai un link sicuro valido 30 minuti per impostare una nuova password senza bloccare il tuo accesso attuale.</p>
                        <form id="customer-lost-form" class="space-y-4">
                            <div>
                                <label for="lost-email" class="block text-xs font-semibold text-zinc-300 mb-1.5">La tua Email registrata</label>
                                <input id="lost-email" type="email" autocomplete="email" required placeholder="mario.rossi@example.com" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                            </div>
                            <button id="lost-submit-button" type="submit" class="w-full rounded-xl bg-sky-600 p-3.5 text-sm font-bold text-white transition hover:bg-sky-500 mt-2 cursor-pointer">Invia link di ripristino</button>
                        </form>
                        <p id="lost-feedback" class="mt-4 rounded-lg p-3 text-xs font-medium" role="alert" aria-live="polite" hidden></p>
                        <div class="mt-6 pt-4 border-t border-zinc-800 text-center">
                            <button id="btn-back-to-login" type="button" class="text-xs text-zinc-400 hover:text-white transition cursor-pointer inline-flex items-center gap-1.5 font-semibold">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                                <span>Torna alla schermata di accesso</span>
                            </button>
                        </div>
                    </div>

                    <!-- Vista Conferma Reset Password tramite link monouso (?reset=...) -->
                    <div id="login-box-confirm-reset" class="hidden">
                        <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">RIPRISTINO SICURO</p>
                        <h2 class="text-2xl font-extrabold text-white tracking-tight mb-2">Imposta nuova password</h2>
                        <p class="text-zinc-300 text-sm mb-6 leading-relaxed">Scegli una nuova password sicura (almeno 8 caratteri, una maiuscola, una minuscola e un numero) per accedere subito alla tua Area Clienti.</p>
                        <form id="confirm-reset-form" class="space-y-4">
                            <div>
                                <label for="confirm-reset-password" class="block text-xs font-semibold text-zinc-300 mb-1.5">Nuova password</label>
                                <input id="confirm-reset-password" type="password" required minlength="8" autocomplete="new-password" placeholder="Almeno 8 caratteri con maiuscola e numero" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500" />
                            </div>
                            <div>
                                <label for="confirm-reset-repeat" class="block text-xs font-semibold text-zinc-300 mb-1.5">Conferma nuova password</label>
                                <input id="confirm-reset-repeat" type="password" required minlength="8" autocomplete="new-password" placeholder="Ripeti la nuova password" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500" />
                            </div>
                            <button id="confirm-reset-submit" type="submit" class="w-full rounded-xl bg-sky-600 p-3.5 text-sm font-bold text-white transition hover:bg-sky-500 mt-2 cursor-pointer">Salva nuova password e accedi</button>
                        </form>
                        <p id="confirm-reset-feedback" class="mt-4 rounded-lg p-3 text-xs font-medium" role="alert" aria-live="polite" hidden></p>
                        <div class="mt-6 pt-4 border-t border-zinc-800 text-center">
                            <button id="btn-back-from-reset" type="button" class="text-xs text-zinc-400 hover:text-white transition cursor-pointer inline-flex items-center gap-1.5 font-semibold">
                                <span>Torna alla schermata di accesso</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <section id="customer-dashboard" class="customer-dashboard w-full px-4 sm:px-8 lg:px-12 pb-14" hidden>
                <div class="customer-dashboard-heading flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-zinc-800 mb-8 gap-4">
                    <div>
                        <p class="customer-kicker text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">AREA PERSONALE</p>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Ciao, <span id="customer-name" class="text-sky-400"></span></h2>
                        <p id="customer-email-label" class="text-xs text-zinc-400 font-mono mt-0.5"></p>
                    </div>
                    <div class="flex items-center gap-2.5 self-start sm:self-auto">
                        <button id="customer-refresh-btn" type="button" class="rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white transition cursor-pointer inline-flex items-center gap-1.5" title="Aggiorna dati e stato richieste">
                            <svg class="w-3.5 h-3.5 text-sky-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            <span>Aggiorna</span>
                        </button>
                        <button id="customer-logout" type="button" class="rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2 text-xs font-semibold text-zinc-300 hover:border-zinc-700 hover:text-white transition cursor-pointer">Esci dall'area</button>
                    </div>
                </div>

                <!-- Riepilogo Statistiche Dashboard -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-lg">
                        <p class="text-xs font-semibold text-zinc-400 mb-1">Preventivi associati</p>
                        <p id="stat-preventivi-totali" class="text-2xl sm:text-3xl font-extrabold text-white">0</p>
                        <p class="text-[11px] text-zinc-500 mt-1">Richieste collegate al tuo account</p>
                    </div>
                    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-lg">
                        <p class="text-xs font-semibold text-zinc-400 mb-1">Ultimo stato</p>
                        <p id="stat-ultimo-stato" class="text-xl sm:text-2xl font-extrabold text-sky-400">-</p>
                        <p class="text-[11px] text-zinc-500 mt-1">Stato della richiesta più recente</p>
                    </div>
                    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-lg">
                        <p class="text-xs font-semibold text-zinc-400 mb-1">Allegati disponibili</p>
                        <p id="stat-allegati-totali" class="text-2xl sm:text-3xl font-extrabold text-white">0</p>
                        <p class="text-[11px] text-zinc-500 mt-1">Documenti e foto scaricabili</p>
                    </div>
                </div>

                <div class="mb-5">
                    <p class="text-xs font-bold uppercase tracking-wider text-sky-400">I TUOI INTERVENTI</p>
                    <h3 class="text-xl font-extrabold text-white">Panoramica preventivi e richieste</h3>
                </div>

                <div id="customer-requests" class="customer-requests grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-6 w-full"></div>
                <p id="customer-dashboard-error" class="customer-error mt-4 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400" role="alert" aria-live="polite" hidden></p>
            </section>
        </main>

        <!-- Modale Visualizzazione Foto Grande Area Clienti -->
        <dialog id="customer-photo-dialog" class="m-auto rounded-3xl border border-zinc-800 bg-zinc-900/98 backdrop-blur-xl p-5 sm:p-7 shadow-2xl backdrop:bg-black/85 max-w-4xl w-[94vw]">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-800">
                <div class="min-w-0 pr-4">
                    <p id="customer-photo-subtitle" class="text-[11px] font-bold uppercase tracking-wider text-sky-400 mb-0.5">FOTO ALLEGATA ALL'INTERVENTO</p>
                    <h2 id="customer-photo-title" class="font-bold text-white text-sm sm:text-base truncate">Foto allegata</h2>
                </div>
                <div class="flex items-center gap-2">
                    <button id="customer-download-photo-btn" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-sky-600 hover:bg-sky-500 px-3.5 py-2 rounded-xl transition cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        <span>Scarica foto</span>
                    </button>
                    <button id="customer-close-photo-btn" type="button" class="text-xs font-bold text-zinc-300 hover:text-white px-3 py-2 rounded-xl bg-zinc-800 border border-zinc-700 hover:border-zinc-600 transition cursor-pointer">Chiudi</button>
                </div>
            </div>
            <div id="customer-photo-loading" class="hidden py-16 text-center text-zinc-400 text-xs font-medium">Caricamento foto in corso...</div>
            <div class="flex items-center justify-center p-2 bg-black/60 rounded-2xl border border-zinc-800/80">
                <img id="customer-photo-viewer" class="max-h-[72vh] w-auto max-w-full rounded-xl object-contain shadow-2xl" alt="Foto allegata alla richiesta" />
            </div>
        </dialog>

        <!-- Modale Obbligatoria Primo Accesso: Cambio Password -->
        <dialog id="first-access-dialog" class="m-auto rounded-3xl border border-amber-500/40 bg-zinc-900/98 backdrop-blur-xl p-6 sm:p-8 shadow-2xl backdrop:bg-black/90 max-w-lg w-[92vw]">
            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-400 mx-auto flex items-center justify-center mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                </div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-amber-400 mb-1">PRIMO ACCESSO SICURO</p>
                <h2 class="text-xl sm:text-2xl font-extrabold text-white">Imposta la tua nuova password</h2>
                <p class="text-xs text-zinc-400 mt-2 leading-relaxed">Per la massima sicurezza dei tuoi dati, sostituisci la password temporanea ricevuta via email con una nuova password definitiva a tua scelta.</p>
            </div>

            <form id="first-access-form" class="space-y-4">
                <div>
                    <label for="first-access-password" class="block text-xs font-semibold text-zinc-300 mb-1.5">Nuova password</label>
                    <div class="relative">
                        <input id="first-access-password" type="password" required minlength="8" placeholder="Almeno 8 caratteri con maiuscola e numero" autocomplete="new-password" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 pr-11 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <button type="button" id="toggle-first-pwd" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-zinc-400 hover:text-zinc-200 transition cursor-pointer bg-transparent border-0 outline-none flex items-center justify-center" title="Mostra password" aria-label="Mostra password"></button>
                    </div>
                </div>
                <div>
                    <label for="first-access-confirm" class="block text-xs font-semibold text-zinc-300 mb-1.5">Conferma nuova password</label>
                    <div class="relative">
                        <input id="first-access-confirm" type="password" required minlength="8" placeholder="Ripeti la nuova password" autocomplete="new-password" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 pr-11 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20" />
                        <button type="button" id="toggle-first-confirm" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-zinc-400 hover:text-zinc-200 transition cursor-pointer bg-transparent border-0 outline-none flex items-center justify-center" title="Mostra password" aria-label="Mostra password"></button>
                    </div>
                </div>

                <!-- Requisiti Dinamici con transizione Rosso -> Verde -->
                <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-3.5 text-xs space-y-2">
                    <p class="font-semibold text-zinc-300 text-[11px] uppercase tracking-wider mb-2">Requisiti di sicurezza password:</p>
                    <div id="req-len" class="flex items-center gap-2 text-red-400 transition-colors duration-200">
                        <span class="req-icon flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-current/15 text-[11px] font-bold">✕</span>
                        <span>Almeno 8 caratteri</span>
                    </div>
                    <div id="req-upper" class="flex items-center gap-2 text-red-400 transition-colors duration-200">
                        <span class="req-icon flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-current/15 text-[11px] font-bold">✕</span>
                        <span>Almeno una lettera maiuscola (A-Z)</span>
                    </div>
                    <div id="req-lower" class="flex items-center gap-2 text-red-400 transition-colors duration-200">
                        <span class="req-icon flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-current/15 text-[11px] font-bold">✕</span>
                        <span>Almeno una lettera minuscola (a-z)</span>
                    </div>
                    <div id="req-num" class="flex items-center gap-2 text-red-400 transition-colors duration-200">
                        <span class="req-icon flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-current/15 text-[11px] font-bold">✕</span>
                        <span>Almeno un numero (0-9)</span>
                    </div>
                    <div id="req-match" class="flex items-center gap-2 text-red-400 transition-colors duration-200">
                        <span class="req-icon flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-current/15 text-[11px] font-bold">✕</span>
                        <span>Le due password inserite coincidono</span>
                    </div>
                </div>

                <p id="first-access-error" class="rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400" role="alert" hidden></p>
                <p id="first-access-success" class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-3 text-xs font-medium text-emerald-400" role="status" hidden></p>

                <button id="first-access-submit" type="submit" class="w-full rounded-xl bg-sky-600 p-3.5 text-sm font-bold text-white transition hover:bg-sky-500 mt-2 cursor-pointer">
                    Salva nuova password e continua
                </button>
            </form>
        </dialog>
    </div>

    <script is:inline>
        const sessionKey = 'poliurea-client-logged';
        const loginSection = document.getElementById('customer-login');
        const dashboard = document.getElementById('customer-dashboard');
        const loginForm = document.getElementById('customer-login-form');
        const loginButton = document.getElementById('customer-login-button');
        const loginError = document.getElementById('customer-login-error');
        const dashboardError = document.getElementById('customer-dashboard-error');
        const requestsContainer = document.getElementById('customer-requests');
        const photoDialog = document.getElementById('customer-photo-dialog');
        const photoViewer = document.getElementById('customer-photo-viewer');
        const photoSubtitle = document.getElementById('customer-photo-subtitle');
        const photoTitle = document.getElementById('customer-photo-title');
        const photoLoading = document.getElementById('customer-photo-loading');
        const downloadPhotoBtn = document.getElementById('customer-download-photo-btn');
        let activePhotoData = null;

        const firstAccessDialog = document.getElementById('first-access-dialog');
        const firstAccessForm = document.getElementById('first-access-form');
        const firstAccessPwd = document.getElementById('first-access-password');
        const firstAccessConfirm = document.getElementById('first-access-confirm');
        const firstAccessSubmit = document.getElementById('first-access-submit');
        const firstAccessError = document.getElementById('first-access-error');
        const firstAccessSuccess = document.getElementById('first-access-success');

        const scaricaAllegatoCliente = async (prevId, allegatoId, nomeOriginale) => {
            try {
                const risposta = await fetch(`/api/area-clienti/preventivi/${prevId}/allegati/${allegatoId}`);
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const blob = await risposta.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = nomeOriginale || `foto-richiesta-${prevId}.jpg`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            } catch (err) {
                console.error('Errore durante il download:', err);
                alert('Impossibile scaricare la foto.');
            }
        };

        const apriFotoGrandeCliente = async (prevId, allegatoId, nomeOriginale, servizio) => {
            activePhotoData = { prevId, allegatoId, nome: nomeOriginale };
            if (photoSubtitle) photoSubtitle.textContent = `RICHIESTA #${prevId} · ${servizio || 'INTERVENTO'}`;
            if (photoTitle) photoTitle.textContent = nomeOriginale || 'Foto allegata';
            if (photoViewer) photoViewer.classList.add('hidden');
            if (photoLoading) {
                photoLoading.textContent = 'Caricamento foto in corso...';
                photoLoading.classList.remove('hidden');
            }
            if (photoDialog) photoDialog.showModal();

            try {
                const risposta = await fetch(`/api/area-clienti/preventivi/${prevId}/allegati/${allegatoId}`);
                if (!risposta.ok) throw new Error(`HTTP ${risposta.status}`);
                const blob = await risposta.blob();
                if (photoViewer.src && photoViewer.src.startsWith('blob:')) {
                    URL.revokeObjectURL(photoViewer.src);
                }
                photoViewer.src = URL.createObjectURL(blob);
                photoViewer.onload = () => {
                    if (photoLoading) photoLoading.classList.add('hidden');
                    photoViewer.classList.remove('hidden');
                };
            } catch (err) {
                if (photoLoading) photoLoading.textContent = 'Errore nel caricamento della foto.';
            }
        };

        document.getElementById('customer-close-photo-btn')?.addEventListener('click', () => {
            photoDialog?.close();
            if (photoViewer?.src && photoViewer.src.startsWith('blob:')) {
                URL.revokeObjectURL(photoViewer.src);
                photoViewer.src = '';
            }
        });

        photoDialog?.addEventListener('click', (e) => {
            const rect = photoDialog.getBoundingClientRect();
            if (
                e.clientX < rect.left ||
                e.clientX > rect.right ||
                e.clientY < rect.top ||
                e.clientY > rect.bottom
            ) {
                photoDialog.close();
                if (photoViewer?.src && photoViewer.src.startsWith('blob:')) {
                    URL.revokeObjectURL(photoViewer.src);
                    photoViewer.src = '';
                }
            }
        });

        downloadPhotoBtn?.addEventListener('click', () => {
            if (activePhotoData) {
                scaricaAllegatoCliente(activePhotoData.prevId, activePhotoData.allegatoId, activePhotoData.nome);
