                const progressRight = document.createElement('span');
                progressRight.textContent = `${stato.progress}%`;
                progressLabelRow.append(progressLeft, progressRight);
                
                const progressBar = document.createElement('div');
                progressBar.className = 'h-2 w-full rounded-full bg-zinc-950 border border-zinc-800 overflow-hidden';
