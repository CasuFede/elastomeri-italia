---
import '../styles/infiltration-showcase.css';

const fasiTimeline = [
    { id: 0, num: '01', label: 'Punti critici' },
    { id: 1, num: '02', label: 'Danni' },
    { id: 2, num: '03', label: 'Diagnosi' },
    { id: 3, num: '04', label: 'Supporto' },
    { id: 4, num: '05', label: 'Soluzione' },
    { id: 5, num: '06', label: 'Risultato' },
];

const scenari = [
    { id: 0, num: '01', tab: 'Tetto e Balconi', nextLabel: 'Capannone' },
    { id: 1, num: '02', tab: 'Capannone Industriale', nextLabel: 'Pavimento Palestra' },
    { id: 2, num: '03', tab: 'Pavimento Palestra', nextLabel: 'Tetto e Balconi' },
];
---

<section id="interventi" class="home-band inf-showcase-section" data-band="interventi" aria-labelledby="inf-heading">
    <div class="wrap home-band-body">
        <div class="inf-header">
            <div class="inf-header-copy">
                <p class="eyebrow">DIAGNOSI · SOLUZIONE · RISULTATO</p>
                <h2 id="inf-heading" class="inf-header-title">
                    Danni da infiltrazione?<br />
                    <span>Guarda come li risolviamo alla radice.</span>
                </h2>
                <p class="inf-header-sub">
                    Esplora i 3 scenari reali — <strong>tetti e balconi</strong>, <strong>capannoni industriali</strong> e <strong>pavimentazioni per palestre</strong>: scorri gli esempi con le frecce e segui ogni fase dalla prima infiltrazione al risultato finale.
                </p>
            </div>
        </div>

        <!-- Selettore Scenari + Controllo Riproduzione -->
        <div class="inf-scenario-bar">
            <div class="inf-scenario-tabs" role="tablist" aria-label="Scegli l'esempio di intervento">
                {scenari.map((s, idx) => (
                    <button
                        type="button"
                        role="tab"
                        class={`inf-scenario-tab ${idx === 0 ? 'is-active' : ''}`}
                        data-scenario-tab={s.id}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                    >
                        <span class="inf-scenario-tab-num">{s.num}</span>
                        <span>{s.tab}</span>
                    </button>
                ))}
            </div>

            <div class="inf-controls-right">
                <button
                    type="button"
                    class="inf-ctrl-btn"
                    id="inf-play-btn"
                    aria-pressed="false"
                >
                    <span id="inf-play-icon" aria-hidden="true">❚❚</span>
                    <span id="inf-play-label">Pausa</span>
                </button>
                <button
                    type="button"
                    class="inf-ctrl-btn inf-ctrl-btn--next-example"
                    id="inf-next-example-pill"
                >
                    <span>Prossimo: <strong id="inf-next-example-name">Capannone</strong></span>
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>

        <!-- Card Principale con Carosello Orizzontale degli Scenari -->
        <div class="inf-card" id="inf-showcase" data-phase="0" data-scenario="0">
            <div class="inf-carousel-wrap">
                <!-- Frecce laterali di scorrimento orizzontale tra gli esempi -->
                <button
                    type="button"
                    class="inf-slide-arrow inf-slide-arrow--prev"
                    id="inf-scenario-prev"
                    aria-label="Esempio precedente"
                    title="Esempio precedente"
                >
                    <span aria-hidden="true">←</span>
                </button>
                <button
                    type="button"
                    class="inf-slide-arrow inf-slide-arrow--next"
                    id="inf-scenario-next"
                    aria-label="Prossimo esempio"
                    title="Scorri al prossimo esempio"
                >
                    <span aria-hidden="true">→</span>
                </button>

                <div class="inf-carousel-viewport" id="inf-carousel-viewport">
                    <div class="inf-carousel-track" id="inf-carousel-track">
                        <!-- ===============================================================
                             SCENARIO 01: CASA — TETTO, TERRAZZI E BALCONI (SENZA INTERRATO)
                             =============================================================== -->
                        <div class="inf-slide" data-scenario-slide="0" aria-hidden="false">
                            <div class="inf-stage">
                                <div class="inf-copy-stack" aria-live="polite">
                                    <div class="inf-panel is-active" data-panel="0">
                                        <span class="inf-panel-kicker">Esempio 01 · Tetto, Terrazzi e Balconi</span>
                                        <h3 class="inf-panel-title">Dove c'è una crepa,<br /><em>l'acqua passa.</em></h3>
                                        <p class="inf-panel-desc">
                                            Tetti a falde, comignoli, terrazzi calpestabili e balconi sono costantemente esposti a pioggia battente e sbalzi termici: basta un giunto scollato per avviare un'infiltrazione.
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill"><span class="inf-pill-num">1</span> Tetto e comignoli</span>
                                            <span class="inf-pill"><span class="inf-pill-num">2</span> Terrazzi e lastrici</span>
                                            <span class="inf-pill"><span class="inf-pill-num">3</span> Balconi e frontalini</span>
                                            <span class="inf-pill"><span class="inf-pill-num">4</span> Giunti e pluviali</span>
                                        </div>
                                    </div>

                                    <div class="inf-panel" data-panel="1" aria-hidden="true">
                                        <span class="inf-panel-kicker inf-panel-kicker--danger">02 · I danni da infiltrazione</span>
                                        <h3 class="inf-panel-title">L'acqua trova<br /><em class="is-danger">sempre la strada.</em></h3>
                                        <p class="inf-panel-desc">
                                            Pioggia e ristagni filtrano sotto piastrelle e guaine usurate, raggiungendo solai, soffitti e ferri d'armatura con danni crescenti a ogni inverno:
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill inf-pill--damage">Macchie e gocciolamenti a soffitto</span>
                                            <span class="inf-pill inf-pill--damage">Muffa, salnitro e intonaco sfogliato</span>
                                            <span class="inf-pill inf-pill--damage">Ristagni e guaine rigonfie o crepate</span>
                                            <span class="inf-pill inf-pill--damage">Ferri ossidati e distacchi frontalini</span>
                                        </div>
                                    </div>

                                    <div class="inf-panel" data-panel="2" aria-hidden="true">
                                        <span class="inf-panel-kicker inf-panel-kicker--amber">03 · Diagnosi strumentale</span>
                                        <h3 class="inf-panel-title">Prima capire<br /><em>l'origine esatta.</em></h3>
                                        <p class="inf-panel-desc">
                                            Nel 70% dei casi la macchia sul soffitto è lontana dal vero punto d'ingresso. Con termocamera IR e igrometro individuiamo la via esatta dell'acqua.
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill inf-pill--tech">Termocamera IR</span>
                                            <span class="inf-pill inf-pill--tech">Igrometro a carburo</span>
                                            <span class="inf-pill inf-pill--tech">Verifica pendenze e scarichi</span>
                                        </div>
                                    </div>

                                    <div class="inf-panel" data-panel="3" aria-hidden="true">
                                        <span class="inf-panel-kicker">04 · Preparazione del supporto</span>
                                        <h3 class="inf-panel-title">Poi preparare<br /><em>senza demolire.</em></h3>
                                        <p class="inf-panel-desc">
                                            Nessun martello pneumatico: levigatura diamantata delle superfici esistenti, sigillatura elastica di giunti e scarichi e primer epossidico ad alta adesione.
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill inf-pill--tech">Levigatura diamantata</span>
                                            <span class="inf-pill inf-pill--tech">Sigillatura giunti e scarichi</span>
                                            <span class="inf-pill inf-pill--tech">Primer epossidico (&gt; 2,5 MPa)</span>
                                        </div>
                                    </div>

                                    <div class="inf-panel" data-panel="4" aria-hidden="true">
                                        <span class="inf-panel-kicker">05 · La nostra soluzione</span>
                                        <h3 class="inf-panel-title">Una sola corazza<br /><em>senza giunzioni.</em></h3>
                                        <p class="inf-panel-desc">
                                            Applichiamo il ciclo ideale — poliurea pura a caldo (70°C, 200 bar), ciclo manuale di precisione su balconi o bituminoso armato Remat — avvolgendo ogni raccordo.
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill inf-pill--tech">Poliurea a caldo · 70°C / 200 bar</span>
                                            <span class="inf-pill inf-pill--tech">Elasticità &gt; 400%</span>
                                            <span class="inf-pill inf-pill--tech">0 giunti · 0 saldature a fiamma</span>
                                        </div>
                                    </div>

                                    <div class="inf-panel" data-panel="5" aria-hidden="true">
                                        <span class="inf-panel-kicker inf-panel-kicker--success">06 · Il risultato finale</span>
                                        <h3 class="inf-panel-title">Asciutto per sempre.<br /><em class="is-success">Pedonabile in 60 minuti.</em></h3>
                                        <p class="inf-panel-desc">
                                            Pioggia intensa e ristagni scivolano via sullo scudo continuo di tetto, terrazzo e balconi. Zero demolizioni, zero macerie e casa protetta a lungo termine.
                                        </p>
                                        <div class="inf-pills">
                                            <span class="inf-pill inf-pill--success">0% Infiltrazioni</span>
                                            <span class="inf-pill inf-pill--success">Calpestabile in 60 min</span>
                                            <span class="inf-pill inf-pill--success">Zero demolizioni</span>
                                        </div>
                                        <div class="inf-panel-actions">
                                            <a class="ps-pill-btn ps-pill-btn--solid" href="/fondazioni">
                                                Scopri tutti i servizi <span aria-hidden="true">→</span>
                                            </a>
                                            <a class="ps-text-link" href="/preventivo">
                                                Richiedi sopralluogo gratuito <span aria-hidden="true">↗</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- SVG 01: Casa Fuori Terra (Tetto, Terrazzo, Balcone — NESSUN interrato) -->
                                <div class="inf-visual">
                                    <svg
                                        class="inf-svg"
                                        viewBox="0 0 800 500"
                                        role="img"
                                        aria-label="Animazione casa: infiltrazioni su tetto, terrazzi e balconi, diagnosi termografica, preparazione del supporto, applicazione della membrana continua e risultato finale asciutto"
                                    >
                                        <defs>
                                            <pattern id="inf1-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                                                <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#E2E8F0" stroke-width="0.65" opacity="0.55" />
                                            </pattern>
                                            <radialGradient id="inf1-damp" cx="50%" cy="50%" r="50%">
                                                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.44" />
                                                <stop offset="55%" stop-color="#64748B" stop-opacity="0.28" />
                                                <stop offset="100%" stop-color="#94A3B8" stop-opacity="0" />
                                            </radialGradient>
                                            <radialGradient id="inf1-mold" cx="50%" cy="50%" r="50%">
                                                <stop offset="0%" stop-color="#475569" stop-opacity="0.54" />
                                                <stop offset="60%" stop-color="#64748B" stop-opacity="0.22" />
                                                <stop offset="100%" stop-color="#64748B" stop-opacity="0" />
                                            </radialGradient>
                                            <radialGradient id="inf1-ir-hot" cx="50%" cy="50%" r="50%">
                                                <stop offset="0%" stop-color="#EF4444" stop-opacity="0.88" />
                                                <stop offset="45%" stop-color="#F97316" stop-opacity="0.58" />
                                                <stop offset="78%" stop-color="#FACC15" stop-opacity="0.26" />
                                                <stop offset="100%" stop-color="#FACC15" stop-opacity="0" />
                                            </radialGradient>
                                            <linearGradient id="inf1-scan" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.06" />
                                                <stop offset="50%" stop-color="#F59E0B" stop-opacity="0.16" />
                                                <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.06" />
                                            </linearGradient>
                                            <linearGradient id="inf1-hygro" x1="0" y1="0" x2="1" y2="0">
                                                <stop offset="0%" stop-color="#22C55E" />
                                                <stop offset="50%" stop-color="#FACC15" />
                                                <stop offset="100%" stop-color="#EF4444" />
                                            </linearGradient>
                                            <linearGradient id="inf1-spray" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" stop-color="#0071E3" stop-opacity="0.78" />
                                                <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.05" />
                                            </linearGradient>
                                            <clipPath id="inf1-loupe">
                                                <circle cx="144" cy="116" r="56" />
                                            </clipPath>
                                            <filter id="inf1-shadow" x="-15%" y="-15%" width="130%" height="135%">
                                                <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#0F172A" flood-opacity="0.12" />
                                            </filter>
                                        </defs>

                                        <rect x="0" y="0" width="800" height="500" fill="url(#inf1-grid)" />

                                        <!-- Edificio fuori terra (zero interrato!) -->
                                        <g>
                                            <!-- Fascia pavimentazione esterna / giardino pulita -->
                                            <rect x="76" y="434" width="668" height="22" rx="6" fill="#E8ECEF" />
                                            <line x1="76" y1="434" x2="744" y2="434" stroke="#334155" stroke-width="2.2" stroke-linecap="round" />

                                            <!-- Sottotetto -->
                                            <polygon points="296,190 435,108 574,190" fill="#F1F5F9" />
                                            <!-- Piani abitabili (2 piani fuori terra) -->
                                            <rect x="294" y="190" width="282" height="244" fill="#FFFFFF" />
                                            <!-- Zona giorno sotto il terrazzo sinistro -->
                                            <rect x="148" y="294" width="146" height="140" fill="#FFFFFF" />

                                            <!-- Finestre e arredi leggeri -->
                                            <circle cx="435" cy="158" r="14" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                                            <line x1="421" y1="158" x2="449" y2="158" stroke="#93C5FD" stroke-width="1" />
                                            <line x1="435" y1="144" x2="435" y2="172" stroke="#93C5FD" stroke-width="1" />

                                            <!-- Primo piano -->
                                            <rect x="330" y="214" width="52" height="48" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                                            <line x1="356" y1="214" x2="356" y2="262" stroke="#93C5FD" stroke-width="1.2" />
                                            <rect x="488" y="214" width="52" height="48" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                                            <line x1="514" y1="214" x2="514" y2="262" stroke="#93C5FD" stroke-width="1.2" />

                                            <!-- Piano terra -->
                                            <rect x="180" y="334" width="84" height="58" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                                            <line x1="222" y1="334" x2="222" y2="392" stroke="#93C5FD" stroke-width="1.2" />
                                            <rect x="330" y="334" width="52" height="52" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                                            <line x1="356" y1="334" x2="356" y2="386" stroke="#93C5FD" stroke-width="1.2" />
                                            <rect x="494" y="350" width="44" height="84" rx="3" fill="#CBD5E1" />
                                            <circle cx="529" cy="394" r="2.6" fill="#64748B" />

                                            <!-- Muri perimetrali e solai -->
                                            <rect x="288" y="190" width="12" height="244" fill="#7C8594" />
                                            <rect x="570" y="190" width="12" height="244" fill="#7C8594" />
                                            <rect x="142" y="256" width="12" height="178" fill="#7C8594" />
                                            <rect x="139" y="252" width="18" height="5" rx="1.5" fill="#475569" />

                                            <!-- Solaio lastrico / terrazzo calpestabile -->
                                            <rect x="142" y="290" width="158" height="13" fill="#8B94A3" />
                                            <!-- Solaio intermedio -->
                                            <rect x="288" y="290" width="294" height="11" fill="#8B94A3" />
                                            <!-- Zoccolatura base a livello terra -->
                                            <rect x="136" y="426" width="452" height="8" rx="2" fill="#64748B" />

                                            <!-- Balcone aggettante a destra -->
                                            <rect x="582" y="290" width="114" height="14" rx="1.5" fill="#8B94A3" />
                                            <g stroke="#64748B" stroke-width="2.2" fill="none">
                                                <line x1="582" y1="252" x2="694" y2="252" />
                                                <line x1="582" y1="270" x2="694" y2="270" stroke-width="1.3" opacity="0.7" />
                                                <line x1="616" y1="252" x2="616" y2="290" stroke-width="1.6" />
                                                <line x1="655" y1="252" x2="655" y2="290" stroke-width="1.6" />
                                                <line x1="693" y1="252" x2="693" y2="290" stroke-width="2.2" />
                                            </g>

                                            <!-- Comignolo -->
                                            <rect x="492" y="100" width="20" height="46" fill="#525B6B" />
                                            <rect x="488" y="97" width="28" height="5" rx="1.5" fill="#334155" />

                                            <!-- Falde del tetto -->
                                            <polygon points="264,195 435,96 606,195 600,204 435,109 270,204" fill="#525B6B" />
                                        </g>

                                        <!-- FASE 0 & 1: 4 Punti critici -->
                                        <g class="inf-layer layer-hotspots">
                                            <!-- 1. Tetto e comignoli -->
                                            <g transform="translate(376, 130)">
                                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring" />
                                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                                <path d="M -5 -4 L 0 0 L -3 5 M 0 0 L 5 4" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                                            </g>
                                            <!-- 2. Terrazzi e lastrici -->
                                            <g transform="translate(216, 290)">
                                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--2" />
                                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                                <path d="M -5 -2 L 0 2 L 4 -3 M 0 2 L 1 7" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                                            </g>
                                            <!-- 3. Balconi e frontalini -->
                                            <g transform="translate(646, 296)">
                                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--3" />
                                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                                <path d="M -4 -5 L 1 0 L -2 6 M 1 0 L 5 3" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                                            </g>
                                            <!-- 4. Giunti e pluviali -->
                                            <g transform="translate(576, 344)">
                                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--4" />
                                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                                <path d="M -3 -5 L 2 0 L -3 5" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                                            </g>
                                        </g>

                                        <!-- Callout Fase 0 -->
                                        <g class="inf-layer layer-callouts" font-family="Inter Variable, Inter, sans-serif">
                                            <line x1="286" y1="74" x2="368" y2="125" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                                            <g filter="url(#inf1-shadow)">
                                                <rect x="112" y="59" width="176" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                                <circle cx="128" cy="74" r="9" fill="#DC2626" />
                                                <text x="128" y="78" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">1</text>
                                                <text x="144" y="78" fill="#1D1D1F" font-size="12" font-weight="700">Tetto e comignoli</text>
                                            </g>

                                            <line x1="178" y1="210" x2="212" y2="281" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                                            <g filter="url(#inf1-shadow)">
                                                <rect x="18" y="188" width="178" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                                <circle cx="34" cy="203" r="9" fill="#DC2626" />
                                                <text x="34" y="207" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">2</text>
                                                <text x="50" y="207" fill="#1D1D1F" font-size="12" font-weight="700">Terrazzi e lastrici</text>
                                            </g>

                                            <line x1="672" y1="192" x2="649" y2="285" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                                            <g filter="url(#inf1-shadow)">
                                                <rect x="596" y="162" width="184" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                                <circle cx="612" cy="177" r="9" fill="#DC2626" />
                                                <text x="612" y="181" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">3</text>
                                                <text x="628" y="181" fill="#1D1D1F" font-size="12" font-weight="700">Balconi e frontalini</text>
                                            </g>

                                            <line x1="612" y1="354" x2="585" y2="346" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                                            <g filter="url(#inf1-shadow)">
                                                <rect x="612" y="339" width="166" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                                <circle cx="628" cy="354" r="9" fill="#DC2626" />
                                                <text x="628" y="358" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">4</text>
                                                <text x="644" y="358" fill="#1D1D1F" font-size="12" font-weight="700">Giunti e pluviali</text>
                                            </g>
                                        </g>

                                        <!-- FASE 1: Pioggia e danni interni -->
                                        <g class="inf-layer layer-rain-problem" stroke="#3B82F6" stroke-width="1.7" stroke-linecap="round">
                                            <line x1="154" y1="86" x2="150" y2="102" class="inf-rain-drop" />
                                            <line x1="210" y1="138" x2="206" y2="154" class="inf-rain-drop inf-rain-drop--b" />
                                            <line x1="264" y1="62" x2="260" y2="78" class="inf-rain-drop inf-rain-drop--c" />
                                            <line x1="336" y1="42" x2="332" y2="58" class="inf-rain-drop inf-rain-drop--b" />
                                            <line x1="406" y1="30" x2="402" y2="46" class="inf-rain-drop" />
                                            <line x1="478" y1="34" x2="474" y2="50" class="inf-rain-drop inf-rain-drop--c" />
                                            <line x1="548" y1="54" x2="544" y2="70" class="inf-rain-drop" />
                                            <line x1="624" y1="96" x2="620" y2="112" class="inf-rain-drop inf-rain-drop--b" />
                                            <line x1="674" y1="142" x2="670" y2="158" class="inf-rain-drop inf-rain-drop--c" />
