---
import '../styles/infiltration-showcase.css';

const fasiTimeline = [
    { id: 0, num: '01', label: 'Punti critici' },
    { id: 1, num: '02', label: 'Danni' },
    { id: 2, num: '03', label: 'Diagnosi' },
    { id: 3, num: '04', label: 'Supporto' },
    { id: 4, num: '05', label: 'Soluzione' },
    { id: 5, num: '06', label: 'Risultato' },
];
---

<section id="interventi" class="home-band inf-showcase-section" data-band="interventi" aria-labelledby="inf-heading">
    <div class="wrap home-band-body">
        <div class="inf-header">
            <div class="inf-header-copy">
                <p class="eyebrow">DIAGNOSI · SOLUZIONE · RISULTATO</p>
                <h2 id="inf-heading" class="inf-header-title">
                    Danni da infiltrazione?<br />
                    <span>Guarda come li risolviamo alla radice.</span>
                </h2>
                <p class="inf-header-sub">
                    Dalla prima goccia al collaudo finale: scopri tutti i punti vulnerabili dell'edificio, i danni che l'acqua provoca nel tempo e come il nostro sistema continuo li elimina definitivamente.
                </p>
            </div>

            <div class="inf-controls-top" aria-label="Controlli animazione interattiva">
                <button
                    type="button"
                    class="inf-ctrl-btn inf-ctrl-btn--icon"
                    id="inf-prev-btn"
                    aria-label="Fase precedente"
                    title="Fase precedente"
                >
                    <span aria-hidden="true">←</span>
                </button>
                <button
                    type="button"
                    class="inf-ctrl-btn"
                    id="inf-play-btn"
                    aria-pressed="false"
                >
                    <span id="inf-play-icon" aria-hidden="true">❚❚</span>
                    <span id="inf-play-label">Pausa</span>
                </button>
                <button
                    type="button"
                    class="inf-ctrl-btn inf-ctrl-btn--icon"
                    id="inf-next-btn"
                    aria-label="Fase successiva"
                    title="Fase successiva"
                >
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>

        <div class="inf-card" id="inf-showcase" data-phase="0">
            <div class="inf-stage">
                <!-- Colonna sinistra: storytelling delle 6 fasi -->
                <div class="inf-copy-stack" aria-live="polite">
                    <!-- FASE 0: STRUTTURA / PUNTI CRITICI -->
                    <div class="inf-panel is-active" data-panel="0">
                        <span class="inf-panel-kicker">01 · Un edificio, 5 punti vulnerabili</span>
                        <h3 class="inf-panel-title">Dove c'è una crepa,<br /><em>l'acqua passa.</em></h3>
                        <p class="inf-panel-desc">
                            Ogni immobile ha zone esposte a sbalzi termici, pioggia battente e spinta del terreno: basta un giunto scollato o una guaina invecchiata per innescare un'infiltrazione.
                        </p>
                        <div class="inf-pills" aria-label="Zone vulnerabili dell'edificio">
                            <span class="inf-pill"><span class="inf-pill-num">1</span> Tetti e coperture</span>
                            <span class="inf-pill"><span class="inf-pill-num">2</span> Terrazzi e lastrici</span>
                            <span class="inf-pill"><span class="inf-pill-num">3</span> Balconi e frontalini</span>
                            <span class="inf-pill"><span class="inf-pill-num">4</span> Giunti e pareti</span>
                            <span class="inf-pill"><span class="inf-pill-num">5</span> Fondazioni, box e cantine</span>
                        </div>
                    </div>

                    <!-- FASE 1: TUTTI I POSSIBILI DANNI DA INFILTRAZIONE -->
                    <div class="inf-panel" data-panel="1" aria-hidden="true">
                        <span class="inf-panel-kicker inf-panel-kicker--danger">02 · I danni da infiltrazione</span>
                        <h3 class="inf-panel-title">L'acqua trova<br /><em class="is-danger">sempre la strada.</em></h3>
                        <p class="inf-panel-desc">
                            Pioggia, ristagni e spinta idrostatica penetrano nei massetti e nei ferri d'armatura. Senza un blocco continuo, i danni si estendono a tutto l'edificio:
                        </p>
                        <div class="inf-pills" aria-label="Principali danni da infiltrazione">
                            <span class="inf-pill inf-pill--damage">Macchie e gocciolamenti a soffitto</span>
                            <span class="inf-pill inf-pill--damage">Muffa, salnitro e intonaco sfogliato</span>
                            <span class="inf-pill inf-pill--damage">Ristagni e guaine rigonfie o crepate</span>
                            <span class="inf-pill inf-pill--damage">Ferri ossidati e distacchi frontalini</span>
                            <span class="inf-pill inf-pill--damage">Umidità di risalita e box allagati</span>
                        </div>
                    </div>

                    <!-- FASE 2: DIAGNOSI STRUMENTALE -->
                    <div class="inf-panel" data-panel="2" aria-hidden="true">
                        <span class="inf-panel-kicker inf-panel-kicker--amber">03 · Diagnosi strumentale</span>
                        <h3 class="inf-panel-title">Prima capire<br /><em>l'origine esatta.</em></h3>
                        <p class="inf-panel-desc">
                            Nel 70% dei casi la macchia visibile è lontana dal vero punto d'ingresso. Con termocamera e igrometro mappiamo l'umidità residua prima di progettare l'intervento.
                        </p>
                        <div class="inf-pills">
                            <span class="inf-pill inf-pill--tech">Termocamera IR</span>
                            <span class="inf-pill inf-pill--tech">Igrometro a carburo</span>
                            <span class="inf-pill inf-pill--tech">Verifica pendenze e scarichi</span>
                        </div>
                    </div>

                    <!-- FASE 3: PREPARAZIONE DEL SUPPORTO -->
                    <div class="inf-panel" data-panel="3" aria-hidden="true">
                        <span class="inf-panel-kicker">04 · Preparazione del supporto</span>
                        <h3 class="inf-panel-title">Poi preparare<br /><em>senza demolire.</em></h3>
                        <p class="inf-panel-desc">
                            Levigatura meccanica diamantata, sigillatura elastica di crepe e raccordi e stesura del primer epossidico strutturale per un'adesione superiore a 2,5 MPa.
                        </p>
                        <div class="inf-pills">
                            <span class="inf-pill inf-pill--tech">Levigatura diamantata</span>
                            <span class="inf-pill inf-pill--tech">Sigillatura giunti e pluviali</span>
                            <span class="inf-pill inf-pill--tech">Primer epossidico (&gt; 2,5 MPa)</span>
                        </div>
                    </div>

                    <!-- FASE 4: SOLUZIONE CONTINUA -->
                    <div class="inf-panel" data-panel="4" aria-hidden="true">
                        <span class="inf-panel-kicker">05 · La nostra soluzione</span>
                        <h3 class="inf-panel-title">Una sola corazza<br /><em>senza giunzioni.</em></h3>
                        <p class="inf-panel-desc">
                            Applichiamo il ciclo ideale per ogni supporto — poliurea pura a caldo (70°C, 200 bar), ciclo manuale di precisione o bituminoso armato Remat — avvolgendo ogni dettaglio.
                        </p>
                        <div class="inf-pills">
                            <span class="inf-pill inf-pill--tech">Poliurea a caldo · 70°C / 200 bar</span>
                            <span class="inf-pill inf-pill--tech">Elasticità &gt; 400%</span>
                            <span class="inf-pill inf-pill--tech">0 giunti · 0 saldature a fiamma</span>
                        </div>
                    </div>

                    <!-- FASE 5: RISULTATO DEFINITIVO -->
                    <div class="inf-panel" data-panel="5" aria-hidden="true">
                        <span class="inf-panel-kicker inf-panel-kicker--success">06 · Il risultato finale</span>
                        <h3 class="inf-panel-title">Asciutto per sempre.<br /><em class="is-success">Pedonabile in 60 minuti.</em></h3>
                        <p class="inf-panel-desc">
                            Pioggia intensa, ristagni e spinta di falda scivolano via sullo scudo continuo. Nessuna demolizione, zero macerie e superfici subito fruibili con tenuta certificata.
                        </p>
                        <div class="inf-pills">
                            <span class="inf-pill inf-pill--success">0% Infiltrazioni</span>
                            <span class="inf-pill inf-pill--success">Calpestabile in 60 min</span>
                            <span class="inf-pill inf-pill--success">Zero demolizioni</span>
                        </div>
                        <div class="inf-panel-actions">
                            <a class="ps-pill-btn ps-pill-btn--solid" href="/fondazioni">
                                Scopri tutti i servizi <span aria-hidden="true">→</span>
                            </a>
                            <a class="ps-text-link" href="/preventivo">
                                Richiedi sopralluogo gratuito <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Colonna destra: Sezione architettonica SVG animata -->
                <div class="inf-visual">
                    <svg
                        class="inf-svg"
                        viewBox="0 0 800 500"
                        role="img"
                        aria-label="Animazione tecnica dell'edificio: punti vulnerabili alle infiltrazioni, danni da acqua e umidità, diagnosi termografica, preparazione del supporto, applicazione della membrana impermeabile continua e risultato finale asciutto"
                    >
                        <defs>
                            <!-- Griglia architettonica leggera -->
                            <pattern id="inf-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                                <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#E2E8F0" stroke-width="0.65" opacity="0.55" />
                            </pattern>

                            <!-- Tratteggio diagonale terreno -->
                            <pattern id="inf-soil-hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
                                <rect width="14" height="14" fill="#ECEAE2" />
                                <line x1="0" y1="0" x2="0" y2="14" stroke="#DCD8CC" stroke-width="2" />
                            </pattern>

                            <!-- Gradiente umidità / macchia infiltrazione -->
                            <radialGradient id="inf-damp-grad" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.42" />
                                <stop offset="55%" stop-color="#64748B" stop-opacity="0.28" />
                                <stop offset="100%" stop-color="#94A3B8" stop-opacity="0" />
                            </radialGradient>

                            <!-- Gradiente muffa / salnitro -->
                            <radialGradient id="inf-mold-grad" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#475569" stop-opacity="0.52" />
                                <stop offset="60%" stop-color="#64748B" stop-opacity="0.22" />
                                <stop offset="100%" stop-color="#64748B" stop-opacity="0" />
                            </radialGradient>

                            <!-- Gradiente hotspot termografico IR -->
                            <radialGradient id="inf-ir-hot" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#EF4444" stop-opacity="0.88" />
                                <stop offset="45%" stop-color="#F97316" stop-opacity="0.58" />
                                <stop offset="78%" stop-color="#FACC15" stop-opacity="0.26" />
                                <stop offset="100%" stop-color="#FACC15" stop-opacity="0" />
                            </radialGradient>

                            <!-- Gradiente fascio scanner IR -->
                            <linearGradient id="inf-scan-fill" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.06" />
                                <stop offset="50%" stop-color="#F59E0B" stop-opacity="0.16" />
                                <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.06" />
                            </linearGradient>

                            <!-- Gradiente arco igrometro -->
                            <linearGradient id="inf-hygro-arc" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#22C55E" />
                                <stop offset="50%" stop-color="#FACC15" />
                                <stop offset="100%" stop-color="#EF4444" />
                            </linearGradient>

                            <!-- Gradiente cono spruzzo poliurea -->
                            <linearGradient id="inf-spray-grad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#0071E3" stop-opacity="0.78" />
                                <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.05" />
                            </linearGradient>

                            <!-- Clip circolare lente stratigrafia -->
                            <clipPath id="inf-loupe-clip">
                                <circle cx="144" cy="116" r="56" />
                            </clipPath>

                            <!-- Ombra morbida per card floating -->
                            <filter id="inf-card-shadow" x="-15%" y="-15%" width="130%" height="135%">
                                <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#0F172A" flood-opacity="0.12" />
                            </filter>
                        </defs>

                        <!-- Sfondo tecnico leggero -->
                        <rect x="0" y="0" width="800" height="500" fill="url(#inf-grid)" />

                        <!-- ===================================================
                             STRATO BASE: TERRENO + EDIFICIO IN SEZIONE
                             =================================================== -->
                        <g class="layer-building">
                            <!-- Terreno e falda -->
                            <rect x="76" y="336" width="668" height="134" rx="10" fill="url(#inf-soil-hatch)" />
                            <!-- Linea di campagna -->
                            <line x1="76" y1="336" x2="744" y2="336" stroke="#334155" stroke-width="2" stroke-linecap="round" />

                            <!-- Corpo interno dell'edificio (piani abitabili + mansarda + interrato) -->
                            <!-- Mansarda / sottotetto -->
                            <polygon points="300,165 435,88 570,165" fill="#F1F5F9" />
                            <!-- Piani fuori terra (corpo principale) -->
                            <rect x="298" y="165" width="274" height="171" fill="#FFFFFF" />
                            <!-- Corpo sinistro sotto terrazzo (lastrico solare) -->
                            <rect x="174" y="256" width="124" height="80" fill="#FFFFFF" />
                            <!-- Piano interrato / cantina / box -->
                            <rect x="298" y="336" width="274" height="98" fill="#F8FAFC" />

                            <!-- Dettagli interni puliti (finestre, porta, capriata, box) -->
                            <!-- Finestra circolare sottotetto -->
                            <circle cx="435" cy="136" r="14" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                            <line x1="421" y1="136" x2="449" y2="136" stroke="#93C5FD" stroke-width="1" />
                            <line x1="435" y1="122" x2="435" y2="150" stroke="#93C5FD" stroke-width="1" />

                            <!-- Primo piano: due finestre -->
                            <rect x="332" y="186" width="48" height="42" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                            <line x1="356" y1="186" x2="356" y2="228" stroke="#93C5FD" stroke-width="1.2" />
                            <rect x="490" y="186" width="48" height="42" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                            <line x1="514" y1="186" x2="514" y2="228" stroke="#93C5FD" stroke-width="1.2" />

                            <!-- Piano terra: finestra sinistra (sotto terrazzo), finestra centrale, porta -->
                            <rect x="208" y="274" width="54" height="38" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                            <line x1="235" y1="274" x2="235" y2="312" stroke="#93C5FD" stroke-width="1.2" />
                            <rect x="332" y="272" width="48" height="40" rx="4" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5" />
                            <line x1="356" y1="272" x2="356" y2="312" stroke="#93C5FD" stroke-width="1.2" />
                            <rect x="498" y="272" width="38" height="62" rx="3" fill="#CBD5E1" />
                            <circle cx="529" cy="304" r="2.2" fill="#64748B" />

                            <!-- Piano interrato: silhouette garage/box e scaffalature -->
                            <rect x="478" y="366" width="66" height="64" rx="4" fill="#E2E8F0" opacity="0.65" />
                            <line x1="484" y1="380" x2="538" y2="380" stroke="#CBD5E1" stroke-width="2" />
                            <line x1="484" y1="396" x2="538" y2="396" stroke="#CBD5E1" stroke-width="2" />
                            <line x1="484" y1="412" x2="538" y2="412" stroke="#CBD5E1" stroke-width="2" />
                            <!-- Profilo stilizzato auto nel box -->
                            <path d="M 366 420 L 372 404 Q 380 396 402 396 L 424 396 Q 438 396 446 406 L 456 409 Q 462 411 462 420 Z" fill="#E2E8F0" opacity="0.85" />
                            <circle cx="386" cy="422" r="8" fill="#CBD5E1" />
                            <circle cx="442" cy="422" r="8" fill="#CBD5E1" />

                            <!-- Struttura portante (muri perimetrali, solai, fondazioni, terrazzo, balcone) -->
                            <!-- Muro esterno sinistro (corpo principale) -->
                            <rect x="290" y="165" width="12" height="270" fill="#7C8594" />
                            <!-- Muro esterno destro -->
                            <rect x="568" y="165" width="12" height="270" fill="#7C8594" />
                            <!-- Muro esterno corpo terrazzo -->
                            <rect x="166" y="218" width="12" height="118" fill="#7C8594" />
                            <!-- Copertina parapetto terrazzo -->
                            <rect x="163" y="214" width="18" height="5" rx="1.5" fill="#475569" />

                            <!-- Solaio lastrico solare / terrazzo sinistro -->
                            <rect x="166" y="248" width="136" height="12" fill="#8B94A3" />
                            <!-- Solaio primo piano -->
                            <rect x="290" y="248" width="290" height="10" fill="#8B94A3" />
                            <!-- Solaio piano terra -->
                            <rect x="166" y="330" width="414" height="10" fill="#8B94A3" />
                            <!-- Platea di fondazione -->
                            <rect x="274" y="432" width="322" height="14" rx="2" fill="#64748B" />

                            <!-- Balcone aggettante a destra -->
                            <rect x="580" y="248" width="106" height="13" rx="1.5" fill="#8B94A3" />
                            <!-- Ringhiera moderna balcone -->
                            <g stroke="#64748B" stroke-width="2.2" fill="none">
                                <line x1="580" y1="212" x2="684" y2="212" />
                                <line x1="580" y1="229" x2="684" y2="229" stroke-width="1.3" opacity="0.7" />
                                <line x1="612" y1="212" x2="612" y2="248" stroke-width="1.6" />
                                <line x1="648" y1="212" x2="648" y2="248" stroke-width="1.6" />
                                <line x1="683" y1="212" x2="683" y2="248" stroke-width="2.2" />
                            </g>

                            <!-- Comignolo -->
                            <rect x="492" y="80" width="20" height="44" fill="#525B6B" />
                            <rect x="488" y="77" width="28" height="5" rx="1.5" fill="#334155" />

                            <!-- Falde del tetto -->
                            <polygon points="266,170 435,76 604,170 598,179 435,89 272,179" fill="#525B6B" />
                        </g>

                        <!-- ===================================================
                             FASE 0 & 1: HOTSPOT CRITERI + CREPE VISIBILI
                             =================================================== -->
                        <g class="inf-layer layer-hotspots">
                            <!-- 1. Crepa tetto -->
                            <g transform="translate(376, 110)">
                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring" />
                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                <path d="M -5 -4 L 0 0 L -3 5 M 0 0 L 5 4" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                            </g>
                            <!-- 2. Crepa lastrico / terrazzo -->
                            <g transform="translate(222, 248)">
                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--2" />
                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                <path d="M -5 -2 L 0 2 L 4 -3 M 0 2 L 1 7" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                            </g>
                            <!-- 3. Crepa balcone / frontalino -->
                            <g transform="translate(640, 254)">
                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--3" />
                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                <path d="M -4 -5 L 1 0 L -2 6 M 1 0 L 5 3" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                            </g>
                            <!-- 4. Giunto parete esposta -->
                            <g transform="translate(574, 296)">
                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--4" />
                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                <path d="M -3 -5 L 2 0 L -3 5" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                            </g>
                            <!-- 5. Fondazione controterra -->
                            <g transform="translate(294, 386)">
                                <circle r="13" fill="none" stroke="#DC2626" stroke-width="1.8" class="inf-pulse-ring inf-pulse-ring--5" />
                                <circle r="7" fill="#DC2626" fill-opacity="0.22" />
                                <path d="M -4 -6 L 2 0 L -4 6 M 2 0 L 6 0" stroke="#DC2626" stroke-width="2.4" fill="none" stroke-linecap="round" />
                            </g>
                        </g>

                        <!-- Callout etichettati (visibili in Fase 0) -->
                        <g class="inf-layer layer-callouts" font-family="Inter Variable, Inter, sans-serif">
                            <!-- 1 Tetti e coperture -->
                            <line x1="286" y1="68" x2="368" y2="106" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                            <g filter="url(#inf-card-shadow)">
                                <rect x="116" y="53" width="172" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                <circle cx="132" cy="68" r="9" fill="#DC2626" />
                                <text x="132" y="72" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">1</text>
                                <text x="148" y="72" fill="#1D1D1F" font-size="12" font-weight="700">Tetti e coperture</text>
                            </g>

                            <!-- 2 Terrazzi e lastrici -->
                            <line x1="184" y1="180" x2="218" y2="239" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                            <g filter="url(#inf-card-shadow)">
                                <rect x="18" y="158" width="178" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                <circle cx="34" cy="173" r="9" fill="#DC2626" />
                                <text x="34" y="177" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">2</text>
                                <text x="50" y="177" fill="#1D1D1F" font-size="12" font-weight="700">Terrazzi e lastrici</text>
                            </g>

                            <!-- 3 Balconi e frontalini -->
                            <line x1="668" y1="164" x2="643" y2="244" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                            <g filter="url(#inf-card-shadow)">
                                <rect x="598" y="134" width="184" height="30" rx="15" fill="#FFFFFF" stroke="#FCA5A5" stroke-width="1.3" />
                                <circle cx="614" cy="149" r="9" fill="#DC2626" />
                                <text x="614" y="153" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="800">3</text>
                                <text x="630" y="153" fill="#1D1D1F" font-size="12" font-weight="700">Balconi e frontalini</text>
                            </g>

                            <!-- 4 Giunti e pareti -->
                            <line x1="612" y1="306" x2="583" y2="298" stroke="#DC2626" stroke-width="1.4" stroke-dasharray="3 2" />
                            <g filter="url(#inf-card-shadow)">
