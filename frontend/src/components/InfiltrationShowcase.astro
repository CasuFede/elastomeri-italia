<script>
    const card = document.getElementById('inf-showcase');
    if (card) {
        const panels = Array.from(card.querySelectorAll<HTMLElement>('[data-panel]'));
        const stepButtons = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-step-btn]'));
        const prevBtn = document.getElementById('inf-prev-btn');
        const nextBtn = document.getElementById('inf-next-btn');
        const playBtn = document.getElementById('inf-play-btn');
        const playIcon = document.getElementById('inf-play-icon');
        const playLabel = document.getElementById('inf-play-label');

        // Durata in ms per ogni fase (più respiro su Danni e Risultato)
        const PHASE_DURATIONS = [4400, 5400, 4400, 4400, 4800, 5800];
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let currentPhase = prefersReducedMotion ? 1 : 0;
        let isPlaying = !prefersReducedMotion;
        let isInView = false;
        let phaseElapsed = 0;
        let lastFrameTime = 0;
        let rafId = 0;

        const syncPlayButton = () => {
            if (!playBtn || !playIcon || !playLabel) return;
            playBtn.setAttribute('aria-pressed', String(!isPlaying));
            playIcon.textContent = isPlaying ? '❚❚' : '▶';
            playLabel.textContent = isPlaying ? 'Pausa' : 'Riproduci';
        };

        const renderProgress = () => {
            const duration = PHASE_DURATIONS[currentPhase] || 4600;
            const ratio = isPlaying ? Math.min(1, phaseElapsed / duration) : 1;
            stepButtons.forEach((btn, idx) => {
                btn.classList.toggle('is-active', idx === currentPhase);
                btn.classList.toggle('is-done', idx < currentPhase);
                btn.setAttribute('aria-selected', String(idx === currentPhase));
                if (idx === currentPhase) {
                    btn.style.setProperty('--step-progress', ratio.toFixed(4));
                } else {
                    btn.style.removeProperty('--step-progress');
                }
            });
        };

        const setPhase = (index: number, resetElapsed = true) => {
            const total = panels.length;
            currentPhase = ((index % total) + total) % total;
            if (resetElapsed) phaseElapsed = 0;
            card.setAttribute('data-phase', String(currentPhase));
            panels.forEach((panel, idx) => {
                const active = idx === currentPhase;
                panel.classList.toggle('is-active', active);
                panel.setAttribute('aria-hidden', String(!active));
            });
            renderProgress();
        };

        const tick = (now: number) => {
            if (!isPlaying || !isInView) {
                lastFrameTime = 0;
                rafId = 0;
                return;
            }
            if (lastFrameTime > 0) {
                phaseElapsed += Math.min(100, now - lastFrameTime);
            }
            lastFrameTime = now;

            const duration = PHASE_DURATIONS[currentPhase] || 4600;
            if (phaseElapsed >= duration) {
                setPhase(currentPhase + 1, true);
            } else {
                renderProgress();
            }
            rafId = window.requestAnimationFrame(tick);
        };

        const ensureLoop = () => {
            if (isPlaying && isInView && !rafId) {
                lastFrameTime = 0;
                rafId = window.requestAnimationFrame(tick);
            }
        };

        stepButtons.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
                setPhase(idx, true);
                ensureLoop();
            });
            btn.addEventListener('keydown', (ev) => {
                if (ev.key === 'ArrowRight') {
                    ev.preventDefault();
                    const nextIdx = (idx + 1) % panels.length;
                    setPhase(nextIdx, true);
                    stepButtons[nextIdx]?.focus();
                } else if (ev.key === 'ArrowLeft') {
                    ev.preventDefault();
                    const prevIdx = (idx - 1 + panels.length) % panels.length;
                    setPhase(prevIdx, true);
                    stepButtons[prevIdx]?.focus();
                }
            });
        });

        prevBtn?.addEventListener('click', () => {
            setPhase(currentPhase - 1, true);
            ensureLoop();
        });

        nextBtn?.addEventListener('click', () => {
            setPhase(currentPhase + 1, true);
            ensureLoop();
        });

        playBtn?.addEventListener('click', () => {
            isPlaying = !isPlaying;
            if (isPlaying && phaseElapsed >= (PHASE_DURATIONS[currentPhase] || 4600)) {
                phaseElapsed = 0;
            }
            syncPlayButton();
            renderProgress();
            ensureLoop();
        });

        // Pausa automaticamente quando fuori viewport per zero spreco CPU
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        isInView = entry.isIntersecting;
                        if (isInView) {
                            ensureLoop();
                        } else if (rafId) {
                            window.cancelAnimationFrame(rafId);
                            rafId = 0;
                            lastFrameTime = 0;
                        }
                    });
                },
                { threshold: 0.2 }
            );
            observer.observe(card);
        } else {
            isInView = true;
            ensureLoop();
        }

        syncPlayButton();
        setPhase(currentPhase, true);
    }
</script>
