                                            <g fill="#0071E3">
                                                <circle cx="604" cy="332" r="3" class="inf-bounce-drop" />
                                                <circle cx="622" cy="332" r="3" class="inf-bounce-drop--right" />
                                            </g>
                                            <g filter="url(#inf3-shadow)" font-family="Inter Variable, Inter, sans-serif">
                                                <rect x="292" y="356" width="224" height="28" rx="14" fill="#F0FDF4" stroke="#86EFAC" stroke-width="1.2" />
                                                <text x="404" y="374" text-anchor="middle" fill="#166534" font-size="11" font-weight="800">✓ MASSETTO 100% ASCIUTTO</text>
                                            </g>
                                            <g filter="url(#inf3-shadow)" font-family="Inter Variable, Inter, sans-serif">
                                                <rect x="34" y="22" width="174" height="142" rx="20" fill="#FFFFFF" stroke="#BBF7D0" stroke-width="1.4" />
                                                <circle cx="121" cy="82" r="36" fill="none" stroke="#E5E7EB" stroke-width="6" />
                                                <circle cx="121" cy="82" r="36" fill="none" stroke="#16A34A" stroke-width="6" stroke-linecap="round" transform="rotate(-90 121 82)" class="inf-ring-progress" />
                                                <text x="121" y="82" text-anchor="middle" fill="#1D1D1F" font-size="22" font-weight="800">60</text>
                                                <text x="121" y="98" text-anchor="middle" fill="#52525B" font-size="10.5" font-weight="700">minuti</text>
                                                <text x="121" y="142" text-anchor="middle" fill="#166534" font-size="11" font-weight="800" letter-spacing="0.04em">SUBITO AGIBILE</text>
                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Barra timeline interattiva a 6 fasi (controlla lo scenario attivo) -->
            <div class="inf-timeline" role="tablist" aria-label="Fasi dell'animazione impermeabilizzazione">
                {fasiTimeline.map((fase, idx) => (
                    <button
                        type="button"
                        role="tab"
                        class={`inf-step-btn ${idx === 0 ? 'is-active' : ''}`}
                        data-step-btn={fase.id}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                    >
                        <span class="inf-step-bar" aria-hidden="true">
                            <span class="inf-step-fill"></span>
                        </span>
                        <span class="inf-step-meta">
                            <span class="inf-step-num">{fase.num}</span>
                            <span class="inf-step-label">{fase.label}</span>
                        </span>
                    </button>
                ))}
            </div>
        </div>

        <!-- Fascia link sempre visibile verso la pagina Servizi (/fondazioni) -->
        <div class="inf-cta-strip">
            <div class="inf-cta-strip-copy">
                <strong>Vuoi vedere nel dettaglio tutte le aree di intervento e gli schemi tecnici?</strong>
                <p>Terrazzi e lastrici solari, balconi, tetti, coperture industriali e pavimentazioni continue senza demolizioni.</p>
            </div>
            <div class="inf-cta-strip-actions">
                <a class="ps-pill-btn ps-pill-btn--solid" href="/fondazioni">
                    Vai alla pagina Servizi <span aria-hidden="true">→</span>
                </a>
                <a class="ps-text-link" href="/preventivo">
                    Richiedi sopralluogo gratuito <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    const card = document.getElementById('inf-showcase');
    if (card) {
        const track = document.getElementById('inf-carousel-track');
        const viewport = document.getElementById('inf-carousel-viewport');
        const slides = Array.from(card.querySelectorAll<HTMLElement>('[data-scenario-slide]'));
        const scenarioTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]'));
        const scenarioPrevBtn = document.getElementById('inf-scenario-prev');
        const scenarioNextBtn = document.getElementById('inf-scenario-next');
        const nextExamplePill = document.getElementById('inf-next-example-pill');
        const nextExampleName = document.getElementById('inf-next-example-name');

        const stepButtons = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-step-btn]'));
        const playBtn = document.getElementById('inf-play-btn');
        const playIcon = document.getElementById('inf-play-icon');
        const playLabel = document.getElementById('inf-play-label');

        const NEXT_LABELS = ['Capannone', 'Pavimento Palestra', 'Tetto e Balconi'];
        const PHASE_DURATIONS = [4400, 5400, 4400, 4400, 4800, 5800];
        const TOTAL_PHASES = PHASE_DURATIONS.length;
        const TOTAL_SCENARIOS = slides.length;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let currentScenario = 0;
        let currentPhase = prefersReducedMotion ? 1 : 0;
        let isPlaying = !prefersReducedMotion;
        let isInView = false;
        let phaseElapsed = 0;
        let lastFrameTime = 0;
        let rafId = 0;

        const syncPlayButton = () => {
            if (!playBtn || !playIcon || !playLabel) return;
            playBtn.setAttribute('aria-pressed', String(!isPlaying));
            playIcon.textContent = isPlaying ? '❚❚' : '▶';
            playLabel.textContent = isPlaying ? 'Pausa' : 'Riproduci';
        };

        const renderProgress = () => {
            const duration = PHASE_DURATIONS[currentPhase] || 4600;
            const ratio = isPlaying ? Math.min(1, phaseElapsed / duration) : 1;
            stepButtons.forEach((btn, idx) => {
                btn.classList.toggle('is-active', idx === currentPhase);
                btn.classList.toggle('is-done', idx < currentPhase);
                btn.setAttribute('aria-selected', String(idx === currentPhase));
                if (idx === currentPhase) {
                    btn.style.setProperty('--step-progress', ratio.toFixed(4));
                } else {
                    btn.style.removeProperty('--step-progress');
                }
            });
        };

        const setPhase = (index: number, resetElapsed = true) => {
            currentPhase = ((index % TOTAL_PHASES) + TOTAL_PHASES) % TOTAL_PHASES;
            if (resetElapsed) phaseElapsed = 0;
            card.setAttribute('data-phase', String(currentPhase));
            slides.forEach((slide) => {
                const panels = Array.from(slide.querySelectorAll<HTMLElement>('[data-panel]'));
                panels.forEach((panel, idx) => {
                    const active = idx === currentPhase;
                    panel.classList.toggle('is-active', active);
                    panel.setAttribute('aria-hidden', String(!active));
                });
            });
            renderProgress();
        };

        const setScenario = (index: number) => {
            currentScenario = ((index % TOTAL_SCENARIOS) + TOTAL_SCENARIOS) % TOTAL_SCENARIOS;
            card.setAttribute('data-scenario', String(currentScenario));
            if (track) {
                track.style.transform = `translateX(-${currentScenario * 100}%)`;
            }
            slides.forEach((slide, idx) => {
                slide.setAttribute('aria-hidden', String(idx !== currentScenario));
            });
            scenarioTabs.forEach((tab, idx) => {
                const active = idx === currentScenario;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', String(active));
            });
            if (nextExampleName) {
                nextExampleName.textContent = NEXT_LABELS[currentScenario] || 'Prossimo';
            }
            // Riporta lo scenario appena entrato alla fase iniziale (o fase 1 con reduced-motion)
            setPhase(prefersReducedMotion ? 1 : 0, true);
        };

        const tick = (now: number) => {
            if (!isPlaying || !isInView) {
                lastFrameTime = 0;
                rafId = 0;
                return;
            }
            if (lastFrameTime > 0) {
                phaseElapsed += Math.min(100, now - lastFrameTime);
            }
            lastFrameTime = now;

            const duration = PHASE_DURATIONS[currentPhase] || 4600;
            if (phaseElapsed >= duration) {
                setPhase(currentPhase + 1, true);
            } else {
                renderProgress();
            }
            rafId = window.requestAnimationFrame(tick);
        };

        const ensureLoop = () => {
            if (isPlaying && isInView && !rafId) {
                lastFrameTime = 0;
                rafId = window.requestAnimationFrame(tick);
            }
        };

        // Click sui tab dei 3 scenari
        scenarioTabs.forEach((tab, idx) => {
            tab.addEventListener('click', () => {
                setScenario(idx);
                ensureLoop();
            });
        });

        // Frecce laterali e pulsante "Prossimo esempio" (scorrimento orizzontale fluido)
        scenarioPrevBtn?.addEventListener('click', () => {
            setScenario(currentScenario - 1);
            ensureLoop();
        });

        scenarioNextBtn?.addEventListener('click', () => {
            setScenario(currentScenario + 1);
            ensureLoop();
        });

        nextExamplePill?.addEventListener('click', () => {
            setScenario(currentScenario + 1);
            ensureLoop();
        });

        // Swipe orizzontale touch su mobile
        let touchStartX = 0;
        let touchStartY = 0;
        viewport?.addEventListener(
            'touchstart',
            (ev) => {
                if (ev.touches.length !== 1) return;
                touchStartX = ev.touches[0].clientX;
                touchStartY = ev.touches[0].clientY;
            },
            { passive: true }
        );
        viewport?.addEventListener(
            'touchend',
            (ev) => {
                if (!touchStartX || ev.changedTouches.length !== 1) return;
                const dx = ev.changedTouches[0].clientX - touchStartX;
                const dy = ev.changedTouches[0].clientY - touchStartY;
                touchStartX = 0;
                touchStartY = 0;
                if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.3) {
                    setScenario(dx < 0 ? currentScenario + 1 : currentScenario - 1);
                    ensureLoop();
                }
            },
            { passive: true }
        );

        // Timeline inferiore (6 fasi)
        stepButtons.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
                setPhase(idx, true);
                ensureLoop();
            });
            btn.addEventListener('keydown', (ev) => {
                if (ev.key === 'ArrowRight') {
                    ev.preventDefault();
                    const nextIdx = (idx + 1) % TOTAL_PHASES;
                    setPhase(nextIdx, true);
                    stepButtons[nextIdx]?.focus();
                } else if (ev.key === 'ArrowLeft') {
                    ev.preventDefault();
                    const prevIdx = (idx - 1 + TOTAL_PHASES) % TOTAL_PHASES;
                    setPhase(prevIdx, true);
                    stepButtons[prevIdx]?.focus();
                }
            });
        });

        playBtn?.addEventListener('click', () => {
            isPlaying = !isPlaying;
            if (isPlaying && phaseElapsed >= (PHASE_DURATIONS[currentPhase] || 4600)) {
                phaseElapsed = 0;
            }
            syncPlayButton();
            renderProgress();
            ensureLoop();
        });

        // Pausa automatica fuori viewport
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        isInView = entry.isIntersecting;
                        if (isInView) {
                            ensureLoop();
                        } else if (rafId) {
                            window.cancelAnimationFrame(rafId);
                            rafId = 0;
                            lastFrameTime = 0;
                        }
                    });
                },
                { threshold: 0.2 }
            );
            observer.observe(card);
        } else {
            isInView = true;
            ensureLoop();
        }

        syncPlayButton();
        setScenario(0);
    }
</script>
