---
interface Props {
    eyebrow: string;
    title: string;
    highlight?: string;
    text: string;
}

const { eyebrow, title, highlight, text } = Astro.props;
---

<section class="page-intro wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}{highlight && <> <span>{highlight}</span></>}</h1>
    <p class="intro-copy">{text}</p>
</section>
