---
interface Props {
    eyebrow?: string;
    title: string;
    text: string;
    buttonText?: string;
    buttonHref?: string;
}

const { 
    eyebrow = 'IL PROSSIMO PASSO', 
    title, 
    text,
    buttonText = 'Richiedi un sopralluogo gratuito',
    buttonHref = '/preventivo'
} = Astro.props;
---

<section class="cta-band my-0">
    <div class="wrap">
        <div class="cta-inner flex flex-col md:flex-row items-center text-center md:text-left justify-between gap-8 rounded-[28px] border border-[#D2D2D7] bg-white p-8 sm:p-12 transition-colors duration-200 hover:border-[#0071E3]">
            <div class="flex flex-col items-center md:items-start max-w-2xl">
                <span class="inline-block rounded-full border border-[#B5CCE4] bg-[#E8F2FC] px-3.5 py-1 text-xs font-bold tracking-wider text-[#0071E3] mb-3">
                    {eyebrow}
                </span>
                <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[#1D1D1F] leading-tight">
                    {title}
                </h2>
                <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#6E6E73]">
                    {text}
                </p>
            </div>
            <a 
                class="shrink-0 inline-flex items-center justify-center gap-2.5 rounded-full bg-[#0071E3] hover:bg-[#0064CC] text-white font-semibold text-sm sm:text-base px-7 py-4 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071E3] focus-visible:ring-offset-2"
                href={buttonHref}
            >
                {buttonText}
                <span aria-hidden="true" class="text-base font-bold">↗</span>
            </a>
        </div>
    </div>
</section>
