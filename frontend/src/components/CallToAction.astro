---
interface Props {
    eyebrow?: string;
    title: string;
    text: string;
    buttonText?: string;
    buttonHref?: string;
}

const { 
    eyebrow = 'IL PROSSIMO PASSO', 
    title, 
    text,
    buttonText = 'Richiedi un sopralluogo gratuito',
    buttonHref = '/preventivo'
} = Astro.props;
---

<section class="cta-band my-14 sm:my-20">
    <div class="wrap">
        <div class="cta-inner flex flex-col md:flex-row items-center text-center md:text-left justify-between gap-8 rounded-2xl border border-zinc-800 bg-gradient-to-b md:bg-gradient-to-r from-zinc-900 via-zinc-900 to-zinc-950 p-8 sm:p-12 shadow-2xl shadow-black/80 transition-colors duration-300 hover:border-zinc-700">
            <div class="flex flex-col items-center md:items-start max-w-2xl">
                <span class="inline-block rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold tracking-wider text-sky-400 mb-3">
                    {eyebrow}
                </span>
                <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
                    {title}
                </h2>
                <p class="mt-3 text-sm sm:text-base leading-relaxed text-zinc-300">
                    {text}
                </p>
            </div>
            <a 
                class="shrink-0 inline-flex items-center justify-center gap-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-sm sm:text-base px-7 py-4 shadow-xl shadow-sky-500/25 transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                href={buttonHref}
            >
                {buttonText}
                <span aria-hidden="true" class="text-base font-bold">↗</span>
            </a>
        </div>
    </div>
</section>
