---
interface Props {
    eyebrow?: string;
    title: string;
    text: string;
    buttonText?: string;
    buttonHref?: string;
}

const { 
    eyebrow = 'IL PROSSIMO PASSO', 
    title, 
    text,
    buttonText = 'Richiedi un sopralluogo gratuito',
    buttonHref = '/preventivo'
} = Astro.props;
---

<section class="cta-band my-0">
    <div class="wrap">
        <div class="cta-inner flex flex-col md:flex-row items-center text-center md:text-left justify-between gap-8 rounded-2xl border-2 border-slate-600 bg-slate-800 p-8 sm:p-12 transition-colors duration-200 hover:border-sky-400">
            <div class="flex flex-col items-center md:items-start max-w-2xl">
                <span class="inline-block rounded-md border border-sky-400 bg-sky-950 px-3.5 py-1 text-xs font-bold tracking-wider text-sky-300 mb-3">
                    {eyebrow}
                </span>
                <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
                    {title}
                </h2>
                <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-200">
                    {text}
                </p>
            </div>
            <a 
                class="shrink-0 inline-flex items-center justify-center gap-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-sm sm:text-base px-7 py-4 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                href={buttonHref}
            >
                {buttonText}
                <span aria-hidden="true" class="text-base font-bold">↗</span>
            </a>
        </div>
    </div>
</section>
