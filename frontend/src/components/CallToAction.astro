---
interface Props {
    eyebrow?: string;
    title: string;
    text: string;
}

const { eyebrow = 'IL PROSSIMO PASSO', title, text } = Astro.props;
---

<section class="cta-band my-12">
    <div class="wrap">
        <div class="cta-inner rounded-2xl border border-zinc-800 bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-950 p-8 shadow-2xl shadow-black/80 sm:p-12 transition-colors duration-300 hover:border-zinc-700 hover:from-zinc-900/90 hover:to-zinc-900">
            <div>
                <p class="eyebrow inline-block rounded-md border border-sky-500/25 bg-sky-500/10 px-3 py-1 text-xs font-extrabold tracking-wider text-sky-400 transition-colors duration-300 hover:border-sky-500/50">{eyebrow}</p>
                <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400 sm:text-base">{text}</p>
            </div>
            <a class="button button-light inline-flex items-center gap-2 rounded-lg bg-sky-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition-colors duration-300 hover:bg-sky-400 hover:shadow-sky-500/40 hover:-translate-y-0.5" href="/preventivo">Richiedi un sopralluogo <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>
