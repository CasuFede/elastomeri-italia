---
import type { LavoroMediaFoto } from '../data/lavori';

interface Props {
    id: string;
    prima: LavoroMediaFoto;
    dopo: LavoroMediaFoto;
    initialPercent?: number;
}

const { id, prima, dopo, initialPercent = 50 } = Astro.props;
const clampedInitial = Math.max(0, Math.min(100, initialPercent));
---

<div class="ba-wrapper">
    <div
        class="ba-slider"
        data-ba-slider
        data-ba-id={id}
        style={`--ba-pos: ${clampedInitial}%`}
    >
        <!-- Immagine DOPO (sfondo completo) -->
        <img
            src={dopo.src}
            alt={dopo.alt}
            class="ba-img ba-img-after"
            width="1280"
            height="720"
            loading="eager"
            decoding="async"
            draggable="false"
        />

        <!-- Immagine PRIMA (ritagliata con clip-path GPU-accelerated) -->
        <div class="ba-before-layer" aria-hidden="true">
            <img
                src={prima.src}
                alt={prima.alt}
                class="ba-img ba-img-before"
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                draggable="false"
            />
        </div>

        <!-- Etichette Prima / Dopo -->
        <span class="ba-pill ba-pill-before" data-ba-pill-before>PRIMA</span>
        <span class="ba-pill ba-pill-after" data-ba-pill-after>DOPO</span>

        <!-- Linea verticale e maniglia circolare trascinabile -->
        <div class="ba-divider" aria-hidden="true">
            <span class="ba-line"></span>
            <span class="ba-handle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18-6-6 6-6" />
                    <path d="m15 6 6 6-6 6" />
                </svg>
            </span>
        </div>

        <!-- Range nativo accessibile da tastiera (sincronizzato con drag pointer/touch) -->
        <input
            type="range"
            min="0"
            max="100"
            value={clampedInitial}
            step="1"
            class="ba-range"
            data-ba-range
            aria-label={`Confronto interattivo Prima e Dopo: ${dopo.alt}. Usa le frecce o trascina per confrontare.`}
        />
    </div>

    <!-- Barra controlli rapidi sotto lo slider -->
    <div class="ba-controls" role="group" aria-label="Controlli rapidi confronto Prima e Dopo">
        <span class="ba-hint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m8 9-3 3 3 3" />
                <path d="m16 9 3 3-3 3" />
            </svg>
            Trascina la maniglia per confrontare
        </span>
        <div class="ba-quick-btns">
            <button type="button" class="ba-quick-btn" data-ba-jump="100" data-ba-target={id}>Prima</button>
            <button type="button" class="ba-quick-btn is-active" data-ba-jump="50" data-ba-target={id}>50 / 50</button>
            <button type="button" class="ba-quick-btn" data-ba-jump="0" data-ba-target={id}>Dopo</button>
        </div>
    </div>
</div>
