---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';

interface BreadcrumbItem {
    name: string;
    path: string;
}

interface Props {
    title: string;
    description: string;
    activePath?: string;
    noindex?: boolean;
    ogImage?: string;
    breadcrumbs?: BreadcrumbItem[];
    extraStructuredData?: Record<string, unknown>[];
}

const {
    title,
    description,
    activePath = '',
    noindex = false,
    ogImage = '/images/hero-capannone-poliurea-bianca.jpg',
    breadcrumbs,
    extraStructuredData = [],
} = Astro.props;

const SITE_ORIGIN = 'https://poliureasystem.it';
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, '') : '/';
const canonicalUrl = `${SITE_ORIGIN}${normalizedPath === '/' ? '/' : normalizedPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_ORIGIN}${ogImage}`;

const links = [
    { href: '/fondazioni', label: 'Servizi' },
    { href: '/metodo', label: 'Metodo' },
    { href: '/lavori', label: 'Lavori' },
    { href: '/imprese', label: 'Chi siamo' },
    { href: '/contatti', label: 'Contatti' },
];

const graph: Record<string, unknown>[] = [
    {
        '@type': 'WebSite',
        '@id': `${SITE_ORIGIN}/#website`,
        name: 'Poliurea System',
        url: `${SITE_ORIGIN}/`,
        inLanguage: 'it-IT',
        publisher: {
            '@id': `${SITE_ORIGIN}/#business`,
        },
    },
    {
        '@type': ['HomeAndConstructionBusiness', 'Organization'],
        '@id': `${SITE_ORIGIN}/#business`,
        name: 'Poliurea System',
        url: `${SITE_ORIGIN}/`,
        logo: `${SITE_ORIGIN}/logo-poliurea-system.png`,
        image: `${SITE_ORIGIN}/images/hero-capannone-poliurea-bianca.jpg`,
        email: 'info@poliureasystem.it',
        telephone: '+393441366523',
        description:
            'Impermeabilizzazioni in poliurea pura a spruzzo senza demolizioni per terrazzi, tetti, coperture industriali, fondazioni e cantine a Genova e in Liguria.',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Genova',
            addressRegion: 'Liguria',
            addressCountry: 'IT',
        },
        areaServed: [
            { '@type': 'City', name: 'Genova' },
            { '@type': 'AdministrativeArea', name: 'Liguria' },
            { '@type': 'Place', name: 'Nord Italia' },
        ],
        contactPoint: [
            {
                '@type': 'ContactPoint',
                telephone: '+39-344-136-6523',
                contactType: 'customer service',
                name: 'Luigi',
                areaServed: 'IT',
                availableLanguage: 'Italian',
            },
            {
                '@type': 'ContactPoint',
                telephone: '+39-348-405-2908',
                contactType: 'customer service',
                name: 'Alessandro',
                areaServed: 'IT',
                availableLanguage: 'Italian',
            },
        ],
        serviceType: [
            'Impermeabilizzazione in poliurea pura a spruzzo',
            'Impermeabilizzazione terrazzi e balconi senza demolizione',
            'Impermeabilizzazione tetti e coperture industriali',
            'Impermeabilizzazione fondazioni, platee e cantine',
        ],
    },
];

if (breadcrumbs && breadcrumbs.length > 0) {
    graph.push({
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            name: item.name,
            item: `${SITE_ORIGIN}${item.path === '/' ? '/' : item.path}`,
        })),
    });
}

for (const extra of extraStructuredData) {
    graph.push(extra);
}

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': graph,
};
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#161D2E" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta name="description" content={description} />
        {!noindex && <link rel="canonical" href={canonicalUrl} />}
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="it_IT" />
        <meta property="og:site_name" content="Poliurea System" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1376" />
        <meta property="og:image:height" content="768" />
        <meta property="og:image:alt" content="Poliurea System — Impermeabilizzazioni in poliurea pura a Genova e Liguria" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=4" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=4" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=4" />
        <link rel="shortcut icon" href="/favicon.ico?v=4" />
        <link rel="apple-touch-icon" href="/favicon-192x192.png?v=4" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    </head>
    <body class="site-body bg-white text-[#1D1D1F] antialiased selection:bg-[#0071E3] selection:text-white">
        <header class="site-header sticky top-0 z-40 border-b border-[#2A344B] bg-[#161D2E]">
            <div class="header-inner">
                <a class="brand" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                    </picture>
                </a>
                <nav class="main-nav" aria-label="Navigazione principale">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                </nav>
                <div class="mobile-header-right">
                    <a class="mobile-header-cta" href="/preventivo">Preventivo <span aria-hidden="true">↗</span></a>
                    <button class="mobile-menu-toggle border border-white/35 bg-[#1F2940] transition-colors duration-200 hover:border-white hover:bg-[#2A344B]" id="mobile-menu-toggle" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="mobile-menu">
                        <span></span><span></span>
                    </button>
                </div>
                <div class="header-actions">
                    <a class="header-login inline-flex items-center gap-2 rounded-full border border-white/45 bg-transparent px-4 py-2 text-xs font-semibold text-white transition-colors duration-200 hover:border-white hover:bg-white/10" href="/area-clienti" aria-label="Accedi all’area clienti">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /></svg>
                        <span>Area clienti</span>
                    </a>
                    <a class="header-cta inline-flex items-center gap-2 rounded-full bg-[#0071E3] px-4 py-2 text-xs font-semibold text-white transition-colors duration-200 hover:bg-[#0064CC]" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <nav class="mobile-menu" id="mobile-menu" aria-label="Navigazione principale" aria-hidden="true" inert>
                <div class="mobile-menu-links">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                    <a class="mobile-customer-login" href="/area-clienti">Accedi all’area clienti <span aria-hidden="true">↗</span></a>
                </div>
                <a class="mobile-menu-cta" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <div id="schema-lightbox" class="schema-lightbox" role="dialog" aria-modal="true" aria-labelledby="schema-lightbox-title" hidden>
            <div class="schema-lightbox-dialog">
                <div class="schema-lightbox-header">
                    <h3 id="schema-lightbox-title" class="schema-lightbox-title">Schema tecnico</h3>
                    <button id="schema-lightbox-close" type="button" class="schema-lightbox-close" aria-label="Chiudi ingrandimento">Chiudi ✕</button>
                </div>
                <img id="schema-lightbox-img" alt="Schema tecnico ingrandito" class="schema-lightbox-img" />
            </div>
        </div>
        <ChatWidget />
        <footer class="site-footer bg-[#161D2E] border-t border-[#2A344B]">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="brand footer-logo" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                        <picture>
                            <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                            <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                        </picture>
                    </a>
                    <p>Impermeabilizzazioni continue per terrazzi, tetti, coperture industriali e fondazioni.</p>
                    <p class="footer-location">Genova · Liguria e regioni limitrofe</p>
                </div>
                <div class="footer-column">
                    <h2>Esplora</h2>
                    <a href="/fondazioni">Servizi</a>
                    <a href="/metodo">Il metodo</a>
                    <a href="/lavori">Lavori</a>
                    <a href="/imprese">Chi siamo &amp; Condomìni</a>
                </div>
                <div class="footer-column">
                    <h2>Contatti diretti</h2>
                    <a href="tel:+393441366523">Luigi · +39 344 136 6523</a>
                    <a href="tel:+393484052908">Alessandro · +39 348 405 2908</a>
                    <a href="mailto:info@poliureasystem.it">info@poliureasystem.it</a>
                    <a href="/area-clienti">Area clienti</a>
                    <a href="/privacy">Informativa privacy</a>
                </div>
                <div class="footer-contact">
                    <span class="footer-caption">HAI UN PROBLEMA DI INFILTRAZIONI?</span>
                    <p>Raccontaci il tuo immobile: sopralluogo diagnostico gratuito e risposta entro 24 ore.</p>
                    <a class="text-link" href="/preventivo">Richiedi sopralluogo gratuito <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="footer-bottom border-t border-[#2A344B]">
                <div class="footer-bottom-inner">
                    <span>© {new Date().getFullYear()} Poliurea System · Genova e Liguria</span>
                    <span class="footer-bottom-sep" aria-hidden="true">·</span>
                    <span>Protezione progettata intorno al tuo edificio.</span>
                </div>
            </div>
        </footer>
        <script is:inline>
            const menuToggle = document.getElementById('mobile-menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');
            const chiudiMenu = () => {
                mobileMenu.inert = true;
                mobileMenu.setAttribute('aria-hidden', 'true');
                menuToggle.setAttribute('aria-expanded', 'false');
                menuToggle.setAttribute('aria-label', 'Apri il menu');
                document.body.classList.remove('menu-open');
            };

            menuToggle.addEventListener('click', () => {
                const aperto = menuToggle.getAttribute('aria-expanded') !== 'true';
                mobileMenu.inert = !aperto;
                mobileMenu.setAttribute('aria-hidden', String(!aperto));
                menuToggle.setAttribute('aria-expanded', String(aperto));
                menuToggle.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
                document.body.classList.toggle('menu-open', aperto);
            });
            mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', chiudiMenu));
            document.addEventListener('keydown', (evento) => {
                if (evento.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') chiudiMenu();
            });

            // Lightbox globale per ingrandire gli schemi tecnici al clic
            const schemaLightbox = document.getElementById('schema-lightbox');
            const schemaLightboxImg = document.getElementById('schema-lightbox-img');
            const schemaLightboxTitle = document.getElementById('schema-lightbox-title');
            const schemaLightboxClose = document.getElementById('schema-lightbox-close');
            if (schemaLightbox && schemaLightboxImg && schemaLightboxTitle && schemaLightboxClose) {
                const closeLightbox = () => {
                    schemaLightbox.hidden = true;
                    schemaLightboxImg.removeAttribute('src');
                    document.body.style.overflow = '';
                };
                document.addEventListener('click', (ev) => {
                    const trigger = ev.target && ev.target.closest ? ev.target.closest('[data-schema-zoom]') : null;
                    if (!trigger) return;
                    ev.preventDefault();
                    const src = trigger.getAttribute('data-schema-src') || '';
                    const title = trigger.getAttribute('data-schema-title') || 'Schema tecnico';
                    const alt = trigger.getAttribute('data-schema-alt') || title;
                    if (!src) return;
                    schemaLightboxImg.setAttribute('src', src);
                    schemaLightboxImg.setAttribute('alt', alt);
                    schemaLightboxTitle.textContent = title;
                    schemaLightbox.hidden = false;
                    document.body.style.overflow = 'hidden';
                    schemaLightboxClose.focus();
                });
                schemaLightboxClose.addEventListener('click', closeLightbox);
                schemaLightbox.addEventListener('click', (ev) => {
                    if (ev.target === schemaLightbox) closeLightbox();
                });
                document.addEventListener('keydown', (ev) => {
                    if (ev.key === 'Escape' && !schemaLightbox.hidden) closeLightbox();
                });
            }
        </script>
    </body>
</html>
