---
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    activePath?: string;
}

const { title, description, activePath = '' } = Astro.props;
const links = [
    { href: '/fondazioni', label: 'Fondazioni' },
    { href: '/metodo', label: 'Metodo' },
    { href: '/lavori', label: 'Lavori' },
    { href: '/imprese', label: 'Per imprese' },
    { href: '/contatti', label: 'Contatti' },
];
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#000000" />
        <meta name="description" content={description} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <title>{title}</title>
    </head>
    <body class="site-body bg-black text-zinc-200 antialiased selection:bg-sky-500 selection:text-white">
        <header class="site-header sticky top-0 z-40 border-b border-zinc-800 bg-black/85 backdrop-blur-xl">
            <div class="header-inner">
                <a class="brand" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                    </picture>
                </a>
                <nav class="main-nav" aria-label="Navigazione principale">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                </nav>
                <button class="mobile-menu-toggle border border-zinc-800 bg-zinc-900 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800" id="mobile-menu-toggle" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="mobile-menu">
                    <span></span><span></span>
                </button>
                <div class="header-actions">
                    <a class="header-login inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs font-bold text-zinc-200 shadow-sm transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800 hover:text-sky-400 hover:-translate-y-0.5" href="/area-clienti" aria-label="Accedi all’area clienti">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /></svg>
                        <span>Area clienti</span>
                    </a>
                    <a class="header-cta inline-flex items-center gap-2.5 rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition-colors duration-300 hover:bg-sky-400 hover:shadow-sky-500/40 hover:-translate-y-0.5" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <nav class="mobile-menu" id="mobile-menu" aria-label="Navigazione principale" aria-hidden="true" inert>
                <div class="mobile-menu-links">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                    <a class="mobile-customer-login" href="/area-clienti">Accedi all’area clienti <span aria-hidden="true">↗</span></a>
                </div>
                <a class="mobile-menu-cta" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <aside class="chat-widget fixed z-50 right-4 md:right-6 bottom-4 md:bottom-6 max-w-[calc(100vw-2rem)]" id="chat-widget">
            <section class="chat-panel w-[calc(100vw-2rem)] right-4 max-w-[420px] max-h-[calc(100dvh-5rem)] overflow-hidden flex flex-col rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl" id="chat-panel" aria-label="Chat con il Castoro" aria-hidden="true" inert hidden>
                <header class="chat-header">
                    <div class="chat-avatar">
                        <img class="chat-header-mascot" src="/mascotte-castoro.webp" alt="" width="52" height="52" />
                        <span class="chat-online-dot" aria-hidden="true"></span>
                    </div>
                    <div class="chat-header-copy">
                        <span class="chat-header-kicker">ASSISTENTE</span>
                        <strong>Il Castoro</strong>
                        <span><i aria-hidden="true"></i> Pronto ad aiutarti</span>
                    </div>
                    <button class="chat-new" id="chat-new" type="button" aria-label="Inizia una nuova conversazione" title="Nuova conversazione">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    </button>
                    <button class="chat-close" id="chat-close" type="button" aria-label="Chiudi la chat">×</button>
                </header>
                <div class="chat-messages" id="chat-messages" aria-live="polite" aria-relevant="additions text">
                    <div class="chat-message chat-message-assistant chat-welcome text-white font-medium" id="chat-welcome">
                        <span class="chat-welcome-icon" aria-hidden="true">✦</span>
                        <span class="chat-message-author">Il Castoro</span>
                        Ciao! Sono qui per aiutarti con la poliurea e le impermeabilizzazioni. Scegli un argomento per iniziare.
                    </div>
                </div>
                <div class="chat-choice-footer">
                    <p class="chat-choice-prompt" id="chat-choice-prompt">
                        <span>Scegli un argomento</span>
                        <span class="chat-choice-hint" aria-hidden="true">GUIDATA</span>
                    </p>
                    <div class="chat-suggestions" id="chat-suggestions"></div>
                </div>
                <p class="chat-disclaimer">Informazioni tratte dal manuale tecnico · <a href="/preventivo">Richiedi un sopralluogo</a></p>
            </section>
            <button
                class="chat-launcher group flex items-center gap-2.5 md:gap-3 p-1.5 md:px-4 md:py-2.5 rounded-full bg-zinc-900/80 hover:bg-zinc-800/90 backdrop-blur-md border border-zinc-700/50 hover:border-zinc-500 shadow-2xl shadow-black/80 hover:shadow-sky-500/10 transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer pointer-events-auto"
                id="chat-launcher"
                type="button"
                aria-label="Apri la chat con il Castoro"
                aria-expanded="false"
                aria-controls="chat-panel"
            >
                <div class="relative shrink-0 flex items-center justify-center">
                    <img
                        src="/mascotte-castoro.webp"
                        alt=""
                        class="w-10 h-10 md:w-8 md:h-8 rounded-full object-cover ring-2 ring-zinc-700/60 group-hover:ring-sky-500/50 transition-colors"
                        width="40"
                        height="40"
                    />
                    <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-zinc-900" aria-hidden="true"></span>
                </div>
                <span class="chat-launcher-label hidden md:block text-sm font-medium text-white whitespace-nowrap">Chiedi al Castoro</span>
                <span class="hidden md:flex items-center justify-center w-6 h-6 rounded-full bg-sky-500/10 border border-sky-500/25 text-sky-400 shrink-0 group-hover:bg-sky-500/20 group-hover:border-sky-500/40 transition-colors" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                </span>
            </button>
        </aside>
        <footer class="site-footer bg-zinc-950 border-t border-zinc-800">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="brand footer-logo" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                        <picture>
                            <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                            <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                        </picture>
                    </a>
                    <p>Soluzioni per proteggere gli edifici dall’acqua e dall’umidità.</p>
                </div>
                <div class="footer-column">
                    <h2>Esplora</h2>
                    <a href="/fondazioni">Fondazioni</a>
                    <a href="/metodo">Il metodo</a>
                    <a href="/lavori">Lavori</a>
                </div>
                <div class="footer-column">
                    <h2>Parliamone</h2>
                    <a href="/imprese">Per imprese</a>
                    <a href="/contatti">Contatti</a>
                    <a href="/preventivo">Richiedi un preventivo</a>
                    <a href="/area-clienti">Area clienti</a>
                    <a href="/privacy">Informativa privacy</a>
                    <a href="/accesso-preventivi">Accesso preventivi</a>
                </div>
                <div class="footer-contact">
                    <span class="footer-caption">HAI UN PROBLEMA DI INFILTRAZIONI?</span>
                    <p>Raccontaci il tuo progetto: il primo passo è un confronto.</p>
                    <a class="text-link" href="/preventivo">Richiedi un sopralluogo <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="footer-bottom border-t border-zinc-800/80 text-zinc-500 text-xs">
                <span>© {new Date().getFullYear()} Poliurea System</span>
                <span>Protezione, progettata intorno al tuo edificio.</span>
            </div>
        </footer>
        <script is:inline>
            const menuToggle = document.getElementById('mobile-menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');
            const chiudiMenu = () => {
                mobileMenu.inert = true;
                mobileMenu.setAttribute('aria-hidden', 'true');
                menuToggle.setAttribute('aria-expanded', 'false');
                menuToggle.setAttribute('aria-label', 'Apri il menu');
                document.body.classList.remove('menu-open');
            };

            menuToggle.addEventListener('click', () => {
                const aperto = menuToggle.getAttribute('aria-expanded') !== 'true';
                mobileMenu.inert = !aperto;
                mobileMenu.setAttribute('aria-hidden', String(!aperto));
                menuToggle.setAttribute('aria-expanded', String(aperto));
                menuToggle.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
                document.body.classList.toggle('menu-open', aperto);
            });
            mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', chiudiMenu));
            document.addEventListener('keydown', (evento) => {
                if (evento.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') chiudiMenu();
            });

            const chatPanel = document.getElementById('chat-panel');
            const chatLauncher = document.getElementById('chat-launcher');
            const chatClose = document.getElementById('chat-close');
            const chatMessages = document.getElementById('chat-messages');
            const chatSuggestions = document.getElementById('chat-suggestions');
            const chatChoicePrompt = document.getElementById('chat-choice-prompt');
            const chatNew = document.getElementById('chat-new');
            const cronologiaChat = [];
            let richiestaInCorso = false;
            const argomentiChat = [
                {
                    label: 'Cos’è la poliurea?',
                    question: 'Cos’è la poliurea e da quali componenti è composta?',
                    followups: [
                        { label: 'Poliurea pura o ibrida?', question: 'Qual è la differenza tra poliurea pura e ibrida?' },
                        { label: 'Aromatica o alifatica?', question: 'Qual è la differenza tra poliurea aromatica e alifatica?' },
                    ],
                },
                {
                    label: 'Tipi di poliurea',
                    question: 'Quali sono le differenze tra poliurea pura, ibrida, aromatica e alifatica?',
                    followups: [
                        { label: 'Poliurea pura e ibrida', question: 'Qual è la differenza tra poliurea pura e ibrida?' },
                        { label: 'Aromatica e alifatica', question: 'Qual è la differenza tra poliurea aromatica e alifatica?' },
                    ],
                },
                {
                    label: 'Prestazioni e resistenza',
                    question: 'Quali sono le prestazioni meccaniche e la resistenza della poliurea?',
                    followups: [
                        { label: 'Resistenza ai raggi UV', question: 'Come si comporta la poliurea aromatica ai raggi UV?' },
                        { label: 'Resistenza chimica', question: 'Qual è la resistenza chimica della poliurea?' },
                    ],
                },
                {
                    label: 'Applicazione e posa',
                    question: 'Come si applica la poliurea e quanto tempo richiede la posa?',
                    followups: [
                        { label: 'Preparazione del supporto', question: 'Come si prepara il calcestruzzo prima dell’applicazione della poliurea?' },
                        { label: 'Primer e umidità', question: 'Quali sono le indicazioni su primer e umidità del supporto?' },
                    ],
                },
                {
                    label: 'Superfici e preparazione',
                    question: 'Su quali superfici si può applicare la poliurea e come si prepara il supporto?',
                    followups: [
                        { label: 'Calcestruzzo', question: 'Come si prepara il calcestruzzo prima dell’applicazione della poliurea?' },
                        { label: 'Metallo', question: 'Come si prepara il metallo prima dell’applicazione della poliurea?' },
                    ],
                },
                {
                    label: 'Dove si può usare',
                    question: 'Dove si può applicare la poliurea? Quali sono i principali impieghi?',
                    followups: [
                        { label: 'Terrazze e coperture', question: 'Si può applicare la poliurea su terrazze e coperture?' },
                        { label: 'Piscine e serbatoi', question: 'Si può usare la poliurea per piscine e serbatoi?' },
                    ],
                },
                {
                    label: 'Vantaggi e limiti',
                    question: 'Quali sono i vantaggi e i limiti della poliurea rispetto alla guaina bituminosa?',
                    followups: [
                        { label: 'Poliurea o guaina?', question: 'La poliurea è sempre meglio della guaina bituminosa?' },
                        { label: 'Esposizione al sole', question: 'La poliurea resiste ai raggi UV e al sole?' },
                    ],
                },
                {
                    label: 'Sicurezza e protezioni',
                    question: 'Quali precauzioni e dispositivi di protezione servono durante l’applicazione della poliurea?',
                    followups: [
                        { label: 'Protezione dagli isocianati', question: 'Quali protezioni servono contro l’overspray di isocianati?' },
                        { label: 'Applicazione professionale', question: 'La poliurea si può applicare con il fai-da-te?' },
                    ],
                },
                {
                    label: 'Costi e preventivo',
                    question: 'Quanto costa un intervento in poliurea e da cosa dipende il preventivo?',
                    followups: [
                        { label: 'Richiedi un sopralluogo', href: '/preventivo' },
                    ],
                },
            ];

            const mostraChat = (aperta) => {
                const focusDentroChat = chatPanel.contains(document.activeElement);
                chatPanel.inert = !aperta;
                chatPanel.setAttribute('aria-hidden', String(!aperta));
                chatPanel.hidden = !aperta;
                chatLauncher.setAttribute('aria-expanded', String(aperta));
                chatLauncher.setAttribute('aria-label', aperta ? 'Chiudi la chat con il Castoro' : 'Apri la chat con il Castoro');
                chatLauncher.classList.toggle('is-open', aperta);
                chatWidget.classList.toggle('is-open', aperta);
                const label = chatLauncher.querySelector('.chat-launcher-label');
                if (label) label.textContent = aperta ? 'Chiudi la chat' : 'Chiedi al Castoro';
                if (aperta) chatSuggestions.querySelector('button')?.focus();
                else if (focusDentroChat) chatLauncher.focus();
            };

            const aggiungiMessaggio = (testo, ruolo, classe = '') => {
                const messaggio = document.createElement('div');
                messaggio.className = `chat-message chat-message-${ruolo} text-white font-medium${classe ? ` ${classe}` : ''}`;
                if (ruolo.includes('assistant')) {
                    const autore = document.createElement('span');
                    autore.className = 'chat-message-author text-sky-400 font-bold';
                    autore.textContent = 'Il Castoro';
                    messaggio.append(autore);
                }
                const corpoTesto = document.createElement('span');
                corpoTesto.className = 'chat-message-text';
                corpoTesto.textContent = testo;
                messaggio.append(corpoTesto);
                chatMessages.append(messaggio);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                return messaggio;
            };

            const mostraOpzioni = (opzioni = argomentiChat, titolo = 'Scegli un argomento') => {
                chatChoicePrompt.textContent = titolo;
                chatSuggestions.replaceChildren();
                for (const opzione of opzioni) {
                    const pulsante = document.createElement('button');
                    pulsante.type = 'button';
                    pulsante.className = 'chat-option';
                    pulsante.textContent = opzione.label;
                    if (opzione.href) {
                        pulsante.dataset.chatHref = opzione.href;
                    } else {
                        pulsante.dataset.chatQuestion = opzione.question;
                    }
                    chatSuggestions.append(pulsante);
                }
                if (opzioni !== argomentiChat) {
                    const altro = document.createElement('button');
                    altro.type = 'button';
                    altro.className = 'chat-option chat-option-secondary';
                    altro.dataset.chatAction = 'topics';
                    altro.textContent = '← Altri argomenti';
                    chatSuggestions.append(altro);
                }
            };

            const inviaMessaggio = async (domanda, etichetta, argomento) => {
                if (!domanda || richiestaInCorso) return;

                const opzioni = argomento?.followups || [];
                mostraOpzioni([], 'Sto preparando la risposta…');
                chatSuggestions.querySelectorAll('button').forEach((pulsante) => { pulsante.disabled = true; });
                aggiungiMessaggio(etichetta, 'user');
                const messaggioAttesa = aggiungiMessaggio('Sto preparando una risposta…', 'assistant chat-message-pending');
                richiestaInCorso = true;
                chatNew.disabled = true;

                const messaggi = [...cronologiaChat, { role: 'user', content: domanda }].slice(-12);
                try {
                    const risposta = await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ messages: messaggi }),
                    });
                    const risultato = await risposta.json().catch(() => ({}));
                    if (!risposta.ok) {
                        throw new Error(risultato.detail || 'Non riesco a rispondere in questo momento. Riprova tra poco.');
                    }
                    if (typeof risultato.answer !== 'string' || !risultato.answer.trim()) {
                        throw new Error('Ho ricevuto una risposta non valida. Riprova tra poco.');
                    }
                    const corpo = messaggioAttesa.querySelector('.chat-message-text');
                    if (corpo) corpo.textContent = risultato.answer;
                    else messaggioAttesa.textContent = risultato.answer;
                    messaggioAttesa.classList.remove('chat-message-pending');

                    cronologiaChat.push({ role: 'user', content: domanda }, { role: 'model', content: risultato.answer });
                    if (cronologiaChat.length > 10) cronologiaChat.splice(0, cronologiaChat.length - 10);
                    mostraOpzioni(opzioni, opzioni.length ? 'Puoi approfondire' : 'Vuoi chiedere altro?');
                } catch (errore) {
                    const corpo = messaggioAttesa.querySelector('.chat-message-text');
                    const errTxt = errore instanceof Error ? errore.message : 'Si è verificato un errore. Riprova tra poco.';
                    if (corpo) corpo.textContent = errTxt;
                    else messaggioAttesa.textContent = errTxt;
                    messaggioAttesa.classList.remove('chat-message-pending');
                    messaggioAttesa.classList.add('chat-message-error');
                    mostraOpzioni(
                        [{ label: 'Riprova', question: domanda }, ...argomentiChat],
                        'Scegli un’opzione per continuare',
                    );
                } finally {
                    richiestaInCorso = false;
                    chatNew.disabled = false;
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            };

            chatNew.addEventListener('click', () => {
                if (richiestaInCorso) return;
                cronologiaChat.length = 0;
                chatMessages.querySelectorAll('.chat-message:not(#chat-welcome)').forEach((messaggio) => messaggio.remove());
                mostraOpzioni();
                chatMessages.scrollTop = 0;
                chatSuggestions.querySelector('button')?.focus();
            });
            chatLauncher.addEventListener('click', () => {
                const aperta = chatLauncher.getAttribute('aria-expanded') !== 'true';
                mostraChat(aperta);
            });
            chatClose.addEventListener('click', () => mostraChat(false));
            chatSuggestions.addEventListener('click', (evento) => {
                const pulsante = evento.target.closest('button');
                if (!(pulsante instanceof HTMLButtonElement) || pulsante.disabled || richiestaInCorso) return;

                // Bottoni monouso: disabilita subito il set di suggerimenti per impedire click multipli
                pulsante.disabled = true;
                pulsante.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                chatSuggestions.querySelectorAll('button').forEach((b) => {
                    b.disabled = true;
                    b.style.pointerEvents = 'none';
                    b.style.opacity = '0.4';
                });

                if (pulsante.dataset.chatHref) {
                    window.location.href = pulsante.dataset.chatHref;
                    return;
                }
                if (pulsante.dataset.chatAction === 'topics') {
                    mostraOpzioni();
                    chatSuggestions.querySelector('button')?.focus();
                    return;
                }
                const domanda = pulsante.dataset.chatQuestion;
                if (!domanda) return;
                const argomento = argomentiChat.find((voce) => voce.question === domanda)
                    || argomentiChat.find((voce) => voce.followups.some((approfondimento) => approfondimento.question === domanda));
                inviaMessaggio(domanda, pulsante.textContent || domanda, argomento);
            });
            mostraOpzioni();
            document.addEventListener('keydown', (evento) => {
                if (evento.key === 'Escape' && chatLauncher.getAttribute('aria-expanded') === 'true') mostraChat(false);
            });

            // Micro-interazione: Fade-in morbido allo scroll con Intersection Observer
            if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                document.documentElement.classList.add('js-reveal-ready');
                const observerOpzioni = {
                    root: null,
                    rootMargin: '0px 0px -40px 0px',
                    threshold: 0.08,
                };
                const revealObserver = new IntersectionObserver((entries, obs) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-revealed');
                            obs.unobserve(entry.target);
                        }
                    });
                }, observerOpzioni);

                const setupScrollReveal = () => {
                    const selettori = [
                        '.scroll-reveal',
                        '.service-card',
                        '.bento-grid > article',
                        '.audience-list > div',
                        '.method-steps > div',
                        '.home-checklist li',
                        '.faq-list > details',
                        '.cta-inner',
                        '.service-detail',
                        '.roadmap-step',
                        '.audience-cards > article',
                        '.gallery-guidelines-inner > div',
                        '.contact-panel',
                        '.contact-details',
                        '.page-intro',
                        '.method-illustration',
                        '.business-statement',
                        '.business-checklist',
                        '.gallery-empty'
                    ].join(', ');

                    document.querySelectorAll(selettori).forEach((elemento) => {
                        elemento.classList.add('scroll-reveal');
                        revealObserver.observe(elemento);
                    });
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', setupScrollReveal);
                } else {
                    setupScrollReveal();
                }
            }
        </script>
    </body>
</html>
