---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
    title: string;
    description: string;
    activePath?: string;
}

const { title, description, activePath = '' } = Astro.props;
const links = [
    { href: '/fondazioni', label: 'Fondazioni' },
    { href: '/metodo', label: 'Metodo' },
    { href: '/lavori', label: 'Lavori' },
    { href: '/imprese', label: 'Per imprese' },
    { href: '/contatti', label: 'Contatti' },
];
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            '@id': 'https://poliureasystem.it/#website',
            name: 'Poliurea System',
            url: 'https://poliureasystem.it/',
            inLanguage: 'it-IT',
            publisher: {
                '@id': 'https://poliureasystem.it/#organization',
            },
        },
        {
            '@type': 'Organization',
            '@id': 'https://poliureasystem.it/#organization',
            name: 'Poliurea System',
            url: 'https://poliureasystem.it/',
            logo: 'https://poliureasystem.it/logo-poliurea-system.png',
        },
    ],
};
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#000000" />
        <meta name="description" content={description} />
        <meta property="og:site_name" content="Poliurea System" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
        <link rel="apple-touch-icon" href="/favicon-192x192.png" />
        <title>{title}</title>
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    </head>
    <body class="site-body bg-black text-zinc-200 antialiased selection:bg-sky-500 selection:text-white">
        <header class="site-header sticky top-0 z-40 border-b border-zinc-800 bg-black/85 backdrop-blur-xl">
            <div class="header-inner">
                <a class="brand" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                    <picture>
                        <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                        <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                    </picture>
                </a>
                <nav class="main-nav" aria-label="Navigazione principale">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                </nav>
                <button class="mobile-menu-toggle border border-zinc-800 bg-zinc-900 transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800" id="mobile-menu-toggle" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="mobile-menu">
                    <span></span><span></span>
                </button>
                <div class="header-actions">
                    <a class="header-login inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs font-bold text-zinc-200 shadow-sm transition-colors duration-300 hover:border-zinc-700 hover:bg-zinc-800 hover:text-sky-400 hover:-translate-y-0.5" href="/area-clienti" aria-label="Accedi all’area clienti">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /></svg>
                        <span>Area clienti</span>
                    </a>
                    <a class="header-cta inline-flex items-center gap-2.5 rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/25 transition-colors duration-300 hover:bg-sky-400 hover:shadow-sky-500/40 hover:-translate-y-0.5" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <nav class="mobile-menu" id="mobile-menu" aria-label="Navigazione principale" aria-hidden="true" inert>
                <div class="mobile-menu-links">
                    {links.map(({ href, label }) => (
                        <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>
                    ))}
                    <a class="mobile-customer-login" href="/area-clienti">Accedi all’area clienti <span aria-hidden="true">↗</span></a>
                </div>
                <a class="mobile-menu-cta" href="/preventivo">Preventivo gratuito <span aria-hidden="true">↗</span></a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <ChatWidget />
        <footer class="site-footer bg-zinc-950 border-t border-zinc-800">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="brand footer-logo" href="/" aria-label="Poliurea System Impermeabilizzazioni, home">
                        <picture>
                            <source srcset="/logo-poliurea-system.webp" type="image/webp" />
                            <img src="/logo-poliurea-system.png" alt="Poliurea System - Impermeabilizzazioni" width="200" height="38" />
                        </picture>
                    </a>
                    <p>Soluzioni per proteggere gli edifici dall’acqua e dall’umidità.</p>
                </div>
                <div class="footer-column">
                    <h2>Esplora</h2>
                    <a href="/fondazioni">Fondazioni</a>
                    <a href="/metodo">Il metodo</a>
                    <a href="/lavori">Lavori</a>
                </div>
                <div class="footer-column">
                    <h2>Parliamone</h2>
                    <a href="/imprese">Per imprese</a>
                    <a href="/contatti">Contatti</a>
                    <a href="/preventivo">Richiedi un preventivo</a>
                    <a href="/area-clienti">Area clienti</a>
                    <a href="/privacy">Informativa privacy</a>
                </div>
                <div class="footer-contact">
                    <span class="footer-caption">HAI UN PROBLEMA DI INFILTRAZIONI?</span>
                    <p>Raccontaci il tuo progetto: il primo passo è un confronto.</p>
                    <a class="text-link" href="/preventivo">Richiedi un sopralluogo <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="footer-bottom border-t border-zinc-800/80 text-zinc-500 text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pr-20 md:pr-48">
                <span>© {new Date().getFullYear()} Poliurea System</span>
                <span>Protezione, progettata intorno al tuo edificio.</span>
            </div>
        </footer>
        <script is:inline>
            const menuToggle = document.getElementById('mobile-menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');
            const chiudiMenu = () => {
                mobileMenu.inert = true;
                mobileMenu.setAttribute('aria-hidden', 'true');
                menuToggle.setAttribute('aria-expanded', 'false');
                menuToggle.setAttribute('aria-label', 'Apri il menu');
                document.body.classList.remove('menu-open');
            };

            menuToggle.addEventListener('click', () => {
                const aperto = menuToggle.getAttribute('aria-expanded') !== 'true';
                mobileMenu.inert = !aperto;
                mobileMenu.setAttribute('aria-hidden', String(!aperto));
                menuToggle.setAttribute('aria-expanded', String(aperto));
                menuToggle.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
                document.body.classList.toggle('menu-open', aperto);
            });
            mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', chiudiMenu));
            document.addEventListener('keydown', (evento) => {
                if (evento.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') chiudiMenu();
            });

            // Micro-interazione: Fade-in morbido allo scroll con Intersection Observer
            if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                document.documentElement.classList.add('js-reveal-ready');
                const observerOpzioni = {
                    root: null,
                    rootMargin: '50px 0px 50px 0px',
                    threshold: 0.01,
                };
                const revealObserver = new IntersectionObserver((entries, obs) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-revealed');
                            obs.unobserve(entry.target);
                        }
                    });
                }, observerOpzioni);

                const setupScrollReveal = () => {
                    const selettori = [
                        '.scroll-reveal',
                        '.service-card',
                        '.polyurea-section article',
                        '.bento-grid > article',
                        '.audience-list > div',
                        '.audience-list > a',
                        '.method-steps > div',
                        '.home-checklist li',
                        '.faq-list > details',
                        '.cta-inner',
                        '.service-detail',
                        '.roadmap-step',
                        '.audience-cards > article',
                        '.gallery-guidelines-inner > div',
                        '.contact-panel',
                        '.contact-details',
                        '.page-intro',
                        '.method-illustration',
                        '.business-statement',
                        '.business-checklist',
                        '.gallery-empty'
                    ].join(', ');

                    document.querySelectorAll(selettori).forEach((elemento) => {
                        elemento.classList.add('scroll-reveal');
                        revealObserver.observe(elemento);
                    });
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', setupScrollReveal);
                } else {
                    setupScrollReveal();
                }
            }
        </script>
    </body>
</html>
